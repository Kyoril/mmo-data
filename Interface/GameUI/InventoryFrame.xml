<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="InventoryFrame.lua" />
	<Font name="InventoryTitleFont" file="Fonts/FRIZQT__.TTF" size="25.6" outline="0" shadowX="0.8" shadowY="0.8" />
	<Font name="InventoryCountFont" file="Fonts/FRIZQT__.TTF" size="20.8" outline="0" shadowX="0.8" shadowY="0.8" />

    <Frame name="InventoryFrame" renderer="DefaultRenderer" parent="GameParent">
		<Property name="Visible" value="False" />
		
		<Visual>
			<ImagerySection name="Background">
				<BorderComponent texture="Interface/GameUI/Alestia/WindowPanel.htex" borderSize="25.6" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Size><AbsDimension x="768" y="1024" /></Size>
			<Anchor point="BOTTOM" offset="-128" />
			<Anchor point="RIGHT" offset="0" />
		</Area>

		<Frame name="InventoryTitleBar" inherits="TitleBar">
			<Property name="Text" value="INVENTORY" />
			<Property name="Font" value="InventoryTitleFont" />
			<Property name="Clickable" value="true" />

			<Area>
				<Size><AbsDimension y="72" /></Size>
				<Anchor point="TOP" offset="19.2" />
				<Anchor point="LEFT" offset="19.2" />
				<Anchor point="RIGHT" offset="-19.2" />
			</Area>

			<Frame name="InventoryCloseButton" type="Button" renderer="ButtonRenderer">
				<Visual>
					<ImagerySection name="NormalFrame">
						<ImageComponent texture="Interface/GameUI/fg4_buttonSmall1_Up_result.htex" />
					</ImagerySection>
					<ImagerySection name="HoveredFrame">
						<ImageComponent texture="Interface/GameUI/fg4_buttonSmall1_Over_result.htex" />
					</ImagerySection>
					<ImagerySection name="PushedFrame">
						<ImageComponent texture="Interface/GameUI/fg4_buttonSmall1_Down_result.htex" />
					</ImagerySection>
					<ImagerySection name="DisabledFrame">
						<ImageComponent texture="Interface/GameUI/fg4_buttonSmall2_Disabled_result.htex" />
					</ImagerySection>
					<ImagerySection name="Caption">
						<ImageComponent texture="Interface/Icons/fg4_iconsGold_close_result.htex" relativeInset="0.25" />
					</ImagerySection>
					<StateImagery name="Normal">
						<Layer><Section section="NormalFrame" /><Section section="Caption" /></Layer>
					</StateImagery>
					<StateImagery name="Hovered">
						<Layer><Section section="HoveredFrame" /><Section section="Caption" /></Layer>
					</StateImagery>
					<StateImagery name="Pushed">
						<Layer><Section section="PushedFrame" /><Section section="Caption" color="FFAAAAAA" /></Layer>
					</StateImagery>
					<StateImagery name="Disabled">
						<Layer><Section section="DisabledFrame" /><Section section="Caption" color="AE888888" /></Layer>
					</StateImagery>
				</Visual>
				<Area>
					<Size><AbsDimension x="51.2" y="51.2" /></Size>
					<Anchor point="RIGHT" offset="-8" />
					<Anchor point="V_CENTER" offset="-3.2" />
				</Area>
				<Scripts>
					<OnUpdate>
						return function(this, elapsed)
							InventoryCloseButton_Update(this);
						end
					</OnUpdate>
				</Scripts>
			</Frame>
		</Frame>

		<Frame name="PlayerMoney" renderer="DefaultRenderer">
			<Property name="Font" value="InventoryCountFont" />

			<Visual>
				<ImagerySection name="Border">
					<BorderComponent texture="Interface/GameUI/fg4_borders_01_19.htex" borderSize="20" />
				</ImagerySection>
				<ImagerySection name="Text">
					<TextComponent />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Border" />
						<Section section="Text" />
					</Layer>
				</StateImagery>
			</Visual>

			<Area>
				<Anchor point="BOTTOM" offset="-19.2" />
				<Anchor point="LEFT" offset="19.2" />
				<Anchor point="RIGHT" offset="-19.2" />
				<Size><AbsDimension x="0" y="57.6" /></Size>
			</Area>

			<Frame name="PlayerMoneyFrame" inherits="MoneyFrameTemplate">
				<Area>
					<Anchor point="BOTTOM" offset="-12.8" />
					<Anchor point="RIGHT" offset="-12.8" />
					<Size><AbsDimension x="80" y="35.2" /></Size>
				</Area>
			</Frame>

			<Scripts>
				<OnShow>
					return function(self)
						InventoryFrame_UpdateMoney(InventoryFrame);
					end
				</OnShow>
			</Scripts>
		</Frame>

		<Frame name="BagContainer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="InventoryTitleBar" offset="0" />
				<Anchor point="LEFT" offset="19.2" />
				<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="PlayerMoney" />
				<Size><AbsDimension x="102.4" /></Size>
			</Area>
		</Frame>

		<Frame name="ItemSlotContainer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="InventoryTitleBar" offset="0" />
				<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="BagContainer" offset="12.8" />
				<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="PlayerMoney" />
				<Anchor point="RIGHT" offset="-19.2" />
			</Area>
		</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					InventoryFrame_Load(this);
				end
			</OnLoad>
			<OnShow>
				return function(this)
					InventoryFrame_OnShow(this);
				end
			</OnShow>
			<OnHide>
				return function(this)
					InventoryFrame_StopMoving(this);
				end
			</OnHide>
			<OnMouseDown>
				return function(this, button)
					-- If clicking on inventory frame background (not a button), handle as invalid drop
					if CursorHasPayload() then
						HandleInvalidItemDrop();
						return true;  -- Event consumed
					end
					-- Inventory frame should consume clicks on its background (not bubble to world)
					return true;
				end
			</OnMouseDown>
		</Scripts>
	</Frame>
</UiLayout>
