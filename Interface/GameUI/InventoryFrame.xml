<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="InventoryFrame.lua" />

    <Frame name="InventoryFrame" renderer="DefaultRenderer" parent="GameParent">
		<Property name="Visible" value="False" />
		
		<Visual inherits="ThemeInventoryFrameVisual" />

		<Area>
			<Size><AbsDimension x="768" y="1024" /></Size>
			<Anchor point="BOTTOM" offset="-128" />
			<Anchor point="RIGHT" offset="0" />
		</Area>

		<Frame name="InventoryTitleBar" inherits="TitleBar">
			<Property name="Text" value="INVENTORY" />
			<Property name="Font" value="InventoryTitleFont" />
			<Property name="Clickable" value="true" />

			<Area>
				<Size><AbsDimension y="72" /></Size>
				<Anchor point="TOP" offset="19.2" />
				<Anchor point="LEFT" offset="19.2" />
				<Anchor point="RIGHT" offset="-19.2" />
			</Area>
		</Frame>

		<Frame name="PlayerMoney" renderer="DefaultRenderer">
			<Property name="Font" value="InventoryCountFont" />

			<Visual inherits="ThemePlayerMoneyVisual" />

			<Area>
				<Anchor point="BOTTOM" offset="-19.2" />
				<Anchor point="LEFT" offset="19.2" />
				<Anchor point="RIGHT" offset="-19.2" />
				<Size><AbsDimension x="0" y="57.6" /></Size>
			</Area>

			<Frame name="PlayerMoneyFrame" inherits="MoneyFrameTemplate">
				<Area>
					<Anchor point="BOTTOM" offset="-12.8" />
					<Anchor point="RIGHT" offset="-12.8" />
					<Size><AbsDimension x="80" y="35.2" /></Size>
				</Area>
			</Frame>

			<Scripts>
				<OnShow>
					return function(self)
						InventoryFrame_UpdateMoney(InventoryFrame);
					end
				</OnShow>
			</Scripts>
		</Frame>

		<Frame name="BagContainer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="InventoryTitleBar" offset="0" />
				<Anchor point="LEFT" offset="19.2" />
				<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="PlayerMoney" />
				<Size><AbsDimension x="102.4" /></Size>
			</Area>
		</Frame>

		<Frame name="ItemSlotContainer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="InventoryTitleBar" offset="0" />
				<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="BagContainer" offset="12.8" />
				<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="PlayerMoney" />
				<Anchor point="RIGHT" offset="-19.2" />
			</Area>
		</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					InventoryFrame_Load(this);
				end
			</OnLoad>
			<OnShow>
				return function(this)
					InventoryFrame_OnShow(this);
				end
			</OnShow>
			<OnHide>
				return function(this)
					InventoryFrame_StopMoving(this);
				end
			</OnHide>
			<OnMouseDown>
				return function(this, button)
					-- If clicking on inventory frame background (not a button), handle as invalid drop
					if CursorHasItem() then
						HandleInvalidItemDrop();
						return true;  -- Event consumed
					end
					-- Inventory frame should consume clicks on its background (not bubble to world)
					return true;
				end
			</OnMouseDown>
		</Scripts>
	</Frame>
</UiLayout>
