<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="AuraButton.lua" />

	<Frame name="AuraBarButtonTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />
		<Property name="Font" value="AuraTimeFont" />

		<Visual inherits="ThemeAuraBarButtonTemplateVisual" />

		<Area>
			<Size>
				<AbsDimension x="128" y="128" />
			</Size>
		</Area>

		<!-- Duration label: child frame rendered beneath the button icon -->
		<Frame name="DurationLabel" inherits="TextSmall">
			<Property name="Clickable" value="false" />
			<Property name="HorzAlign" value="CENTER" />
			<Property name="VertAlign" value="TOP" />
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" offset="4" />
				<Anchor point="LEFT" offset="0" />
				<Anchor point="RIGHT" offset="0" />
				<Size>
					<AbsDimension x="128" y="32" />
				</Size>
			</Area>
		</Frame>
        
        <Scripts>
            <OnLoad>
                return function(this)
                    AuraButton_OnLoad(this);
                end
            </OnLoad>
            <OnUpdate>
                return function(this, elapsed)
                    AuraButton_OnUpdate(this, elapsed);
                end
            </OnUpdate>
        </Scripts>
	</Frame>

</UiLayout>