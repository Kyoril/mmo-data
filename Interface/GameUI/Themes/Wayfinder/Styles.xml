<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui">
	<Font name="WayfinderChatFont" file="Interface/GameUI/Themes/BlueGold/Fonts/PTSerif-Regular.ttf" size="26" outline="1" shadowX="1" shadowY="1" />
	<Frame name="WayfinderEmpty">
		<Visual>
			<StateImagery name="Enabled" />
		</Visual>
	</Frame>

	<Frame name="WayfinderPanel">
		<Visual>
			<ImagerySection name="Surface">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/PanelRim.htex" borderSize="40" leftSize="44" rightSize="44" topSize="44" bottomSize="44" tint="FFFFFFFF" />
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavyWellV4.htex" tint="4EABA9A3"><Area><Inset all="18" /></Area></ImageComponent>
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Surface" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderTitle">
		<Visual>
			<ImagerySection name="Title">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Underline.htex" borderSize="12" leftSize="12" rightSize="12" topSize="12" bottomSize="12" tint="FFFFFFFF" />
				<TextComponent color="FFF1E5CC" horzAlign="LEFT" vertAlign="CENTER"><Area><Inset left="4" right="76" /></Area></TextComponent>
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Title" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderRule" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Property name="MousePassThrough" value="true" />
		<Visual>
			<ImagerySection name="Rule">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="485D6871" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Rule" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderFriendRow">
		<Visual>
			<ImagerySection name="Line">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Underline.htex" borderSize="8" leftSize="12" rightSize="12" topSize="12" bottomSize="12" tint="706C6F70" />
			</ImagerySection>
			<ImagerySection name="Hover">
				<ImageComponent texture="Interface/GlueUI/GlueListFade.htex" tint="48577791" />
			</ImagerySection>
			<ImagerySection name="Selected">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Selection.htex" borderSize="12" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="FFFFFFFF" />
				<ImageComponent texture="Interface/GlueUI/GlueListFade.htex" tint="876C5434"><Area><Inset all="5" /></Area></ImageComponent>
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="Line" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="Hover" />
					<Section section="Line" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="Hover" />
					<Section section="Line" />
				</Layer>
			</StateImagery>
			<StateImagery name="NormalChecked">
				<Layer>
					<Section section="Selected" />
					<Section section="Line" />
				</Layer>
			</StateImagery>
			<StateImagery name="HoveredChecked">
				<Layer>
					<Section section="Selected" />
					<Section section="Hover" />
					<Section section="Line" />
				</Layer>
			</StateImagery>
			<StateImagery name="PushedChecked">
				<Layer>
					<Section section="Selected" />
					<Section section="Line" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderButton">
		<Visual>
			<ImagerySection name="Base">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="12" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="F6C6BBA6" />
			</ImagerySection>
			<ImagerySection name="Hover">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Selection.htex" borderSize="12" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="F0FFE0AA" />
			</ImagerySection>
			<ImagerySection name="Pushed">
				<ImageComponent texture="Interface/GlueUI/GlueListFade.htex" tint="826A5B47" />
			</ImagerySection>
			<ImagerySection name="Text">
				<TextComponent color="FFE5D3AD" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="Disabled">
				<TextComponent color="FF78818A" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="Base" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="Base" />
					<Section section="Hover" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="Base" />
					<Section section="Pushed" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Base" />
					<Section section="Disabled" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderTab">
		<Visual>
			<ImagerySection name="Base" />
			<ImagerySection name="Hover">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Underline.htex" borderSize="12" leftSize="12" rightSize="12" topSize="12" bottomSize="12" tint="FFFFFFFF" />
			</ImagerySection>
			<ImagerySection name="Pushed" />
			<ImagerySection name="Text">
				<TextComponent color="FFE5D3AD" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="Disabled">
				<TextComponent color="FF78818A" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="Base" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="Base" />
					<Section section="Hover" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="Base" />
					<Section section="Pushed" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Base" />
					<Section section="Disabled" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderActiveTab" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Visual>
			<ImagerySection name="Tab">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Underline.htex" borderSize="12" leftSize="12" rightSize="12" topSize="12" bottomSize="12" tint="FFFFFFFF" />
				<TextComponent color="FFF1DFB8" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Tab" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderUtility">
		<Property name="Icon" />
		<Visual>
			<ImagerySection name="Icon">
				<ImageComponent><Area><Inset left="4" right="4" top="8" bottom="8" /></Area><PropertyValue property="Icon" /></ImageComponent>
			</ImagerySection>
			<ImagerySection name="Hover">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Underline.htex" borderSize="12" leftSize="12" rightSize="12" topSize="12" bottomSize="12" tint="FFFFFFFF" />
			</ImagerySection>
			<ImagerySection name="Disabled">
				<ImageComponent  tint="66888D93"><Area><Inset left="4" right="4" top="8" bottom="8" /></Area><PropertyValue property="Icon" /></ImageComponent>
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="Icon" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="Icon" />
					<Section section="Hover" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="Icon" />
					<Section section="Hover" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Disabled" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderMeter">
		<Visual>
			<ImagerySection name="Background">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="EF131B20" />
			</ImagerySection>
			<ImagerySection name="Progress">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarFillV4.htex" tint="FFFFFFFF" />
			</ImagerySection>
			<ImagerySection name="Frame">
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarRimV4.htex" borderSize="6" leftSize="208" rightSize="208" topSize="208" bottomSize="208" tint="FFD7C7A5" />
			</ImagerySection>
			<ImagerySection name="TickMarks">
				<ImageComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/MeterTicks.htex">
					<Area><Inset all="3" /></Area>
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Text">
				<TextComponent color="FFF3EEE0" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
			<StateImagery name="Progress">
				<Layer>
					<Section section="Progress" />
				</Layer>
			</StateImagery>
			<StateImagery name="Overlay">
				<Layer>
					<Section section="Frame" />
					<Section section="TickMarks" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderThinMeter">
		<Visual>
			<ImagerySection name="Background">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="EF131B20" />
			</ImagerySection>
			<ImagerySection name="Progress">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarFillV4.htex" tint="FFFFFFFF" />
			</ImagerySection>
			<ImagerySection name="Frame">
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarRimV4.htex" borderSize="6" leftSize="208" rightSize="208" topSize="208" bottomSize="208" tint="FFD7C7A5" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
			<StateImagery name="Progress">
				<Layer>
					<Section section="Progress" />
				</Layer>
			</StateImagery>
			<StateImagery name="Overlay">
				<Layer>
					<Section section="Frame" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderLevelXP">
		<Visual>
			<ImagerySection name="Background">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="EF131B20" />
			</ImagerySection>
			<ImagerySection name="Progress">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarFillV4.htex" tint="FF9BB8CF" />
			</ImagerySection>
			<ImagerySection name="Frame">
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarRimV4.htex" borderSize="6" leftSize="208" rightSize="208" topSize="208" bottomSize="208" tint="FFD7C7A5" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
			<StateImagery name="Progress">
				<Layer>
					<Section section="Progress" />
				</Layer>
			</StateImagery>
			<StateImagery name="Overlay">
				<Layer>
					<Section section="Frame" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="WayfinderClassXP">
		<Visual>
			<ImagerySection name="Background">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="EF131B20" />
			</ImagerySection>
			<ImagerySection name="Progress">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarFillV4.htex" tint="FFC7A467" />
			</ImagerySection>
			<ImagerySection name="Frame">
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/BarRimV4.htex" borderSize="6" leftSize="208" rightSize="208" topSize="208" bottomSize="208" tint="FFD7C7A5" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
			<StateImagery name="Progress">
				<Layer>
					<Section section="Progress" />
				</Layer>
			</StateImagery>
			<StateImagery name="Overlay">
				<Layer>
					<Section section="Frame" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>
	<Frame name="WayfinderMinimapRing">
		<Visual>
			<ImagerySection name="Ring">
				<ImageComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/MapRing.htex" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer><Section section="Ring" /></Layer>
			</StateImagery>
		</Visual>
	</Frame>
	<Frame name="WayfinderMinimapCaption">
		<Visual>
			<ImagerySection name="Caption">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/PanelRim.htex" borderSize="22" leftSize="44" rightSize="44" topSize="44" bottomSize="44" />
				<TextComponent color="FFF0E3C7" horzAlign="CENTER" vertAlign="CENTER"><Area><Inset right="52" /></Area></TextComponent>
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer><Section section="Caption" /></Layer>
			</StateImagery>
		</Visual>
	</Frame>
	<Frame name="WayfinderChatRail">
		<Visual>
			<ImagerySection name="Rail">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="22" leftSize="44" rightSize="44" topSize="44" bottomSize="44" tint="E8D5CBBA" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer><Section section="Rail" /></Layer>
			</StateImagery>
		</Visual>
	</Frame>
	<Frame name="WayfinderShortcut">
		<Visual>
			<ImagerySection name="Caption">
				<ImageComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/ShortcutShade.htex" />
				<TextComponent color="FFF3EAD5" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer><Section section="Caption" /></Layer>
			</StateImagery>
		</Visual>
	</Frame>
	<Frame name="WayfinderActionSlot">
		<Property name="ActiveGlowTint" value="FFFFFFFF" />
		<Property name="EmptySocketHoverTint" value="FFFFFFFF" />
		<Property name="EmptySocketTint" value="FFFFFFFF" />
		<Property name="HoveredFrameTint" value="FFFFFFFF" />
		<Property name="Icon" value="" />
		<Property name="NormalFrameTint" value="FFFFFFFF" />
		<Property name="PushedFrameTint" value="FFFFFFFF" />
		<Visual>
			<ImagerySection name="ActiveGlow">
				<ImageComponent texture="Interface/GlueUI/GlowYellow.htex" tint="$ActiveGlowTint">
					<Area>
						<Inset all="-4" />
					</Area>
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Image">
				<ImageComponent>
					<Area>
						<Inset all="8" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Counter">
				<TextComponent color="FFFFFFFF" horzAlign="RIGHT" vertAlign="BOTTOM">
					<Area>
						<Inset all="16" />
					</Area>
				</TextComponent>
			</ImagerySection>
			<ImagerySection name="NormalFrame">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="16" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="$NormalFrameTint" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/Selection.htex" borderSize="16" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="$HoveredFrameTint" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="16" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="$PushedFrameTint" />
			</ImagerySection>
			<ImagerySection name="PushedOverlay">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="60000000">
					<Area>
						<Inset all="10" />
					</Area>
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="EmptySocket">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="16" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="$EmptySocketTint" />
			</ImagerySection>
			<ImagerySection name="EmptySocketHovered">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="16" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="$EmptySocketHoverTint" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<BorderComponent texture="Interface/GameUI/Themes/Wayfinder/Textures/SocketRim.htex" borderSize="16" leftSize="32" rightSize="32" topSize="32" bottomSize="32" tint="FF626C7A" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="ActiveGlow" />
					<Section section="NormalFrame" />
					<Section section="EmptySocket" />
					<Section section="Image" />
					<Section section="Counter" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="ActiveGlow" />
					<Section section="HoveredFrame" />
					<Section section="EmptySocketHovered" />
					<Section section="Image" />
					<Section section="Counter" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="ActiveGlow" />
					<Section section="PushedFrame" />
					<Section section="EmptySocketHovered" />
					<Section section="Image" />
					<Section section="PushedOverlay" />
					<Section section="Counter" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="Image" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>
</UiLayout>
