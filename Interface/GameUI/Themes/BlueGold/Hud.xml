						<Inset all="8" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Counter">
				<TextComponent color="FFFFFFFF" horzAlign="RIGHT" vertAlign="BOTTOM">
					<Area>
						<Inset all="16" />
					</Area>
				</TextComponent>
			</ImagerySection>
			<ImagerySection name="NormalFrame">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavySurfaceV2.htex" tint="$NormalFrameTint" />
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/ButtonV2.htex" borderSize="14" leftSize="120" rightSize="120" topSize="120" bottomSize="120" tint="$NormalFrameTint" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavySurfaceV2.htex" tint="$HoveredFrameTint" />
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/ButtonV2.htex" borderSize="14" leftSize="120" rightSize="120" topSize="120" bottomSize="120" tint="$HoveredFrameTint" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavySurfaceV2.htex" tint="$PushedFrameTint" />
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/ButtonV2.htex" borderSize="14" leftSize="120" rightSize="120" topSize="120" bottomSize="120" tint="$PushedFrameTint" />
			</ImagerySection>
			<ImagerySection name="PushedOverlay">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="60000000">
					<Area>
						<Inset all="10" />
					</Area>
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="EmptySocket">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavySurfaceV2.htex" tint="$EmptySocketTint" />
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/ButtonV2.htex" borderSize="14" leftSize="120" rightSize="120" topSize="120" bottomSize="120" tint="$EmptySocketTint" />
			</ImagerySection>
			<ImagerySection name="EmptySocketHovered">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavySurfaceV2.htex" tint="$EmptySocketHoverTint" />
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/ButtonV2.htex" borderSize="14" leftSize="120" rightSize="120" topSize="120" bottomSize="120" tint="$EmptySocketHoverTint" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<ImageComponent texture="Interface/GameUI/Themes/BlueGold/Textures/NavySurfaceV2.htex" tint="FF626C7A" />
				<BorderComponent texture="Interface/GameUI/Themes/BlueGold/Textures/ButtonV2.htex" borderSize="14" leftSize="120" rightSize="120" topSize="120" bottomSize="120" tint="FF626C7A" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="ActiveGlow" />
					<Section section="NormalFrame" />
					<Section section="EmptySocket" />
					<Section section="Image" />
					<Section section="Counter" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="ActiveGlow" />
					<Section section="HoveredFrame" />
					<Section section="EmptySocketHovered" />
					<Section section="Image" />
					<Section section="Counter" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="ActiveGlow" />
					<Section section="PushedFrame" />
					<Section section="EmptySocketHovered" />
					<Section section="Image" />
					<Section section="PushedOverlay" />
					<Section section="Counter" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="Image" />
				</Layer>
			</StateImagery>
