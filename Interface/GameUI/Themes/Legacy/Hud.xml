				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$NormalFrameTint" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$HoveredFrameTint" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$PushedFrameTint" />
			</ImagerySection>
