<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="GameMenuBar.lua" />
	<Font name="ExperienceHudFont" file="Fonts/FRIZQT__.TTF" size="22" outline="1" shadowX="1.0" shadowY="1.0" />
	<Font name="ActionShortcutFont" file="Fonts/FRIZQT__.TTF" size="16" outline="1" shadowX="1.0" shadowY="1.0" />
	<Font name="CombatHudNameFont" file="Fonts/FRIZQT__.TTF" size="24" outline="1" shadowX="1.0" shadowY="1.0" />
	<Font name="CombatHudTextFont" file="Fonts/FRIZQT__.TTF" size="22" outline="1" shadowX="1.0" shadowY="1.0" />
	<Frame name="GameMenuBarImageButton" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />
		<Visual>
			<ImagerySection name="Image">
				<ImageComponent>
					<Area>
						<Inset left="16" right="16" top="24" bottom="24" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="NormalFrame">
				<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="8" tint="FF7E817F"><Area><Inset top="0" bottom="0" /></Area></BorderComponent>
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="8" tint="FFCEB67E"><Area><Inset top="0" bottom="0" /></Area></BorderComponent>
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="8" tint="FF665C49"><Area><Inset top="0" bottom="0" /></Area></BorderComponent>
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="8" tint="FF7E817F"><Area><Inset top="0" bottom="0" /></Area></BorderComponent>
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalFrame" />
					<Section section="Image" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredFrame" />
					<Section section="Image" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedFrame" />
					<Section section="Image" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="Image" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="80" y="96" />
			</Size>
		</Area>
	</Frame>
	<Frame name="GameMenuBarButtonTemplate" inherits="GlueButton">
		<Area>
			<Size>
				<AbsDimension x="400" y="96" />
			</Size>
			<Anchor point="LEFT" offset="16" />
		</Area>
	</Frame>
	<Frame name="GameMenuBar" renderer="DefaultRenderer" parent="GameParent">
		<Visual>
			<ImagerySection name="Background">
				<!-- Nine-slice corners remain fixed as the bar grows or XP rows collapse. -->
				<ImageComponent texture="Interface/GameUI/Alestia/BarMiddle.htex" tint="FFB5A790" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer><Section section="Background" /></Layer>
			</StateImagery>
		</Visual>
		<Frame name="ActionBackingLeft" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" /><Property name="Clickable" value="false" />
			<Area><Size><AbsDimension x="64" /></Size><Anchor point="LEFT" offset="-64" /><Anchor point="TOP" offset="0" /><Anchor point="BOTTOM" offset="0" /></Area>
			<Visual><ImagerySection name="Cap"><ImageComponent texture="Interface/GameUI/Alestia/BarLeftCap.htex" tint="FFB5A790" /></ImagerySection><StateImagery name="Enabled"><Layer><Section section="Cap" /></Layer></StateImagery></Visual>
		</Frame>
		<Frame name="ActionBackingRight" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" /><Property name="Clickable" value="false" />
			<Area><Size><AbsDimension x="64" /></Size><Anchor point="RIGHT" offset="64" /><Anchor point="TOP" offset="0" /><Anchor point="BOTTOM" offset="0" /></Area>
			<Visual><ImagerySection name="Cap"><ImageComponent texture="Interface/GameUI/Alestia/BarRightCap.htex" tint="FFB5A790" /></ImagerySection><StateImagery name="Enabled"><Layer><Section section="Cap" /></Layer></StateImagery></Visual>
		</Frame>
		<Frame name="ExperienceDock" renderer="DefaultRenderer">
			<Property name="Visible" value="false" />
			<Area><Size><AbsDimension y="120" /></Size><Anchor point="LEFT" offset="0" /><Anchor point="RIGHT" offset="0" /><Anchor point="BOTTOM" relativePoint="TOP" offset="0" /></Area>
			<Visual><ImagerySection name="Surface"><BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="8" tint="FFC3A36A" /></ImagerySection><StateImagery name="Enabled"><Layer><Section section="Surface" /></Layer></StateImagery></Visual>
		</Frame>

		<Frame name="PlayerExperienceBar" type="ProgressBar">
			<Property name="Progress" value="0.12783" />
			<Property name="Text" value="200 / 400" />
			<Property name="Font" value="ExperienceHudFont" />
			<Area>
				<Anchor point="LEFT" relativeTo="ExperienceDock" offset="8" />
				<Anchor point="RIGHT" relativeTo="ExperienceDock" offset="-8" />
				<Anchor point="BOTTOM" relativeTo="ExperienceDock" offset="-12" />
				<Size>
					<AbsDimension y="44" />
				</Size>
			</Area>
			<Visual>
				<ImagerySection name="Caption">
					<TextComponent color="FFFFFFFF" horzAlign="CENTER" vertAlign="CENTER" />
				</ImagerySection>
				<ImagerySection name="Background">
					<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="FF17130E" />
				</ImagerySection>
				<ImagerySection name="Border">
					<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="11" />
				</ImagerySection>
				<ImagerySection name="Progress">
					<ImageComponent texture="Interface/fg4_gradientWhiteV1_result.htex" tiling="HORZ" tint="FFAD58E8">
						<Area>
							<Inset all="3" />
						</Area>
					</ImageComponent>
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Background" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Background" />
					</Layer>
				</StateImagery>
				<StateImagery name="Progress">
					<Layer>
						<Section section="Progress" />
					</Layer>
				</StateImagery>
				<StateImagery name="Overlay">
					<Layer>

						<Section section="Caption" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
		<Frame name="PlayerClassExperienceBar" type="ProgressBar">
			<Property name="Progress" value="0" />
			<Property name="Font" value="ExperienceHudFont" />
			<Property name="Visible" value="False" />
			<Area>
				<Anchor point="LEFT" relativeTo="ExperienceDock" offset="8" />
				<Anchor point="RIGHT" relativeTo="ExperienceDock" offset="-8" />
				<Anchor point="BOTTOM" relativeTo="ExperienceDock" offset="-64" />
				<Size>
					<AbsDimension y="44" />
				</Size>
			</Area>
			<Visual>
				<ImagerySection name="Caption">
					<TextComponent color="FFFFFFFF" horzAlign="CENTER" vertAlign="CENTER" />
				</ImagerySection>
				<ImagerySection name="Background">
					<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="FF17130E" />
				</ImagerySection>
				<ImagerySection name="Border">
					<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="11" />
				</ImagerySection>
				<ImagerySection name="Progress">
					<ImageComponent texture="Interface/fg4_gradientWhiteV1_result.htex" tiling="HORZ" tint="FFE5A72D">
						<Area>
							<Inset all="3" />
						</Area>
					</ImageComponent>
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Background" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Background" />
					</Layer>
				</StateImagery>
				<StateImagery name="Progress">
					<Layer>
						<Section section="Progress" />
					</Layer>
				</StateImagery>
				<StateImagery name="Overlay">
					<Layer>

						<Section section="Caption" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
