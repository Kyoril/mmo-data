<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="GameMenuBar.lua" />

	<Frame name="GameMenuBarImageButton" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />
		<Visual inherits="ThemeGameMenuBarImageButtonVisual" />
		<Area>
			<Size>
				<AbsDimension x="80" y="96" />
			</Size>
		</Area>
		<!-- Attention badge in the icon's top right corner, hidden until MenuBarButton_SetBadge
		     gives it a count. Part of the template so that Clone() carries it into every button. -->
		<Frame name="Badge" renderer="DefaultRenderer">
			<Property name="Font" value="MenuBarBadgeFont" />
			<Property name="Visible" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="Enabled" value="false" />
			<Visual inherits="ThemeBadgeVisual" />
			<Area><Size><AbsDimension x="38" y="32" /></Size><Anchor point="TOP" offset="12" /><Anchor point="RIGHT" offset="-6" /></Area>
		</Frame>
	</Frame>
	<Frame name="GameMenuBarButtonTemplate" inherits="GlueButton">
		<Area>
			<Size>
				<AbsDimension x="400" y="96" />
			</Size>
			<Anchor point="LEFT" offset="16" />
		</Area>
	</Frame>
	<Frame name="GameMenuBar" renderer="DefaultRenderer" parent="GameParent">
		<Visual inherits="ThemeGameMenuBarVisual" />
		<Frame name="ActionBackingLeft" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" /><Property name="Clickable" value="false" />
			<Area><Size><AbsDimension x="64" /></Size><Anchor point="LEFT" offset="-64" /><Anchor point="TOP" offset="0" /><Anchor point="BOTTOM" offset="0" /></Area>
			<Visual inherits="ThemeActionBackingLeftVisual" />
		</Frame>
		<Frame name="ActionBackingRight" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" /><Property name="Clickable" value="false" />
			<Area><Size><AbsDimension x="64" /></Size><Anchor point="RIGHT" offset="64" /><Anchor point="TOP" offset="0" /><Anchor point="BOTTOM" offset="0" /></Area>
			<Visual inherits="ThemeActionBackingRightVisual" />
		</Frame>
		<!-- XP rails share the action bar's top seam; no separate panel or bottom border. -->
		<Frame name="ExperienceDock" renderer="DefaultRenderer">
			<Property name="Visible" value="false" />
			<Area><Size><AbsDimension y="96" /></Size><Anchor point="LEFT" offset="-56" /><Anchor point="RIGHT" offset="56" /><Anchor point="BOTTOM" relativePoint="TOP" offset="8" /></Area>

		</Frame>

		<Frame name="PlayerExperienceBar" type="ProgressBar">
			<Property name="FillMaterial" value="Interface/ProgressFill.hmat" />
			<Property name="SmoothSpeed" value="4" />
			<Property name="FillMaterialTint" value="FF6285B6" />
			<Property name="Progress" value="0.12783" />
			<Property name="Text" value="200 / 400" />
			<Property name="Font" value="ExperienceHudFont" />
			<Area>
				<Anchor point="LEFT" relativeTo="ExperienceDock" offset="4" />
				<Anchor point="RIGHT" relativeTo="ExperienceDock" offset="-4" />
				<Anchor point="BOTTOM" relativeTo="ExperienceDock" offset="0" />
				<Size>
					<AbsDimension y="44" />
				</Size>
			</Area>
			<Visual inherits="ThemePlayerExperienceBarVisual" />
		</Frame>
		<Frame name="PlayerClassExperienceBar" type="ProgressBar">
			<Property name="FillMaterial" value="Interface/ProgressFill.hmat" />
			<Property name="SmoothSpeed" value="4" />
			<Property name="FillMaterialTint" value="FFDEA83E" />
			<Property name="Progress" value="0" />
			<Property name="Font" value="ExperienceHudFont" />
			<Property name="Visible" value="False" />
			<Area>
				<Anchor point="LEFT" relativeTo="ExperienceDock" offset="4" />
				<Anchor point="RIGHT" relativeTo="ExperienceDock" offset="-4" />
				<Anchor point="BOTTOM" relativeTo="ExperienceDock" offset="-48" />
				<Size>
					<AbsDimension y="44" />
				</Size>
			</Area>
			<Visual inherits="ThemePlayerClassExperienceBarVisual" />
		</Frame>
		<!--
		<Frame name="LeftSideDecoration" renderer="DefaultRenderer">
			<Area>
				<Anchor point="LEFT" relativePoint="LEFT" offset="64"   />
				<Anchor point="BOTTOM" relativePoint="BOTTOM" offset="48"   />
				<Size><AbsDimension x="-256" y="256"   /></Size>
			</Area>

			<Visual>
				<ImagerySection name="Background">
					<ImageComponent texture="Interface/GameUI/fg4_icons_emblemLion_result.htex" tiling="NONE"   />
				</ImagerySection>

				<StateImagery name="Enabled">
					<Layer>
						<Section section="Background"   />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>

		<Frame name="RightSideDecoration" renderer="DefaultRenderer">
			<Area>
				<Anchor point="LEFT" relativePoint="RIGHT" offset="-64"   />
				<Anchor point="BOTTOM" relativePoint="BOTTOM" offset="48"   />
				<Size><AbsDimension x="256" y="256"   /></Size>
			</Area>

			<Visual>
				<ImagerySection name="Background">
					<ImageComponent texture="Interface/GameUI/fg4_icons_emblemLion_result.htex" tiling="NONE"   />
				</ImagerySection>

				<StateImagery name="Enabled">
					<Layer>
						<Section section="Background"   />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
-->
		<Area>
			<Size>
				<AbsDimension x="2128" y="156" />
			</Size>
			<Anchor point="BOTTOM" offset="-24" />
			<Anchor point="H_CENTER" offset="0" />
		</Area>
		<Scripts>
			<OnLoad>
				return function(this)
					GameMenuBar_OnLoad(this);
				end
			</OnLoad>
		</Scripts>
	</Frame>
	<Frame name="MenuBarButtons" parent="GameMenuBar" renderer="DefaultRenderer">
		<Area>
			<Size>
				<AbsDimension x="640" y="112" />
			</Size>
			<Anchor point="RIGHT" offset="-16" />
			<Anchor point="BOTTOM" offset="-24" />
		</Area>
		<Visual inherits="ThemeMenuBarButtonsVisual" />
	</Frame>
	<Frame name="AlestiaOakLeft" parent="GameParent" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Property name="Enabled" value="false" />
		<Area>
			<Size><AbsDimension x="96" y="192" /></Size>
			<Anchor point="RIGHT" relativeTo="GameMenuBar" relativePoint="LEFT" offset="-64" />
			<Anchor point="BOTTOM" relativeTo="GameMenuBar" relativePoint="BOTTOM" offset="0" />
		</Area>
		<Visual inherits="ThemeAlestiaOakLeftVisual" />
	</Frame>
	<Frame name="AlestiaOakRight" parent="GameParent" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Property name="Enabled" value="false" />
		<Area>
			<Size><AbsDimension x="96" y="192" /></Size>
			<Anchor point="LEFT" relativeTo="GameMenuBar" relativePoint="RIGHT" offset="64" />
			<Anchor point="BOTTOM" relativeTo="GameMenuBar" relativePoint="BOTTOM" offset="0" />
		</Area>
		<Visual inherits="ThemeAlestiaOakRightVisual" />
	</Frame>

	<Frame name="ActionMenuDivider" parent="GameMenuBar" renderer="DefaultRenderer">
		<Property name="Enabled" value="false" /><Property name="Clickable" value="false" />
		<Area><Size><AbsDimension x="2" y="88" /></Size><Anchor point="LEFT" offset="1460" /><Anchor point="BOTTOM" offset="-36" /></Area>
		<Visual inherits="ThemeActionMenuDividerVisual" />
	</Frame>
</UiLayout>
