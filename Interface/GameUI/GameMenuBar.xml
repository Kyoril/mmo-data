		<Visual><ImagerySection name="Line"><ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="FF8A704A" /></ImagerySection><StateImagery name="Enabled"><Layer><Section section="Line" /></Layer></StateImagery></Visual>
