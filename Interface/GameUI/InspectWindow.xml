		<Scripts>
			<OnLoad>return function(this) InspectWindow_OnLoad(this); end</OnLoad>
			<OnUpdate>return function(this, elapsed) InspectWindow_OnUpdate(this, elapsed); end</OnUpdate>
			<OnHide>return function(this) InspectWindow_OnHide(); end</OnHide>
			<OnMouseDown>return function(this) return true; end</OnMouseDown>
		</Scripts>
