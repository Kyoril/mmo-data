<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3.org/2001/XMLSchema-instance http://www.w3.org/2001/XMLSchema-instance">
	<Script file="QuestTracker.lua" />
	<Font name="QuestTrackerHeadingFont" file="Fonts/FRIZQT__.TTF" size="26" outline="1" shadowX="1.0" shadowY="1.0" />
	<Font name="QuestTrackerObjectiveFont" file="Fonts/FRIZQT__.TTF" size="20" outline="1" shadowX="1.0" shadowY="1.0" />
	<Font name="QuestTrackerTitleFont" file="Fonts/FRIZQT__.TTF" size="22" outline="1" shadowX="1.0" shadowY="1.0" />
	<!-- Toggle button template -->
	<Frame name="QuestTrackerToggleTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="StatusIcon" /><Property name="StatusTint" value="FFFFFFFF" />
		<Property name="Font" value="QuestTrackerTitleFont" />
		<Property name="HorzAlign" value="CENTER" />
		<Property name="VertAlign" value="CENTER" />
		<Visual>
			<ImagerySection name="FrameNormal">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="00000000" />
			</ImagerySection>
			<ImagerySection name="FrameHovered">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="303D2E17" />
			</ImagerySection>
			<ImagerySection name="FramePushed">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="50433119" />
			</ImagerySection>
			<ImagerySection name="TextNormal">
				<ImageComponent tint="$StatusTint"><PropertyValue property="StatusIcon" /></ImageComponent>
			</ImagerySection>
			<ImagerySection name="TextHovered">
				<ImageComponent tint="$StatusTint"><PropertyValue property="StatusIcon" /></ImageComponent>
			</ImagerySection>
			<ImagerySection name="TextPushed">
				<ImageComponent tint="$StatusTint"><PropertyValue property="StatusIcon" /></ImageComponent>
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="FrameNormal" />
				</Layer>
				<Layer>
					<Section section="TextNormal" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="FrameHovered" />
				</Layer>
				<Layer>
					<Section section="TextHovered" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="FramePushed" />
				</Layer>
				<Layer>
					<Section section="TextPushed" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="32" y="32" />
			</Size>
		</Area>
	</Frame>
	<Frame name="QuestTrackerCollapseTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="StatusIcon" /><Property name="StatusTint" value="FFFFFFFF" />
		<Property name="Font" value="QuestTrackerTitleFont" />
		<Property name="HorzAlign" value="CENTER" />
		<Property name="VertAlign" value="CENTER" />
		<Visual>
			<ImagerySection name="FrameNormal">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="00000000" />
			</ImagerySection>
			<ImagerySection name="FrameHovered">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="303D2E17" />
			</ImagerySection>
			<ImagerySection name="FramePushed">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="50433119" />
			</ImagerySection>
			<ImagerySection name="TextNormal">
				<TextComponent color="FFF3CF50" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="TextHovered">
				<TextComponent color="FFF3CF50" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="TextPushed">
				<TextComponent color="FFF3CF50" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="FrameNormal" />
				</Layer>
				<Layer>
					<Section section="TextNormal" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="FrameHovered" />
				</Layer>
				<Layer>
					<Section section="TextHovered" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="FramePushed" />
				</Layer>
				<Layer>
					<Section section="TextPushed" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="32" y="32" />
			</Size>
		</Area>
	</Frame>
	<!-- Title button template (clickable to open quest log) -->
	<Frame name="QuestTrackerTitleTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="Font" value="QuestTrackerTitleFont" />
		<Property name="HorzAlign" value="LEFT" />
		<Property name="VertAlign" value="TOP" />
		<Property name="TextColor" value="FFF3CF50" />
		<Property name="TextColorHover" value="FFFFFFFF" />
		<Property name="TextColorPush" value="FFCCCC88" />
		<Visual>
			<ImagerySection name="FrameNormal">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="00000000" />
			</ImagerySection>
			<ImagerySection name="FrameHovered">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="303D2E17" />
			</ImagerySection>
			<ImagerySection name="FramePushed">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="50433119" />
			</ImagerySection>
			<ImagerySection name="TextNormal">
				<TextComponent color="$TextColor" horzAlign="$HorzAlign" vertAlign="$VertAlign" />
			</ImagerySection>
			<ImagerySection name="TextHovered">
				<TextComponent color="$TextColorHover" horzAlign="$HorzAlign" vertAlign="$VertAlign" />
			</ImagerySection>
			<ImagerySection name="TextPushed">
				<TextComponent color="$TextColorPush" horzAlign="$HorzAlign" vertAlign="$VertAlign" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="FrameNormal" />
				</Layer>
				<Layer>
					<Section section="TextNormal" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="FrameHovered" />
				</Layer>
				<Layer>
					<Section section="TextHovered" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="FramePushed" />
				</Layer>
				<Layer>
					<Section section="TextPushed" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="352" y="32" />
			</Size>
		</Area>
	</Frame>
	<!-- Objective text template -->
	<Frame name="QuestTrackerObjTemplate" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Property name="Font" value="QuestTrackerObjectiveFont" />
		<Property name="HorzAlign" value="LEFT" />
		<Property name="VertAlign" value="TOP" />
		<Property name="TextColor" value="FFCEC8BC" />
		<Visual>
			<ImagerySection name="Text">
				<TextComponent color="$TextColor" horzAlign="$HorzAlign" vertAlign="$VertAlign" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="352" y="28" />
			</Size>
		</Area>
	</Frame>
	<!-- Quest Tracker panel: anchored below the Minimap, right-aligned -->
	<Frame name="QuestTrackerFrame" parent="GameParent" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Scripts>
			<OnLoad>
				return function(self)
					QuestTracker_OnLoad(self);
				end
			</OnLoad>
			<OnUpdate>
				return function(self, elapsed)
					QuestTracker_OnUpdate(self, elapsed);
				end
			</OnUpdate>
		</Scripts>
		<Area>
			<Size>
				<AbsDimension x="560" y="96" />
			</Size>
			<Anchor point="RIGHT" offset="0" relativeTo="Minimap" relativePoint="RIGHT" />
			<Anchor point="TOP" offset="24" relativeTo="Minimap" relativePoint="BOTTOM" />
		</Area>
		<!-- Slot 1 -->
		<Frame name="QuestTrackerToggle1" inherits="QuestTrackerToggleTemplate" id="1">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_ToggleCollapse(1);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerTitle1" inherits="QuestTrackerTitleTemplate" id="1">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_TitleClick(1);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerObj1_1" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj1_2" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj1_3" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj1_4" inherits="QuestTrackerObjTemplate" />
		<!-- Slot 2 -->
		<Frame name="QuestTrackerToggle2" inherits="QuestTrackerToggleTemplate" id="2">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_ToggleCollapse(2);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerTitle2" inherits="QuestTrackerTitleTemplate" id="2">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_TitleClick(2);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerObj2_1" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj2_2" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj2_3" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj2_4" inherits="QuestTrackerObjTemplate" />
		<!-- Slot 3 -->
		<Frame name="QuestTrackerToggle3" inherits="QuestTrackerToggleTemplate" id="3">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_ToggleCollapse(3);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerTitle3" inherits="QuestTrackerTitleTemplate" id="3">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_TitleClick(3);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerObj3_1" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj3_2" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj3_3" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj3_4" inherits="QuestTrackerObjTemplate" />
		<!-- Slot 4 -->
		<Frame name="QuestTrackerToggle4" inherits="QuestTrackerToggleTemplate" id="4">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_ToggleCollapse(4);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerTitle4" inherits="QuestTrackerTitleTemplate" id="4">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_TitleClick(4);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerObj4_1" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj4_2" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj4_3" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj4_4" inherits="QuestTrackerObjTemplate" />
		<!-- Slot 5 -->
		<Frame name="QuestTrackerToggle5" inherits="QuestTrackerToggleTemplate" id="5">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_ToggleCollapse(5);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerTitle5" inherits="QuestTrackerTitleTemplate" id="5">
			<Scripts>
				<OnClick>
					return function(self, button)
						QuestTracker_TitleClick(5);
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Frame name="QuestTrackerObj5_1" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj5_2" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj5_3" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerObj5_4" inherits="QuestTrackerObjTemplate" />
		<Frame name="QuestTrackerHeading" inherits="TextSmall">
			<Property name="Clickable" value="false" />
			<Property name="TextColor" value="FFF3CF50" />
			<Property name="Font" value="QuestTrackerHeadingFont" />
			<Property name="Text" value="HUD_QUEST_TRACKER" />
			<Area>
				<Size>
					<AbsDimension y="32" />
				</Size>
				<Anchor point="LEFT" offset="24" />
				<Anchor point="RIGHT" offset="-24" />
				<Anchor point="TOP" offset="16" />
			</Area>
		</Frame>
		<Frame name="QuestTrackerHeadingRule" renderer="DefaultRenderer">
			<Property name="Clickable" value="false" />
			<Area>
				<Size>
					<AbsDimension y="2" />
				</Size>
				<Anchor point="LEFT" offset="24" />
				<Anchor point="RIGHT" offset="-24" />
				<Anchor point="TOP" offset="54" />
			</Area>
			<Visual>
				<ImagerySection name="Rule">
					<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="C09E8050" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Rule" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
	</Frame>

	<Frame name="QuestTrackerCollapse1" inherits="QuestTrackerCollapseTemplate" parent="QuestTrackerFrame"><Scripts><OnClick>return function(self, button) QuestTracker_ToggleCollapse(1); end</OnClick></Scripts></Frame>

	<Frame name="QuestTrackerCollapse2" inherits="QuestTrackerCollapseTemplate" parent="QuestTrackerFrame"><Scripts><OnClick>return function(self, button) QuestTracker_ToggleCollapse(2); end</OnClick></Scripts></Frame>

	<Frame name="QuestTrackerCollapse3" inherits="QuestTrackerCollapseTemplate" parent="QuestTrackerFrame"><Scripts><OnClick>return function(self, button) QuestTracker_ToggleCollapse(3); end</OnClick></Scripts></Frame>

	<Frame name="QuestTrackerCollapse4" inherits="QuestTrackerCollapseTemplate" parent="QuestTrackerFrame"><Scripts><OnClick>return function(self, button) QuestTracker_ToggleCollapse(4); end</OnClick></Scripts></Frame>

	<Frame name="QuestTrackerCollapse5" inherits="QuestTrackerCollapseTemplate" parent="QuestTrackerFrame"><Scripts><OnClick>return function(self, button) QuestTracker_ToggleCollapse(5); end</OnClick></Scripts></Frame>
</UiLayout>
