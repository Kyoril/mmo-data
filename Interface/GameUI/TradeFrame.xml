<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="TradeFrame.lua" />

	<!-- Trade slot button template: 96x96 inner button (112x112 border, 8px inset each side) -->
	<Frame name="TradeSlotButtonTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />

		<Visual>
			<ImagerySection name="Image">
				<ImageComponent>
					<Area>
						<Inset all="16" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Text">
				<TextComponent horzAlign="RIGHT" vertAlign="BOTTOM">
					<Area>
						<Inset all="8" />
					</Area>
				</TextComponent>
			</ImagerySection>
			<ImagerySection name="NormalFrame">
				<BorderComponent texture="Interface/BW_ButtonSmall_Up.htex" borderSize="30" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<BorderComponent texture="Interface/BW_ButtonSmall_Over.htex" borderSize="30" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<BorderComponent texture="Interface/BW_ButtonSmall_Down.htex" borderSize="30" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<BorderComponent texture="Interface/BW_ButtonSmall_Up.htex" borderSize="30" tint="80808080" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalFrame" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredFrame" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedFrame" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Size><AbsDimension x="96" y="96" /></Size>
		</Area>
	</Frame>

	<!-- Trade slot border template: 112x112 -->
	<Frame name="TradeSlotBorderTemplate" renderer="DefaultRenderer">
		<Area>
			<Size><AbsDimension x="112" y="112" /></Size>
		</Area>

		<Visual>
			<ImagerySection name="Background">
				<BorderComponent texture="Interface/GameUI/fg4_iconsSlot.htex" borderSize="32" />
			</ImagerySection>
			<ImagerySection name="DisabledBackground">
				<BorderComponent texture="Interface/GameUI/fg4_iconsSlot.htex" borderSize="32" tint="80303030" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledBackground" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<!-- Thin horizontal rule used to separate the item offer from the money section -->
	<Frame name="TradeDividerTemplate" renderer="DefaultRenderer">
		<Area>
			<Size><AbsDimension x="352" y="4" /></Size>
		</Area>

		<Visual>
			<ImagerySection name="Line">
				<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="11" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Line" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<!-- Section label above a group of controls -->
	<Frame name="TradeSectionLabelTemplate" renderer="DefaultRenderer">
		<Property name="Font" value="SmallLabelFont" />
		<Property name="HorzAlign" value="LEFT" />

		<Visual>
			<ImagerySection name="Text">
				<TextComponent color="FFEED37C" horzAlign="$HorzAlign" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Size><AbsDimension x="352" y="36" /></Size>
		</Area>
	</Frame>

	<!-- Column headline above each offer grid -->
	<Frame name="TradeColumnHeaderTemplate" renderer="DefaultRenderer">
		<Property name="Font" value="DefaultSmall" />
		<Property name="HorzAlign" value="CENTER" />

		<Visual>
			<ImagerySection name="Text">
				<TextComponent color="FFFFD100" horzAlign="$HorzAlign" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Size><AbsDimension x="352" y="40" /></Size>
		</Area>
	</Frame>

	<!-- "Accepted" status line: check mark plus label, hidden until that side accepts -->
	<Frame name="TradeAcceptStatusTemplate" renderer="DefaultRenderer">
		<Property name="Visible" value="false" />

		<Area>
			<Size><AbsDimension x="352" y="44" /></Size>
		</Area>

		<Frame name="TradeAcceptStatusIcon" renderer="DefaultRenderer">
			<Visual>
				<ImagerySection name="Check">
					<ImageComponent texture="Interface/Icons/fg4_iconsGold_checkMark_result.htex" tiling="NONE" tint="FF54E36A" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Check" />
					</Layer>
				</StateImagery>
			</Visual>

			<Area>
				<Anchor point="LEFT" offset="0" />
				<Anchor point="V_CENTER" offset="0" />
				<Size><AbsDimension x="36" y="36" /></Size>
			</Area>
		</Frame>

		<Frame name="TradeAcceptStatusText" renderer="DefaultRenderer">
			<Property name="Font" value="DefaultSmall" />
			<Property name="Text" value="TRADE_ACCEPTED" />

			<Visual>
				<ImagerySection name="Text">
					<TextComponent color="FF54E36A" horzAlign="LEFT" vertAlign="CENTER" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
			</Visual>

			<Area>
				<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeAcceptStatusIcon" offset="10" />
				<Anchor point="TOP" offset="0" />
				<Anchor point="BOTTOM" offset="0" />
				<Size><AbsDimension x="300" /></Size>
			</Area>
		</Frame>
	</Frame>

	<!-- Money entry field: one denomination of the offered amount -->
	<Frame name="TradeMoneyFieldTemplate" inherits="GameTextField">
		<Property name="AcceptsTab" value="False" />
		<Property name="Font" value="DefaultSmall" />

		<Area>
			<Size><AbsDimension x="96" y="56" /></Size>
		</Area>
	</Frame>

	<!--
		Main Trade Frame: 880x860.
		Two 352 wide columns (3x2 slots of 112) at a 40 margin, separated by a 96 wide gutter
		holding a vertical rule. The player's column carries the money input, the partner's
		column mirrors it with a read only money display.
	-->
	<Frame name="TradeFrame" renderer="DefaultRenderer" parent="GameParent">
		<Property name="Visible" value="false" />

		<Visual>
			<ImagerySection name="Background">
				<BorderComponent texture="Interface/GameUI/fg4_borders_simple.htex" borderSize="250" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Size><AbsDimension x="880" y="860" /></Size>
		</Area>

		<!-- Title Bar. The partner name is written into it once the session opens. -->
		<Frame name="TradeTitleBar" inherits="TitleBar">
			<Property name="Text" value="TRADE_TITLE" />

			<Area>
				<Anchor point="TOP" offset="24" />
				<Anchor point="LEFT" offset="24" />
				<Anchor point="RIGHT" offset="-24" />
			</Area>
		</Frame>

		<!-- Column headers -->
		<Frame name="TradeMyOfferHeader" inherits="TradeColumnHeaderTemplate">
			<Property name="Text" value="TRADE_YOUR_OFFER" />

			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeTitleBar" offset="20" />
				<Anchor point="LEFT" offset="40" />
			</Area>
		</Frame>

		<Frame name="TradeTheirOfferHeader" inherits="TradeColumnHeaderTemplate">
			<Property name="Text" value="TRADE_THEIR_OFFER" />

			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeTitleBar" offset="20" />
				<Anchor point="RIGHT" offset="-40" />
			</Area>
		</Frame>

		<!-- Vertical rule between the two offers -->
		<Frame name="TradeColumnSeparator" renderer="DefaultRenderer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeTitleBar" offset="20" />
				<Anchor point="BOTTOM" offset="-232" />
				<Anchor point="H_CENTER" offset="0" />
				<Size><AbsDimension x="4" /></Size>
			</Area>

			<Visual>
				<ImagerySection name="Line">
					<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="11" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Line" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>

		<!-- My Trade Slots: 3 cols x 2 rows of 112px slots with 8px gaps = 352x232 -->
		<Frame name="TradeMySlotContainer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMyOfferHeader" offset="12" />
				<Anchor point="LEFT" offset="40" />
				<Size><AbsDimension x="352" y="232" /></Size>
			</Area>

			<!-- Row 1 -->
			<Frame name="TradeMySlot1Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" offset="0" />
					<Anchor point="LEFT" offset="0" />
				</Area>

				<Frame name="TradeMySlot1" inherits="TradeSlotButtonTemplate" id="1">
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeMySlot2Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" offset="0" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMySlot1Border" offset="8" />
				</Area>

				<Frame name="TradeMySlot2" inherits="TradeSlotButtonTemplate" id="2">
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeMySlot3Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" offset="0" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMySlot2Border" offset="8" />
				</Area>

				<Frame name="TradeMySlot3" inherits="TradeSlotButtonTemplate" id="3">
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<!-- Row 2 -->
			<Frame name="TradeMySlot4Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMySlot1Border" offset="8" />
					<Anchor point="LEFT" offset="0" />
				</Area>

				<Frame name="TradeMySlot4" inherits="TradeSlotButtonTemplate" id="4">
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeMySlot5Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMySlot2Border" offset="8" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMySlot4Border" offset="8" />
				</Area>

				<Frame name="TradeMySlot5" inherits="TradeSlotButtonTemplate" id="5">
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeMySlot6Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMySlot3Border" offset="8" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMySlot5Border" offset="8" />
				</Area>

				<Frame name="TradeMySlot6" inherits="TradeSlotButtonTemplate" id="6">
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>
		</Frame>

		<!-- Other Player's Trade Slots: 3 cols x 2 rows = 352x232 -->
		<Frame name="TradeOtherSlotContainer">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeTheirOfferHeader" offset="12" />
				<Anchor point="RIGHT" offset="-40" />
				<Size><AbsDimension x="352" y="232" /></Size>
			</Area>

			<!-- Row 1 -->
			<Frame name="TradeOtherSlot1Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" offset="0" />
					<Anchor point="LEFT" offset="0" />
				</Area>

				<Frame name="TradeOtherSlot1" inherits="TradeSlotButtonTemplate" id="1">
					<Property name="Enabled" value="false" />
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeOtherSlot2Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" offset="0" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeOtherSlot1Border" offset="8" />
				</Area>

				<Frame name="TradeOtherSlot2" inherits="TradeSlotButtonTemplate" id="2">
					<Property name="Enabled" value="false" />
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeOtherSlot3Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" offset="0" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeOtherSlot2Border" offset="8" />
				</Area>

				<Frame name="TradeOtherSlot3" inherits="TradeSlotButtonTemplate" id="3">
					<Property name="Enabled" value="false" />
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<!-- Row 2 -->
			<Frame name="TradeOtherSlot4Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeOtherSlot1Border" offset="8" />
					<Anchor point="LEFT" offset="0" />
				</Area>

				<Frame name="TradeOtherSlot4" inherits="TradeSlotButtonTemplate" id="4">
					<Property name="Enabled" value="false" />
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeOtherSlot5Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeOtherSlot2Border" offset="8" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeOtherSlot4Border" offset="8" />
				</Area>

				<Frame name="TradeOtherSlot5" inherits="TradeSlotButtonTemplate" id="5">
					<Property name="Enabled" value="false" />
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="TradeOtherSlot6Border" inherits="TradeSlotBorderTemplate">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeOtherSlot3Border" offset="8" />
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeOtherSlot5Border" offset="8" />
				</Area>

				<Frame name="TradeOtherSlot6" inherits="TradeSlotButtonTemplate" id="6">
					<Property name="Enabled" value="false" />
					<Area>
						<Anchor point="LEFT" offset="8" />
						<Anchor point="TOP" offset="8" />
					</Area>
				</Frame>
			</Frame>
		</Frame>

		<!-- ══ MONEY SECTION ══ -->

		<Frame name="TradeMyMoneyDivider" inherits="TradeDividerTemplate">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMySlotContainer" offset="24" />
				<Anchor point="LEFT" offset="40" />
			</Area>
		</Frame>

		<Frame name="TradeOtherMoneyDivider" inherits="TradeDividerTemplate">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeOtherSlotContainer" offset="24" />
				<Anchor point="RIGHT" offset="-40" />
			</Area>
		</Frame>

		<Frame name="TradeMyMoneyLabel" inherits="TradeSectionLabelTemplate">
			<Property name="Text" value="TRADE_YOUR_MONEY" />

			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMyMoneyDivider" offset="14" />
				<Anchor point="LEFT" offset="40" />
			</Area>
		</Frame>

		<Frame name="TradeOtherMoneyLabel" inherits="TradeSectionLabelTemplate">
			<Property name="Text" value="TRADE_THEIR_MONEY" />
			<Property name="HorzAlign" value="RIGHT" />

			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeOtherMoneyDivider" offset="14" />
				<Anchor point="RIGHT" offset="-40" />
			</Area>
		</Frame>

		<!--
			Money input row. Three separate fields (gold / silver / copper), each followed by its
			coin icon, so the amount is entered directly in the window instead of a popup dialog.
		-->
		<Frame name="TradeMoneyInputRow">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMyMoneyLabel" offset="8" />
				<Anchor point="LEFT" offset="40" />
				<Size><AbsDimension x="352" y="56" /></Size>
			</Area>

			<Frame name="TradeMoneyGoldField" inherits="TradeMoneyFieldTemplate">
				<Area>
					<Anchor point="LEFT" offset="0" />
					<Anchor point="TOP" offset="0" />
					<Size><AbsDimension x="96" y="56" /></Size>
				</Area>

				<Scripts>
					<OnTabPressed>
						return function(self)
							TradeMoneySilverField:CaptureInput();
						end
					</OnTabPressed>
					<OnEnterPressed>
						return function(self)
							self:ReleaseInput();
						end
					</OnEnterPressed>
				</Scripts>
			</Frame>

			<Frame name="TradeMoneyGoldIcon" inherits="IconTemplate">
				<Property name="Icon" value="Interface/Icons/Gold.htex" />

				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMoneyGoldField" offset="4" />
					<Anchor point="V_CENTER" offset="0" />
					<Size><AbsDimension x="32" y="32" /></Size>
				</Area>
			</Frame>

			<Frame name="TradeMoneySilverField" inherits="TradeMoneyFieldTemplate">
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMoneyGoldIcon" offset="10" />
					<Anchor point="TOP" offset="0" />
					<Size><AbsDimension x="64" y="56" /></Size>
				</Area>

				<Scripts>
					<OnTabPressed>
						return function(self)
							TradeMoneyCopperField:CaptureInput();
						end
					</OnTabPressed>
					<OnEnterPressed>
						return function(self)
							self:ReleaseInput();
						end
					</OnEnterPressed>
				</Scripts>
			</Frame>

			<Frame name="TradeMoneySilverIcon" inherits="IconTemplate">
				<Property name="Icon" value="Interface/Icons/Silver.htex" />

				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMoneySilverField" offset="4" />
					<Anchor point="V_CENTER" offset="0" />
					<Size><AbsDimension x="32" y="32" /></Size>
				</Area>
			</Frame>

			<Frame name="TradeMoneyCopperField" inherits="TradeMoneyFieldTemplate">
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMoneySilverIcon" offset="10" />
					<Anchor point="TOP" offset="0" />
					<Size><AbsDimension x="64" y="56" /></Size>
				</Area>

				<Scripts>
					<OnTabPressed>
						return function(self)
							TradeMoneyGoldField:CaptureInput();
						end
					</OnTabPressed>
					<OnEnterPressed>
						return function(self)
							self:ReleaseInput();
						end
					</OnEnterPressed>
				</Scripts>
			</Frame>

			<Frame name="TradeMoneyCopperIcon" inherits="IconTemplate">
				<Property name="Icon" value="Interface/Icons/Copper.htex" />

				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMoneyCopperField" offset="4" />
					<Anchor point="V_CENTER" offset="0" />
					<Size><AbsDimension x="32" y="32" /></Size>
				</Area>
			</Frame>
		</Frame>

		<!-- Reminder of how much the player actually owns, so the input can be judged at a glance -->
		<Frame name="TradeMyPurseRow">
			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeMoneyInputRow" offset="14" />
				<Anchor point="LEFT" offset="40" />
				<Size><AbsDimension x="352" y="44" /></Size>
			</Area>

			<Frame name="TradeMyPurseLabel" inherits="TradeSectionLabelTemplate">
				<Property name="Text" value="TRADE_YOUR_PURSE" />

				<Area>
					<Anchor point="LEFT" offset="0" />
					<Anchor point="TOP" offset="0" />
					<Anchor point="BOTTOM" offset="0" />
					<Size><AbsDimension x="130" /></Size>
				</Area>
			</Frame>

			<Frame name="TradeMyPurseFrame" inherits="MoneyFrameTemplate">
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="TradeMyPurseLabel" offset="8" />
					<Anchor point="V_CENTER" offset="0" />
					<Size><AbsDimension x="200" y="44" /></Size>
				</Area>
			</Frame>
		</Frame>

		<!-- Other player's money, mirrored on the right column -->
		<Frame name="TradeOtherMoneyRow" renderer="DefaultRenderer">
			<Visual>
				<ImagerySection name="Background">
					<BorderComponent texture="Interface/GameUI/fg4_borders_insetBlackSmall.htex" borderSize="11" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Background" />
					</Layer>
				</StateImagery>
			</Visual>

			<Area>
				<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="TradeOtherMoneyLabel" offset="8" />
				<Anchor point="RIGHT" offset="-40" />
				<Size><AbsDimension x="352" y="56" /></Size>
			</Area>

			<Frame name="TradeOtherMoneyFrame" inherits="MoneyFrameTemplate">
				<Area>
					<Anchor point="RIGHT" offset="-16" />
					<Anchor point="V_CENTER" offset="0" />
					<Size><AbsDimension x="200" y="44" /></Size>
				</Area>
			</Frame>
		</Frame>

		<!-- Accept status per side -->
