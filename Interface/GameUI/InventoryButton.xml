<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="InventoryButton.lua" />

	<Frame name="InventoryItemButtonTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />
		<Property name="IconColor" value="FFFFFFFF" />
		<Property name="Background" />
		<!-- Tint applied to the button frame. Slots that opt in to quality borders (see
		     QualityBorder) recolor this to the equipped item's quality color. -->
		<Property name="QualityColor" value="FFFFFFFF" />
		<!-- "true" makes InventoryItemButton_OnUpdate drive QualityColor from the item quality. -->
		<Property name="QualityBorder" value="false" />
        <Property name="DragEnabled" value="true" />
        <Property name="DropEnabled" value="true" />

		<Visual>
			<ImagerySection name="Background">
				<ImageComponent>
					<Area>
						<Inset all="16" />
					</Area>
					<PropertyValue property="Background" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Image">
				<ImageComponent tint="$IconColor">
					<Area>
						<Inset all="16" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Text">
				<TextComponent horzAlign="RIGHT" vertAlign="BOTTOM">
					<Area>
						<Inset all="16" />
					</Area>
				</TextComponent>
			</ImagerySection>
			<ImagerySection name="NormalFrame">
				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$QualityColor" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$QualityColor" />
			<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="30FFFFFF" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$QualityColor" />
			<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="50000000" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<ImageComponent texture="Interface/GameUI/Alestia/ActionSocket.htex" tint="$QualityColor" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalFrame" />
					<Section section="Background" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredFrame" />
					<Section section="Background" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedFrame" />
					<Section section="Background" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="Background" />
					<Section section="Image" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Size>
				<AbsDimension x="128" y="128" />
			</Size>
		</Area>
        
        <Scripts>
            <OnLoad>
                return function(this)
                    InventoryItemButton_OnLoad(this);
                end
            </OnLoad>
            <OnUpdate>
                return function(this, elapsed)
                    InventoryItemButton_OnUpdate(this, elapsed);
                end
            </OnUpdate>
            <OnDrag>
                return function(this, button, position)
                    InventoryItemButton_OnDrag(this, button, position);
                end
            </OnDrag>
            <OnDrop>
                return function(this, button, position)
                    InventoryItemButton_OnDrop(this, button, position);
                end
            </OnDrop>
        </Scripts>
	</Frame>
</UiLayout>