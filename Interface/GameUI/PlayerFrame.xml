		</Area>
		<Visual inherits="ThemePartyFrameVisual" />
		<Frame name="PlayerPortrait" renderer="DefaultRenderer">
			<Area>
				<Size>
					<AbsDimension x="136" y="136" />
				</Size>
				<Anchor point="TOP" offset="8" />
				<Anchor point="LEFT" offset="8" />
			</Area>
			<Visual inherits="ThemePlayerPortraitVisual" />
			<Frame name="PlayerPortraitModel" type="UnitModel" renderer="ModelRenderer">
				<Property name="Animation" value="Idle" />
				<Property name="Yaw" value="-90" />
				<Property name="Zoom" value="0.55" />
				<Property name="OffsetY" value="1.7" />
				<Area>
					<Anchor point="TOP" offset="16" />
					<Anchor point="LEFT" offset="16" />
					<Anchor point="RIGHT" offset="-16" />
					<Anchor point="BOTTOM" offset="-16" />
				</Area>
			</Frame>
			<Frame name="PlayerPortraitLevel" renderer="DefaultRenderer">
				<Property name="Font" value="CombatHudTextFont" />
				<Property name="TextColor" value="FFFFFFFF" />
				<Property name="Icon" />
				<Visual inherits="ThemePlayerPortraitLevelVisual" />
				<Area>
					<Size>
						<AbsDimension x="64" y="40" />
					</Size>
					<Anchor point="H_CENTER" offset="0" />
					<Anchor point="BOTTOM" offset="18" />
				</Area>
			</Frame>
			<Frame name="PlayerPortraitCombat" renderer="DefaultRenderer">
				<Property name="Visible" value="false" />
				<Visual inherits="ThemePlayerPortraitCombatVisual" />
				<Area>
					<Anchor point="H_CENTER" />
					<Anchor point="BOTTOM" offset="24" />
					<Size>
						<AbsDimension x="48" y="48" />
					</Size>
				</Area>
			</Frame>
		</Frame>
		<Frame name="PlayerName" inherits="TextSmall">
			<Property name="TextColor" value="FFF0E7D6" />
			<Property name="Font" value="CombatHudNameFont" />
			<Property name="HorzAlign" value="LEFT" />
			<Area>
				<Size>
					<AbsDimension y="42" />
				</Size>
				<Anchor point="LEFT" offset="16" relativeTo="PlayerPortrait" relativePoint="RIGHT" />
				<Anchor point="RIGHT" offset="-8" />
				<Anchor point="TOP" offset="4" />
			</Area>
		</Frame>
		<Frame name="PlayerHealthBar" type="ProgressBar">
			<Property name="FillMaterial" value="Interface/ProgressFill.hmat" />
			<Property name="SmoothSpeed" value="12" />
			<Property name="TrailDelay" value="0.35" />
			<Property name="TrailSpeed" value="0.7" />
			<Property name="TrailColor" value="B3FFE9B8" />
			<Property name="FillMaterialTint" value="FF43C653" />
			<Property name="Progress" value="0.12783" />
			<Property name="Font" value="CombatHudTextFont" />
			<Area>
				<Size>
					<AbsDimension y="60" />
				</Size>
				<Anchor point="LEFT" offset="16" relativeTo="PlayerPortrait" relativePoint="RIGHT" />
				<Anchor point="RIGHT" offset="-8" />
				<Anchor point="TOP" offset="0" relativeTo="PlayerName" relativePoint="BOTTOM" />
			</Area>
			<Visual inherits="ThemePlayerHealthBarVisual" />
		</Frame>
		<Frame name="PlayerManaBar" type="ProgressBar">
			<Property name="FillMaterial" value="Interface/ProgressFill.hmat" />
			<Property name="SmoothSpeed" value="12" />
			<Property name="Progress" value="0.12783" />
			<Property name="Font" value="CombatHudTextFont" />
			<Area>
				<Size>
					<AbsDimension y="44" />
				</Size>
				<Anchor point="LEFT" offset="16" relativeTo="PlayerPortrait" relativePoint="RIGHT" />
				<Anchor point="RIGHT" offset="-8" />
				<Anchor point="TOP" offset="6" relativeTo="PlayerHealthBar" relativePoint="BOTTOM" />
			</Area>
			<Visual inherits="ThemePlayerManaBarVisual" />
		</Frame>
		<Frame name="PlayerLeaderIcon" inherits="IconTemplate">
			<Property name="Visible" value="false" />
			<Property name="Icon" value="Interface/Icons/fg4_iconsGold_crown_result.htex" />
			<Area>
				<Anchor point="TOP" offset="20" />
				<Anchor point="LEFT" offset="20" />
			</Area>
		</Frame>
		<Frame name="PlayerFrameClick" setAllPoints="true">
			<Property name="HoverUnit" value="player" />
			<Scripts>
				<OnClick>
					return function(self, button)
						local pos = GetCursorPosition()
						PlayerFrame_OnClick(PlayerFrame, button, pos.x, pos.y)
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Scripts>
			<OnLoad>
                return function(self)
                    PlayerFrame_OnLoad(self);
                end
            </OnLoad>
		</Scripts>
	</Frame>
</UiLayout>
