<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Frame name="ActionBarButtonTemplate" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />
		<Property name="Font" value="CombatHudTextFont" />
		<Property name="DragEnabled" value="true" />
		<Property name="DropEnabled" value="true" />
		<!-- Tint of the "active" glow overlay. Transparent (00000000) hides it; the action bar sets
             it to an opaque colour while a "Disabled While Active" spell (e.g. Stealth) is active. -->
		<Property name="ActiveGlowTint" value="00000000" />
		<!-- Socket tints per state. The second action bar clears them on empty slots and shows the
             translucent EmptySocket instead, so unbound slots floating over the world stay light. -->
		<Property name="NormalFrameTint" value="FF998D7C" />
		<Property name="HoveredFrameTint" value="FFFFFFFF" />
		<Property name="PushedFrameTint" value="FF91806A" />
		<Property name="EmptySocketTint" value="00000000" />
		<Property name="EmptySocketHoverTint" value="00000000" />
		<Visual inherits="ThemeActionBarButtonTemplateVisual" />
		<Area>
			<Size>
				<AbsDimension x="112" y="112" />
			</Size>
		</Area>
		<!-- Cooldown overlay frame -->
		<Frame name="Cooldown" type="Cooldown">
			<Property name="Clickable" value="false" />
			<Property name="Enabled" value="false" />
			<Property name="Visible" value="false" />
			<Property name="Material" value="Interface/Cooldown_Instance.hmi" />
			<Area>
				<Anchor point="TOP" offset="10" />
				<Anchor point="LEFT" offset="10" />
				<Anchor point="BOTTOM" offset="-10" />
				<Anchor point="RIGHT" offset="-10" />
			</Area>
			<Scripts>
				<OnUpdate>
					return function(self, elapsed)
						ActionButton_UpdateCooldown(self:GetParent());
					end
				</OnUpdate>
			</Scripts>
		</Frame>
		<Scripts>
			<OnDrag>
                return function(this, button, position)
                    ActionBarButton_OnDrag(this, button, position);
                end
            </OnDrag>
			<OnDrop>
                return function(this, button, position)
                    ActionBarButton_OnDrop(this, button, position);
                end
            </OnDrop>
		</Scripts>
		<Frame name="ActionShortcut" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="Font" value="ActionShortcutFont" />
			<Area>
				<Size>
					<AbsDimension y="28" />
				</Size>
				<Anchor point="LEFT" offset="8" />
				<Anchor point="RIGHT" offset="-8" />
				<Anchor point="TOP" offset="2" />
			</Area>
			<Visual inherits="ThemeActionShortcutVisual" />
		</Frame>
		<!-- Child 2: remaining cooldown in seconds, shown for cooldowns longer than the global one. -->
		<Frame name="CooldownText" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="Visible" value="false" />
			<Property name="Font" value="ActionCooldownFont" />
			<Property name="TextColor" value="FFFFF6E0" />
			<Area>
				<Anchor point="TOP" offset="10" />
				<Anchor point="LEFT" offset="4" />
				<Anchor point="BOTTOM" offset="-10" />
				<Anchor point="RIGHT" offset="-4" />
			</Area>
			<Visual>
				<ImagerySection name="Text">
					<TextComponent color="$TextColor" horzAlign="CENTER" vertAlign="CENTER" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
		<!-- Child 3: resource cost of the spell, top left (interface option "Show Ability Costs"). The
		     shortcut label sits top right (BlueGold) or bottom centre (Wayfinder), the item count bottom right. -->
		<Frame name="ActionCost" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="Visible" value="false" />
			<Property name="Font" value="ActionCostFont" />
			<Property name="CostColor" value="FFFFFFFF" />
			<Area>
				<Size>
					<AbsDimension y="28" />
				</Size>
				<Anchor point="LEFT" offset="10" />
				<Anchor point="RIGHT" offset="-10" />
				<Anchor point="TOP" offset="6" />
			</Area>
			<Visual>
				<ImagerySection name="Text">
					<TextComponent color="$CostColor" horzAlign="LEFT" vertAlign="TOP" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
		<!-- Child 4: short glow when a longer cooldown finishes. -->
		<Frame name="ReadyFlash" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="Visible" value="false" />
			<Area>
				<Anchor point="TOP" offset="-6" />
				<Anchor point="LEFT" offset="-6" />
				<Anchor point="BOTTOM" offset="6" />
				<Anchor point="RIGHT" offset="6" />
			</Area>
			<Visual>
				<ImagerySection name="Glow">
					<ImageComponent texture="Interface/GlueUI/GlowYellow.htex" tint="FFFFF2C8" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Glow" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Glow" />
					</Layer>
				</StateImagery>
			</Visual>
			<Animations>
				<Animation name="Flash" duration="0.5" loop="false">
					<Track property="Opacity">
						<Keyframe time="0" value="0"/>
						<Keyframe time="0.07" value="1"/>
						<Keyframe time="0.5" value="0"/>
					</Track>
				</Animation>
			</Animations>
		</Frame>
	</Frame>
</UiLayout>
