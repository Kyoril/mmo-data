<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="TargetFrame.lua" />
	<Frame name="TargetFrame" parent="GameParent" renderer="DefaultRenderer">
		<Area>
			<Size>
				<AbsDimension x="560" y="176" />
			</Size>
			<Anchor point="LEFT" offset="360" relativePoint="H_CENTER" />
			<Anchor point="TOP" offset="0" relativeTo="PlayerFrame" />
		</Area>
		<Visual inherits="ThemePartyFrameVisual" />
		<Frame name="TargetPortrait" renderer="DefaultRenderer">
			<Area>
				<Size>
					<AbsDimension x="136" y="136" />
				</Size>
				<Anchor point="TOP" offset="8" />
				<Anchor point="RIGHT" offset="-8" />
			</Area>
			<Visual inherits="ThemePlayerPortraitVisual" />
			<Frame name="TargetPortraitModel" type="UnitModel" renderer="ModelRenderer">
				<Property name="Animation" value="Idle" />
				<Property name="Yaw" value="-90" />
				<Property name="Portrait" value="true" />
				<Area>
					<Anchor point="TOP" offset="16" />
					<Anchor point="LEFT" offset="16" />
					<Anchor point="RIGHT" offset="-16" />
					<Anchor point="BOTTOM" offset="-16" />
				</Area>
			</Frame>
			<Frame name="TargetPortraitLevel" renderer="DefaultRenderer">
				<Property name="Font" value="CombatHudTextFont" />
				<Property name="TextColor" value="FFFFFFFF" />
				<Visual inherits="ThemeTargetPortraitLevelVisual" />
				<Area>
					<Size>
						<AbsDimension x="64" y="40" />
					</Size>
					<Anchor point="H_CENTER" offset="0" />
					<Anchor point="BOTTOM" offset="18" />
				</Area>
			</Frame>
		</Frame>
		<Frame name="TargetName" inherits="TextSmall">
			<Property name="TextColor" value="FFF0E7D6" />
			<Property name="Font" value="CombatHudNameFont" />
			<Property name="HorzAlign" value="RIGHT" />
			<Area>
				<Size>
					<AbsDimension y="42" />
				</Size>
				<Anchor point="LEFT" offset="8" />
				<Anchor point="RIGHT" offset="-16" relativeTo="TargetPortrait" relativePoint="LEFT" />
				<Anchor point="TOP" offset="4" />
			</Area>
		</Frame>
		<Frame name="TargetHealthBar" type="ProgressBar">
			<Property name="Progress" value="0.12783" />
			<Property name="Font" value="CombatHudTextFont" />
			<Area>
				<Size>
					<AbsDimension y="60" />
				</Size>
				<Anchor point="LEFT" offset="8" />
				<Anchor point="RIGHT" offset="-16" relativeTo="TargetPortrait" relativePoint="LEFT" />
				<Anchor point="TOP" offset="0" relativeTo="TargetName" relativePoint="BOTTOM" />
			</Area>
			<Visual inherits="ThemePlayerHealthBarVisual" />
		</Frame>
		<Frame name="TargetManaBar" type="ProgressBar">
			<Property name="Progress" value="0.12783" />
			<Property name="Font" value="CombatHudTextFont" />
			<Area>
				<Size>
					<AbsDimension y="44" />
				</Size>
				<Anchor point="LEFT" offset="8" />
				<Anchor point="RIGHT" offset="-16" relativeTo="TargetPortrait" relativePoint="LEFT" />
				<Anchor point="TOP" offset="6" relativeTo="TargetHealthBar" relativePoint="BOTTOM" />
			</Area>
			<Visual inherits="ThemePlayerManaBarVisual" />
		</Frame>
		<Frame name="TargetFrameClick" setAllPoints="true">
			<Property name="HoverUnit" value="target" />
			<Scripts>
				<OnClick>
					return function(self, button)
						local pos = GetCursorPosition()
						TargetFrame_OnClick(TargetFrame, button, pos.x, pos.y)
					end
				</OnClick>
			</Scripts>
		</Frame>
		<Scripts>
			<OnLoad>
				return function(this)
					TargetFrame_OnLoad();
				end
			</OnLoad>
		</Scripts>
	</Frame>
	<!-- Target debuff icons live in their own frame below TargetFrame: hover hit-testing only
	     descends into children that lie inside their parent's rect, so as children of TargetFrame
	     (whose rect ends above them) the icons never received OnEnter and showed no tooltip. -->
	<Frame name="TargetAuraFrame" parent="GameParent">
		<Area>
			<Size>
				<AbsDimension x="392" y="80" />
			</Size>
			<Anchor point="LEFT" offset="0" relativeTo="TargetFrame" />
			<Anchor point="TOP" offset="0" relativeTo="TargetFrame" relativePoint="BOTTOM" />
		</Area>
		<Frame name="TargetAuraButton1" inherits="AuraBarButtonTemplate" id="1">
			<Area>
				<Size>
					<AbsDimension x="72" y="72" />
				</Size>
				<Anchor point="LEFT" offset="8" />
				<Anchor point="TOP" offset="8" />
			</Area>
		</Frame>
		<Frame name="TargetAuraButton2" inherits="AuraBarButtonTemplate" id="2">
			<Area>
				<Size>
					<AbsDimension x="72" y="72" />
				</Size>
				<Anchor point="LEFT" offset="6" relativeTo="TargetAuraButton1" relativePoint="RIGHT" />
				<Anchor point="TOP" offset="0" relativeTo="TargetAuraButton1" relativePoint="TOP" />
			</Area>
		</Frame>
		<Frame name="TargetAuraButton3" inherits="AuraBarButtonTemplate" id="3">
			<Area>
				<Size>
					<AbsDimension x="72" y="72" />
				</Size>
				<Anchor point="LEFT" offset="6" relativeTo="TargetAuraButton2" relativePoint="RIGHT" />
				<Anchor point="TOP" offset="0" relativeTo="TargetAuraButton1" relativePoint="TOP" />
			</Area>
		</Frame>
		<Frame name="TargetAuraButton4" inherits="AuraBarButtonTemplate" id="4">
			<Area>
				<Size>
					<AbsDimension x="72" y="72" />
				</Size>
				<Anchor point="LEFT" offset="6" relativeTo="TargetAuraButton3" relativePoint="RIGHT" />
				<Anchor point="TOP" offset="0" relativeTo="TargetAuraButton1" relativePoint="TOP" />
			</Area>
		</Frame>
		<Frame name="TargetAuraButton5" inherits="AuraBarButtonTemplate" id="5">
			<Area>
				<Size>
					<AbsDimension x="72" y="72" />
				</Size>
				<Anchor point="LEFT" offset="6" relativeTo="TargetAuraButton4" relativePoint="RIGHT" />
				<Anchor point="TOP" offset="0" relativeTo="TargetAuraButton1" relativePoint="TOP" />
			</Area>
		</Frame>
	</Frame>
</UiLayout>
