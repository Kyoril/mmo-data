<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<Script file="GameTooltip.lua" />

    <Frame name="GameTooltipLineTemplate" renderer="DefaultRenderer">
		<Property name="Font" value="TooltipFont" />

        <Visual inherits="ThemeEmoteNameLabelVisual" />
        <Area>
            <Size><AbsDimension x="512" y="32" /></Size>
        </Area>
    </Frame>

	<Frame name="GameTooltipIconLineTemplate" renderer="DefaultRenderer">
		<Area>
			<Size><AbsDimension x="512" y="32" /></Size>
		</Area>

		<Frame name="GameTooltipLineIcon" inherits="IconTemplate">
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="TOP" />
				<Size><AbsDimension x="32" y="32" /></Size>
			</Area>
		</Frame>

		<Frame name="GameTooltipLineIconText" inherits="GameTooltipLineTemplate">
			<Area>
				<Anchor point="LEFT" relativeTo="GameTooltipLineIcon" relativePoint="RIGHT" offset="8" />
				<Anchor point="RIGHT" />
				<Anchor point="TOP" />
				<Size><AbsDimension x="0" y="32" /></Size>
			</Area>
		</Frame>
	</Frame>

    <Frame name="GameTooltipLineRightTemplate" renderer="DefaultRenderer">
		<Property name="Font" value="TooltipFont" />

        <Visual inherits="ThemeGameTooltipLineRightTemplateVisual" />
        <Area>
            <Size><AbsDimension x="512" y="32" /></Size>
        </Area>
    </Frame>
    
    <Frame name="GameTooltip" renderer="DefaultRenderer" parent="GameParent" frameLevel="100">
		<Property name="Visible" value="False" />
		<Property name="MousePassThrough" value="true" />
		
		<Visual inherits="ThemeGameTooltipVisual" />

        <Frame name="GameTooltipLines">
            <Area>
                <Anchor point="TOP" relativePoint="TOP" offset="16" />
                <Anchor point="LEFT" offset="8" />
                <Anchor point="RIGHT" offset="-8" />
                <Anchor point="BOTTOM" offset="-8" />
            </Area>
        </Frame>

		<Frame name="TooltipMoneyText" inherits="TextSmall">
			<Property name="Text" value="SELL_PRICE" />
			<Property name="Font" value="SmallLabelFont" />
			
            <Area>
                <Anchor point="LEFT" offset="16" />
                <Anchor point="RIGHT" offset="-16" />
                <Anchor point="BOTTOM" offset="-16" />
            </Area>
		</Frame>

		<Frame name="TooltipMoneyFrame" inherits="MoneyFrameTemplate">
			<Property name="Visible" value="False" />
			
			<Area>
				<Anchor point="BOTTOM" offset="-16" />
				<Anchor point="LEFT" offset="16" />
				<Anchor point="RIGHT" offset="-16" />
			</Area>
		</Frame>

		<Area>
			<Size><AbsDimension x="540" y="96" /></Size>
			<Anchor point="RIGHT" offset="-64" />
			<Anchor point="BOTTOM" offset="-64" />
		</Area>

		<Scripts>
			<OnLoad>
				return function(self)
					GameTooltip_OnLoad(self);
				end
			</OnLoad>
			<OnUpdate>
				return function(self, deltaTime)
					GameTooltip_OnUpdate(self, deltaTime);
				end
			</OnUpdate>
		</Scripts>
	</Frame>

	<!-- Shows the equipped item next to an item tooltip while Alt is held. -->
	<Frame name="ItemCompareTooltip" renderer="DefaultRenderer" parent="GameParent" frameLevel="100">
		<Property name="Visible" value="False" />
		<Property name="MousePassThrough" value="true" />

		<Visual inherits="ThemeGameTooltipVisual" />

		<Frame name="ItemCompareTooltipLines">
			<Area>
				<Anchor point="TOP" relativePoint="TOP" offset="16" />
				<Anchor point="LEFT" offset="8" />
				<Anchor point="RIGHT" offset="-8" />
				<Anchor point="BOTTOM" offset="-8" />
			</Area>
		</Frame>

		<Frame name="ItemCompareTooltipMoneyText" inherits="TextSmall">
			<Property name="Text" value="SELL_PRICE" />
			<Property name="Font" value="SmallLabelFont" />

			<Area>
				<Anchor point="LEFT" offset="16" />
				<Anchor point="RIGHT" offset="-16" />
				<Anchor point="BOTTOM" offset="-16" />
			</Area>
		</Frame>

		<Frame name="ItemCompareTooltipMoneyFrame" inherits="MoneyFrameTemplate">
			<Property name="Visible" value="False" />

			<Area>
				<Anchor point="BOTTOM" offset="-16" />
				<Anchor point="LEFT" offset="16" />
				<Anchor point="RIGHT" offset="-16" />
			</Area>
		</Frame>

		<Area>
			<Size><AbsDimension x="540" y="96" /></Size>
			<Anchor point="RIGHT" offset="-64" />
			<Anchor point="BOTTOM" offset="-64" />
		</Area>

		<Scripts>
			<OnLoad>
				return function(self)
					ItemCompareTooltip_OnLoad(self);
				end
			</OnLoad>
			<OnUpdate>
				return function(self, deltaTime)
					ItemCompareTooltip_OnUpdate(self, deltaTime);
				end
			</OnUpdate>
		</Scripts>
	</Frame>
</UiLayout>
