				<!-- The outer window supplies the frame; the header stays unboxed. -->
				<TextComponent color="FFF0E7D6" horzAlign="LEFT">
					<Area><Inset left="16" right="96" top="8" bottom="8" /></Area>
				</TextComponent>
			</ImagerySection>
			<StateImagery name="Enabled">
