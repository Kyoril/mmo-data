<?xml version="1.0" ?>
<UiLayout xmlns="http://www.w3schools.com/Ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.w3schools.com/Ui.xsd file:///F:/mmo/data/client/Interface/Ui.xsd">
	<!-- The arrival of a brand-new character: title card, camera pull-in, then a pointer to
	     the first quest giver. Everything is mouse-transparent so the player can move right away.
	     No child may use CharacterTitleFont (or the other window title fonts): the Wayfinder theme
	     restyles such a child as a window title (left aligned, with a rule under it). -->
	<Script file="ArrivalFrame.lua" />

	<Frame name="ArrivalFrame" parent="GameParent">
		<Property name="MousePassThrough" value="true" />
		<Area>
			<Anchor point="LEFT" />
			<Anchor point="RIGHT" />
			<Anchor point="TOP" />
			<Anchor point="BOTTOM" />
		</Area>

			<Frame name="ArrivalTitle" inherits="TextSmall">
				<Property name="MousePassThrough" value="true" />
				<Property name="Font" value="ZoneTextFont" />
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FFF0D9A0" />
				<Area>
					<Size><AbsDimension y="96" /></Size>
					<Anchor point="LEFT" />
					<Anchor point="RIGHT" />
					<Anchor point="V_CENTER" offset="-300" />
				</Area>
			</Frame>

			<Frame name="ArrivalTagline" inherits="TextSmall">
				<Property name="MousePassThrough" value="true" />
				<Property name="Font" value="DefaultHeader" />
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FFE8E2D2" />
				<Area>
					<Size><AbsDimension y="56" /></Size>
					<Anchor point="LEFT" />
					<Anchor point="RIGHT" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="ArrivalTitle" offset="8" />
				</Area>
			</Frame>

			<Frame name="ArrivalHint" inherits="TextSmall">
				<Property name="MousePassThrough" value="true" />
				<Property name="Font" value="CharacterBodyFont" />
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FFF0D9A0" />
				<Area>
					<Size><AbsDimension y="48" /></Size>
					<Anchor point="LEFT" />
					<Anchor point="RIGHT" />
					<Anchor point="V_CENTER" offset="-200" />
				</Area>
			</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					ArrivalFrame_OnLoad(this);
				end
			</OnLoad>
			<OnUpdate>
				return function(this, elapsed)
					ArrivalFrame_OnUpdate(this);
				end
			</OnUpdate>
		</Scripts>
	</Frame>
</UiLayout>
