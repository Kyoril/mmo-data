<?xml version="1.0" ?>
<UiLayout>
	<Script file="GlueDialog.lua" />
	
	<Frame name="GlueDialogBackground" parent="GlueParent" setAllPoints="true">
		<Property name="Visible" value="false" />
	
		<Frame name="GlueDialog" inherits="GlueBorderFrame">
			<Property name="Focusable" value="true" />
			<Area>
				<!-- The height is a placeholder: GlueDialog_Layout sizes it to the content on every show. -->
				<Size><AbsDimension x="1600" y="360" /></Size>
				<Anchor point="H_CENTER" />
				<Anchor point="V_CENTER" />
			</Area>
			
			<Frame name="GlueDialogLabel" inherits="GlueTextLarge">
				<Property name="Text" value="CONNECTING" />
				<Area>
					<Anchor point="LEFT" offset="80" />
					<Anchor point="RIGHT" offset="-80" />
					<Anchor point="TOP" offset="72" />
				</Area>
			</Frame>
			
			<Frame name="GlueButton01" inherits="GlueButton">
				<Property name="Text" value="CANCEL" />
				
				<Area>
					<Anchor point="H_CENTER" />
					<Anchor point="BOTTOM" relativeTo="GlueDialog" offset="-72" />
				</Area>
				
				<Scripts>
					<OnClick>
						return function(this)
							GlueDialog_Button1Clicked();
						end
					</OnClick>
				</Scripts>
			</Frame>
			
			<Frame name="GlueButton02" inherits="GlueButton">
				<Property name="Text" value="CANCEL" />
				<Property name="Visible" value="false" />
				
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="GlueButton01" offset="20" />
					<Anchor point="BOTTOM" relativeTo="GlueDialog" offset="-72" />
				</Area>

				<Scripts>
					<OnClick>
						return function(this)
							GlueDialog_Button2Clicked();
						end
					</OnClick>
				</Scripts>
			</Frame>
			<Scripts>
				<OnEnterPressed>
					return function(this)
						if GlueButton01:IsVisible() then
							GlueDialog_Button1Clicked();
						end
					end
				</OnEnterPressed>
			</Scripts>
		</Frame>
	</Frame>
</UiLayout>
