<!-- Login: one quiet column under the logo, on the dark side of the gate art (GlueParent's front door).
     Caption and headline, the two fields, "remember", and the brass login button. -->
<UiLayout>
	<Script file="AccountLogin.lua" />

	<Frame name="AccountLogin" parent="GlueParent" setAllPoints="true">
		<Property name="Clickable" value="false" />
		<Property name="Focusable" value="true" />

		<!-- The column. AccountLogin.lua slides it in; its children fade in one after another. -->
		<Frame name="AccountLoginContent">
			<Area>
				<Anchor point="LEFT" offset="260" />
				<Anchor point="TOP" offset="760" />
				<Size><AbsDimension x="1000" y="1000" /></Size>
			</Area>

			<Frame name="AccountLoginCaption" inherits="GlueCaption">
				<Property name="Text" value="LOGIN_CAPTION" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" /></Area>
			</Frame>
			<Frame name="AccountLoginHeadline" inherits="GlueTitle">
				<Property name="Text" value="LOGIN_HEADLINE" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountLoginCaption" offset="24" /></Area>
			</Frame>

			<Frame name="AccountNameLabel" inherits="GlueCaption">
				<Property name="Text" value="ACCOUNT_NAME" />
				<Property name="TextColor" value="FF9AA1A6" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountLoginHeadline" offset="56" /></Area>
			</Frame>
			<Frame name="AccountNameField" inherits="GlueTextField">
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountNameLabel" offset="12" /></Area>
				<Scripts>
					<OnTabPressed>return function(this) AccountPasswordField:CaptureInput(); end</OnTabPressed>
					<OnEnterPressed>return function(this) AccountLogin_Login(); end</OnEnterPressed>
				</Scripts>
			</Frame>

			<Frame name="AccountPasswordLabel" inherits="GlueCaption">
				<Property name="Text" value="ACCOUNT_PASSWORD" />
				<Property name="TextColor" value="FF9AA1A6" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountNameField" offset="36" /></Area>
			</Frame>
			<Frame name="AccountPasswordField" inherits="GlueTextField">
				<Property name="Masked" value="true" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountPasswordLabel" offset="12" /></Area>
				<Scripts>
					<OnTabPressed>return function(this) AccountNameField:CaptureInput(); end</OnTabPressed>
					<OnEnterPressed>return function(this) AccountLogin_Login(); end</OnEnterPressed>
				</Scripts>
			</Frame>

			<!-- Remembers the account name (never the password) between sessions. -->
			<Frame name="RememberAccountNameCheck" inherits="GlueCheckbox">
				<Area><Anchor point="LEFT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountPasswordField" offset="32" /></Area>
				<Scripts>
					<OnClick>return function(this) AccountLogin_OnRememberAccountNameToggled(); end</OnClick>
				</Scripts>
			</Frame>
			<Frame name="RememberAccountNameLabel" inherits="GlueTextSmall">
				<Property name="Text" value="REMEMBER_ACCOUNT_NAME" />
				<Property name="VertAlign" value="CENTER" />
				<Property name="TextColor" value="FFB8B1A3" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="RememberAccountNameCheck" offset="20" />
					<Anchor point="RIGHT" />
					<Anchor point="V_CENTER" relativePoint="V_CENTER" relativeTo="RememberAccountNameCheck" />
					<Size><AbsDimension y="48" /></Size>
				</Area>
			</Frame>

			<Frame name="LoginButton" inherits="GlueButtonPrimary">
				<Property name="Text" value="LOGIN" />
				<Area>
					<Anchor point="LEFT" />
					<Anchor point="RIGHT" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RememberAccountNameCheck" offset="64" />
					<Size><AbsDimension y="136" /></Size>
				</Area>
				<Scripts>
					<OnClick>return function(this) AccountLogin_Login(); end</OnClick>
				</Scripts>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>return function(this) AccountLogin_OnLoad(); end</OnLoad>
		</Scripts>
	</Frame>
</UiLayout>
