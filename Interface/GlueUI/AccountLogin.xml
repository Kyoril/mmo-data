<?xml version="1.0" ?>
<UiLayout>
	<!-- Reference lua script file here -->
	<Script file="AccountLogin.lua" />

	<!--
		Checkbox used by the login form: a frame border when unchecked, plus a checkmark icon when
		checked. Mirrors GameUI's OptionsCheckboxTemplate, which the glue UI does not load.
	-->
	<Frame name="GlueCheckbox" type="Button" renderer="CheckboxRenderer">
		<Property name="Checkable" value="true" />
		<Area>
			<Size><AbsDimension x="44" y="44" /></Size>
		</Area>
		<Visual>
			<ImagerySection name="FrameNormal"><BorderComponent texture="Interface/GlueUI/CharButtonUp.htex" borderSize="22" /></ImagerySection>
			<ImagerySection name="FrameHovered"><BorderComponent texture="Interface/GlueUI/CharButtonHovered.htex" borderSize="22" /></ImagerySection>
			<ImagerySection name="FramePushed"><BorderComponent texture="Interface/GlueUI/CharButtonPushed.htex" borderSize="22" /></ImagerySection>
			<ImagerySection name="FrameDisabled"><BorderComponent texture="Interface/GlueUI/CharButtonUp.htex" borderSize="22" tint="80606060" /></ImagerySection>
			<ImagerySection name="CheckIcon"><ImageComponent texture="Interface/Icons/fg4_iconsGold_checkMark_result.htex" tiling="NONE"><Area><Inset all="10" /></Area></ImageComponent></ImagerySection>
			<StateImagery name="Normal"><Layer><Section section="FrameNormal" /></Layer></StateImagery>
			<StateImagery name="Hovered"><Layer><Section section="FrameHovered" /></Layer></StateImagery>
			<StateImagery name="Pushed"><Layer><Section section="FramePushed" /></Layer></StateImagery>
			<StateImagery name="Disabled"><Layer><Section section="FrameDisabled" /></Layer></StateImagery>
			<StateImagery name="NormalChecked"><Layer><Section section="FramePushed" /><Section section="CheckIcon" /></Layer></StateImagery>
			<StateImagery name="HoveredChecked"><Layer><Section section="FrameHovered" /><Section section="CheckIcon" /></Layer></StateImagery>
			<StateImagery name="PushedChecked"><Layer><Section section="FramePushed" /><Section section="CheckIcon" color="FFAAAAAA" /></Layer></StateImagery>
			<StateImagery name="DisabledChecked"><Layer><Section section="FrameDisabled" /><Section section="CheckIcon" color="80808080" /></Layer></StateImagery>
		</Visual>
	</Frame>

	<!-- Account login frame -->
	<Frame name="AccountLogin" parent="GlueParent" setAllPoints="true" renderer="DefaultRenderer">
		<Property name="Focusable" value="true" />
		
		<Animations>
			<Animation name="FadeIn" duration="0.5" loop="false">
				<Track property="Opacity" target="AccountLoginContent">
					<Keyframe time="0" value="0"/>
					<Keyframe time="0.5" value="1"/>
				</Track>
			</Animation>
			<Animation name="FadeOut" duration="0.5" loop="false">
				<Track property="Opacity" target="AccountLoginContent">
					<Keyframe time="0" value="1"/>
					<Keyframe time="0.5" value="0"/>
				</Track>
			</Animation>
		</Animations>

		<Frame name="AccountLoginContent" setAllPoints="true">
			<Frame name="LoginBackgroundFrameBottom" renderer="DefaultRenderer">
				<Area>
					<Anchor point="LEFT"/>
					<Anchor point="RIGHT"/>
					<Anchor point="BOTTOM"/>
					<Size><AbsDimension y="500" /></Size>
				</Area>
				<Visual>
					<ImagerySection name="Background">
						<ImageComponent texture="Interface/GlueUI/GradientBlack.htex" tiling="HORZ" />
					</ImagerySection>

					<StateImagery name="Enabled">
						<Layer>
							<Section section="Background" />
						</Layer>
					</StateImagery>
				</Visual>
			</Frame>

			<!-- Dark backdrop centered on logo + form area -->
			<Frame name="LoginFormBackdrop" inherits="GlueBorderFrame">
				<Area>
					<Anchor point="H_CENTER" />
					<Anchor point="V_CENTER" offset="16" />
					<Size><AbsDimension x="740" y="740" /></Size>
				</Area>
			</Frame>

			<!-- Game logo, always anchored near the top of the screen -->
			<Frame name="LoginLogoFrame" renderer="DefaultRenderer">
				<Area>
					<Anchor point="TOP" offset="32" />
					<Anchor point="H_CENTER" />
					<Size><AbsDimension x="971" y="512" /></Size>
				</Area>
				<Visual>
					<ImagerySection name="Background">
						<ImageComponent texture="Interface/Logo.htex" tiling="NONE" />
					</ImagerySection>
					<StateImagery name="Enabled">
						<Layer>
							<Section section="Background" />
						</Layer>
					</StateImagery>
				</Visual>
			</Frame>

			<Frame name="AccountPasswordField" inherits="GlueTextField">
				<Property name="Masked" value="true" />
				<Area>
					<Anchor point="BOTTOM" relativePoint="V_CENTER" offset="130" />
					<Anchor point="H_CENTER" />
					<Size><AbsDimension x="600" y="128" /></Size>
				</Area>
				<Scripts>
					<OnTabPressed>
						return function(this)
							AccountNameField:CaptureInput();
						end
					</OnTabPressed>
					<OnEnterPressed>
						return function(this)
							AccountLogin_Login();
						end
					</OnEnterPressed>
				</Scripts>
			</Frame>
			<Frame name="AccountPasswordLabel" inherits="GlueTextLarge">
				<Property name="Text" value="ACCOUNT_PASSWORD" />
				<Area>
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="AccountPasswordField" offset="-8" />
					<Anchor point="H_CENTER" />
				</Area>
			</Frame>
			<Frame name="AccountNameField" inherits="GlueTextField">
				<Area>
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="AccountPasswordLabel" offset="-16" />
					<Anchor point="H_CENTER" />
					<Size><AbsDimension x="600" y="128" /></Size>
				</Area>
				<Scripts>
					<OnTabPressed>
						return function(this)
							AccountPasswordField:CaptureInput();
						end
					</OnTabPressed>
					<OnEnterPressed>
						return function(this)
							AccountLogin_Login();
						end
					</OnEnterPressed>
				</Scripts>
			</Frame>
			<Frame name="AccountNameLabel" inherits="GlueTextLarge">
				<Property name="Text" value="ACCOUNT_NAME" />
				<Area>
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="AccountNameField" offset="-8" />
					<Anchor point="H_CENTER" />
				</Area>
			</Frame>

			<!-- Remembers the account name (never the password) between sessions. -->
			<Frame name="RememberAccountNameCheck" inherits="GlueCheckbox">
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="AccountPasswordField" offset="16" />
					<Anchor point="LEFT" relativePoint="LEFT" relativeTo="AccountPasswordField" />
					<Size><AbsDimension x="44" y="44" /></Size>
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							AccountLogin_OnRememberAccountNameToggled();
						end
					</OnClick>
				</Scripts>
			</Frame>
			<Frame name="RememberAccountNameLabel" inherits="GlueTextSmall">
				<Property name="Text" value="REMEMBER_ACCOUNT_NAME" />
				<Property name="VertAlign" value="CENTER" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="RememberAccountNameCheck" offset="12" />
					<Anchor point="V_CENTER" relativePoint="V_CENTER" relativeTo="RememberAccountNameCheck" />
					<Size><AbsDimension x="520" y="44" /></Size>
				</Area>
			</Frame>

			<Frame name="LoginButton" inherits="GlueButtonPrimary">
				<Property name="Text" value="LOGIN" />
				<Area>
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RememberAccountNameCheck" offset="24" />
					<Anchor point="H_CENTER" />
					<Size><AbsDimension x="600" y="128"/></Size>
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							AccountLogin_Login();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<Frame name="QuitButton" inherits="GlueButton">
				<Property name="Text" value="QUIT" />
				<Area>
					<Anchor point="RIGHT" offset="-24" />
					<Anchor point="BOTTOM" offset="-24"/>
				</Area>

				<Scripts>
					<OnClick>
						return function(this)
							RunConsoleCommand("quit");
						end
					</OnClick>
				</Scripts>
			</Frame>

			<Frame name="CopyrightLabel" inherits="GlueTextSmall">
				<Property name="Text" value="COPYRIGHT_TEXT" />
				<Property name="HorzAlign" value="CENTER" />

				<Area>
					<Size><AbsDimension x="0" y="44" offset="-8" /></Size>
					<Anchor point="H_CENTER" />
					<Anchor point="BOTTOM" offset="-24" />
				</Area>
			</Frame>

			<Frame name="LoginSettingsButton" inherits="GlueButton">
				<Property name="Text" value="SETTINGS" />
				<Area>
					<Anchor point="LEFT" offset="24" />
					<Anchor point="BOTTOM" offset="-24"/>
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							OptionsFrame_Toggle();
						end
					</OnClick>
				</Scripts>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					AccountLogin_OnLoad();
				end
			</OnLoad>
		</Scripts>
	</Frame>
</UiLayout>
