<?xml version="1.0"?>

<!-- This file contains frame templates that are often used by the GlueUI part. -->
<UiLayout xmlns="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://mmo-dev.net/ Ui.xsd">
	<Font name="DefaultSmall" file="Fonts/EBGaramond-Regular.ttf" size="32" outline="0" shadowX="1.0" shadowY="1.0" />
	<Font name="DefaultHeader" file="Fonts/EBGaramond-Regular.ttf" size="41" outline="0" shadowX="1.0" shadowY="1.0" />
	
	<!-- GlueButton template: Common buttons -->
	<Frame name="GlueButton" type="Button" renderer="ButtonRenderer">
		<Property name="Font" value="DefaultSmall" />
		<Property name="Icon" />

		<Visual>
			<!-- Steel frame (9-slice, 36) over a baked fill inset 14 so the fill never leaks past the frame. -->
			<ImagerySection name="NormalFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonNormal.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonHovered.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonPushed.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonDisabled.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" tint="FF8C8C8C" />
			</ImagerySection>
			<ImagerySection name="Caption">
				<TextComponent color="FFF3EEE2" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<!-- TODO: Remove these sections and only use the Caption section with overridden color values -->
			<ImagerySection name="HoveredCaption">
				<TextComponent color="FFFFFFFF" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="DisabledCaption">
				<TextComponent color="FF8A867E" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="Image">
				<ImageComponent>
					<Area>
						<Inset all="20" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="ImageDisabled">
				<ImageComponent tint="80888888">
					<Area>
						<Inset all="20" />
					</Area>
					<PropertyValue property="Icon" />
				</ImageComponent>
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalFrame" />
					<Section section="Image" />
					<Section section="Caption" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredFrame" />
					<Section section="Image" />
					<Section section="HoveredCaption" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedFrame" />
					<Section section="Image" />
					<Section section="Caption" color="FFDDDDDD" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="ImageDisabled" />
					<Section section="DisabledCaption" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="440" y="128" />
			</Size>
		</Area>
	</Frame>
	
	<!-- Primary glue button -->
	<Frame name="GlueButtonPrimary" type="Button" renderer="ButtonRenderer">
		<Visual>
			<!-- Steel frame (9-slice, 36) over a baked fill inset 14 so the fill never leaks past the frame. -->
			<ImagerySection name="NormalFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonNormal.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonHovered.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonPushed.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonDisabled.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" tint="FF8C8C8C" />
			</ImagerySection>
			<ImagerySection name="Caption">
				<TextComponent color="FFF3EEE2" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<!-- TODO: Remove these sections and only use the Caption section with overridden color values -->
			<ImagerySection name="HoveredCaption">
				<TextComponent color="FFFFFFFF" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<ImagerySection name="DisabledCaption">
				<TextComponent color="FF8A867E" horzAlign="CENTER" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalFrame" />
					<Section section="Caption" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredFrame" />
					<Section section="HoveredCaption" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedFrame" />
					<Section section="Caption" color="FFDDDDDD" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
					<Section section="DisabledCaption" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size>
				<AbsDimension x="440" y="128" />
			</Size>
		</Area>
	</Frame>
	
	<!-- Small label -->
	<Frame name="GlueTextSmall" renderer="DefaultRenderer">
		<Property name="Font" value="DefaultSmall" />
		<Property name="HorzAlign" value="LEFT" />
		<Property name="VertAlign" value="TOP" />
		<Property name="TextColor" value="FFCFE0D4" />

		<Visual>
			<ImagerySection name="Text">
				<TextComponent color="$TextColor" horzAlign="$HorzAlign" vertAlign="$VertAlign" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension x="0" y="44" /></Size>
		</Area>
	</Frame>
	
	<!-- Large label (headline) -->
	<Frame name="GlueTextLarge" renderer="DefaultRenderer">
		<Property name="Font" value="DefaultHeader" />
		<Property name="HorzAlign" value="CENTER" />
		
		<Visual>
			<ImagerySection name="Text">
				<TextComponent color="FFF3EEE2" horzAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension x="0" y="60" /></Size>
		</Area>
	</Frame>
	
	<!-- TextField template -->
	<Frame name="GlueTextField" type="TextField" renderer="TextFieldRenderer">
		<Property name="TextSection" value="Text" />
		<Property name="HorzAlign" value="LEFT" />
		<Property name="VertAlign" value="CENTER" />
	
		<Visual>
			<!-- Same steel frame as the buttons around dark stone; text padding is set by GlueTextField_ApplySkin. -->
			<ImagerySection name="Frame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinFieldFill.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="Caret">
				<ImageComponent texture="Interface/GlueUI/Caret.htex" />
			</ImagerySection>
			
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Frame" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Frame" />
				</Layer>
			</StateImagery>
			<StateImagery name="Caret">
				<Layer>
					<Section section="Caret" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension x="440" y="128" /></Size>
		</Area>
	</Frame>
	
	<Frame name="GlueBorderFrame" renderer="DefaultRenderer">
		<Visual>
			<!-- Dark wood with a bronze edge and corner ornaments: WindowPanel baked at 2x (tools/glue_skin). -->
			<ImagerySection name="Background">
				<BorderComponent texture="Interface/GlueUI/GlueSkinPanel.htex" borderSize="64" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Background" />
				</Layer>
			</StateImagery>
		</Visual>
	</Frame>

	<Frame name="ThumbButtonTemplate" type="Thumb" renderer="ButtonRenderer">
		<Visual>
			<!-- Steel frame (9-slice, 36) over a baked fill inset 14 so the fill never leaks past the frame. -->
			<ImagerySection name="NormalFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonNormal.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="HoveredFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonHovered.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="PushedFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonPushed.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="DisabledFrame">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonDisabled.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" tint="FF8C8C8C" />
			</ImagerySection>
			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalFrame" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredFrame" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedFrame" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledFrame" />
				</Layer>
			</StateImagery>
		</Visual>		
		<Area>
			<Anchor point="TOP" offset="80" />
			<Anchor point="LEFT" offset="8" />
			<Size>
				<AbsDimension x="80" y="256" />
			</Size>
		</Area>
	</Frame>
	
	<Frame name="VerticalScrollBar" type="ScrollBar" renderer="DefaultRenderer">
		<Property name="Orientation" value="VERTICAL" />

		<Visual>
			<ImagerySection name="Border">
				<BorderComponent texture="Interface/GameUI/fg4_borders_01_19.htex" borderSize="25" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Border" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Border" />
				</Layer>
			</StateImagery>
		</Visual>

		<Area>
			<Anchor point="RIGHT" offset="-16" />
			<Size>
				<AbsDimension x="96" y="256" />
			</Size>
		</Area>

		<Frame name="ScrollUpButton" inherits="GlueButton">
			<Property name="Icon" value="Interface/Icons/IconGold_ArrowUp.htex" />
			<Area>
				<Anchor point="TOP" offset="8" />
				<Anchor point="LEFT" offset="8" />
				<Size>
					<AbsDimension x="80" y="80" />
				</Size>
			</Area>
		</Frame>
		
		<Frame name="ScrollDownButton" inherits="GlueButton">
			<Property name="Icon" value="Interface/Icons/IconGold_ArrowDown.htex" />
			<Area>
				<Anchor point="BOTTOM" offset="-8" />
				<Anchor point="LEFT" offset="8" />
				<Size>
					<AbsDimension x="80" y="80" />
				</Size>
			</Area>
		</Frame>
		
		<Frame name="ThumbButton" inherits="ThumbButtonTemplate">			
			<Area>
				<Anchor point="TOP" offset="80" />
				<Anchor point="LEFT" offset="8" />
				<Size>
					<AbsDimension x="80" y="128" />
				</Size>
			</Area>
		</Frame>
	</Frame>
</UiLayout>
