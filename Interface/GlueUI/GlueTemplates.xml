<?xml version="1.0"?>

<!-- This file contains frame templates that are often used by the GlueUI part. -->
<UiLayout xmlns="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://mmo-dev.net/ Ui.xsd">
	
	<!-- Historical Legacy artwork notes. BlueGold uses the shared GameUI theme materials.
	     GlueSkin textures (Interface/GlueUI/GlueSkin*.htex): how they were made. They were baked once
	     with a throwaway Pillow script and imported with .agents/skills/mmo-item-designer/scripts/
	     import_item_icon.py (texconv, full mips); there is no generator in the repo. To change one,
	     decode its source with htex_tool.py preview, apply the recipe and import it again.
	     - Why 2x: a BorderComponent draws its corners as many UI units wide as it cuts source px, and
	       the UI is authored at 4K, so the panel and the steel frame are their sources doubled (LANCZOS)
	       to keep the approved size at 1080p (1 original px = 1 screen px).
	     - GlueSkinPanel (1024, DXT1, borderSize 64): GameUI/Alestia/WindowPanel.htex at 2x, opaque.
	     - GlueSkinSteelFrame (512, DXT5, borderSize 36): GameUI/fg4_borders_stone_edges_result.htex at
	       2x. Drawn over a fill inset 14, so the fill never leaks past the frame.
	     - GlueSkinButton{Normal,Hovered,Pushed,Disabled,Checked} (512x128, DXT1): vertical gradient
	       #4E6684 to #1A2232, GameUI/fg4_borders_stone_bg_01_result.htex at 24% opacity on top (a crop
	       from (64,160) of half the fill size, upscaled 2x), then a white top gloss fading from alpha 55
	       to 0 over the upper half. Hovered brightness x1.25; Pushed x0.72 with 35% gloss; Disabled
	       x0.5 with 40% gloss and 25% saturation; Checked x1.35 with 130% gloss and an ivory (F3EEE2)
	       glow rising quadratically to alpha 70 over the lower half.
	     - GlueSkinFieldFill (512x128, DXT1): the same stone crop at 25% brightness.
	     - GlueSkinRowHovered (512x128, DXT1): that stone crop at 42% brightness, the button gradient at
	       18% over it and 45% gloss. Hover of realm and roster rows.
	     - GlueSkinSteelFrameSelected (512, DXT5, borderSize 36): GlueSkinSteelFrame x1.6 brightness,
	       multiplied by ivory F3EEE2 and x1.08, plus a 3 px ivory line just inside the steel band
	       (alpha 190/120/50). Selected realm rows, roster rows and creation choices.
	     - GlueSkinWellFrame (256, DXT5, borderSize 18): GlueSkinSteelFrame at 1x, a thin rim for wells.
	     - GlueSkinWellFill (256, DXT1, tiling BOTH, inset 6): a 128 px stone crop from (64,160) at 22%
	       brightness, mirrored to a seamless 256 tile.
	     - GlueSkinArrow{Up,Down,Left,Right} (128, DXT5): grey copies of IconGold_ArrowUp/Down and
	       fg4_iconsGold_left/rightArrow (luminance scaled so the 98th percentile is white), tinted per
	       state in GlueArrowButton.
	     List style (realm list, roster; baked the same way, no generator in the repo):
	     - GlueListWell (128, DXT5, borderSize 32): sunken list well. Near-black brown fill (11 0C 08) at
	       alpha 238, a 4 px rim (dark bronze, two bronze px, dark bronze: about 2 px at 1080p) and an
	       inner shadow 28 px deep under the top rim and 10 px at the sides.
	     - GlueListFade (256x16, DXT5): white, alpha 1 at the left falling as (1 - t)^1.6 to 0 at 85% of
	       the width. Tinted for the hover (warm ivory) and selected (red) row glows.
	     - GlueListAccent (32, DXT5): white in the left 12 columns, transparent elsewhere. With
	       borderSize 12 it draws a 12 UI bar down the left edge of any row (selected accent); a crop
	       of the bar's centre (left 2, top 14, right 22, bottom 14, no borderSize) is a solid fill for
	       row separators and the scroll track. -->

	<!-- GlueButton template: Common buttons -->
	<Frame name="GlueButton" type="Button" renderer="ButtonRenderer">
		<Property name="Font" value="DefaultSmall" />
		<Property name="Icon" />

		<Visual inherits="ThemeGlueGlueButtonVisual" />
		<Area>
			<Size>
				<AbsDimension x="440" y="128" />
			</Size>
		</Area>
	</Frame>
	
	<!-- Primary glue button -->
	<Frame name="GlueButtonPrimary" type="Button" renderer="ButtonRenderer">
		<Visual inherits="ThemeGlueGlueButtonPrimaryVisual" />
		<Area>
			<Size>
				<AbsDimension x="440" y="128" />
			</Size>
		</Area>
	</Frame>
	
	<!-- Arrow button (scroll bars, character customization): the GlueButton frame with a neutral grey
	     arrow (GlueSkinArrow*, see the GlueSkin note above) tinted per state, so it follows the ivory palette instead
	     of the gold icon set. Set the arrow with the Icon property. -->
	<Frame name="GlueArrowButton" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />

		<Visual inherits="ThemeGlueGlueArrowButtonVisual" />
		<Area>
			<Size>
				<AbsDimension x="80" y="80" />
			</Size>
		</Area>
	</Frame>

	<!-- Small label -->
	<Frame name="GlueTextSmall" renderer="DefaultRenderer">
		<Property name="Font" value="DefaultSmall" />
		<Property name="HorzAlign" value="LEFT" />
		<Property name="VertAlign" value="TOP" />
		<Property name="TextColor" value="FFCFE0D4" />

		<Visual inherits="ThemeGlueGlueTextSmallVisual" />
		<Area>
			<Size><AbsDimension x="0" y="44" /></Size>
		</Area>
	</Frame>
	
	<!-- Large label (headline) -->
	<Frame name="GlueTextLarge" renderer="DefaultRenderer">
		<Property name="Font" value="DefaultHeader" />
		<Property name="HorzAlign" value="CENTER" />
		
		<Visual inherits="ThemeGlueGlueTextLargeVisual" />
		<Area>
			<Size><AbsDimension x="0" y="60" /></Size>
		</Area>
	</Frame>
	
	<!-- TextField template -->
	<Frame name="GlueTextField" type="TextField" renderer="TextFieldRenderer">
		<Property name="TextSection" value="Text" />
		<Property name="HorzAlign" value="LEFT" />
		<Property name="VertAlign" value="CENTER" />
	
		<Visual inherits="ThemeGlueGlueTextFieldVisual" />
		<Area>
			<Size><AbsDimension x="440" y="128" /></Size>
		</Area>

		<!-- Text padding for the steel frame. There is no XML property for it, so the template sets it
		     on load. Inheriting frames get this handler (unless they declare their own OnLoad), and so do
		     Lua clones: Copy() carries the handler and AddChild() runs it. Insets in UI units: 34 sideways
		     clears the steel band and its inner shadow (about 28); 36 above and below centres one line of
		     DefaultSmall (56 UI from ascender to descender) in a 128 tall field, and the caret is one line
		     tall because it spans the whole text area. -->
		<Scripts>
			<OnLoad>
				return function(this)
					this:SetTextAreaOffset(Rect(34, 36, 34, 36));
				end
			</OnLoad>
		</Scripts>
	</Frame>

	<!-- Thin bronze rule (dividers): the straight metal strip of GlueSkinSteelFrame's top band, source
	     rows 6-18 between the 36 px corners. Without borderSize a BorderComponent draws its corners and
	     edges zero units wide and only its centre, which maps the source rect (left, top) to
	     (width - right, height - bottom) onto the whole frame, so the sizes below crop that strip.
	     Give it a width and about 12 UI of height. -->
	<Frame name="GlueDivider" renderer="DefaultRenderer">
		<Property name="Clickable" value="false" />
		<Property name="LineColor" value="FFDEA660" />
		<Visual inherits="ThemeGlueGlueDividerVisual" />
		<Area>
			<Size><AbsDimension y="12" /></Size>
		</Area>
	</Frame>

	<!-- Sunken list well (realm list, roster): clearly darker than the wood, with a thin bronze rim and
	     an inner shadow under the top edge (GlueListWell, see the note above). Content belongs 8 UI
	     inside it. -->
	<Frame name="GlueListWell" renderer="DefaultRenderer">
		<Visual inherits="ThemeGlueGlueListWellVisual" />
	</Frame>

	<Frame name="GlueBorderFrame" renderer="DefaultRenderer">
		<Visual inherits="ThemeGlueGlueBorderFrameVisual" />
	</Frame>

	<!-- Scroll thumb: the red glue button art, 9-sliced (30) like GlueButton. -->
	<Frame name="ThumbButtonTemplate" type="Thumb" renderer="ButtonRenderer">
		<Visual inherits="ThemeGlueThumbButtonTemplateVisual" />
		<Area>
			<Anchor point="TOP" offset="80" />
			<Anchor point="LEFT" offset="8" />
			<Size>
				<AbsDimension x="80" y="256" />
			</Size>
		</Area>
	</Frame>

	<!-- Scroll bar arrow: the red glue button art with an ivory arrow (GlueSkinArrow*) tinted per state.
	     Set the arrow with the Icon property. GlueArrowButton (character creation) keeps the steel look. -->
	<Frame name="GlueScrollArrowButton" type="Button" renderer="ButtonRenderer">
		<Property name="Icon" />

		<Visual inherits="ThemeGlueGlueScrollArrowButtonVisual" />
		<Area>
			<Size>
				<AbsDimension x="80" y="80" />
			</Size>
		</Area>
	</Frame>

	<Frame name="VerticalScrollBar" type="ScrollBar" renderer="DefaultRenderer">
		<Property name="Orientation" value="VERTICAL" />

		<Visual inherits="ThemeGlueVerticalScrollBarVisual" />

		<Area>
			<Anchor point="RIGHT" offset="-16" />
			<Size>
				<AbsDimension x="96" y="256" />
			</Size>
		</Area>

		<Frame name="ScrollUpButton" inherits="GlueScrollArrowButton">
			<Property name="Icon" value="Interface/GlueUI/GlueSkinArrowUp.htex" />
			<Area>
				<Anchor point="TOP" offset="8" />
				<Anchor point="LEFT" offset="8" />
				<Size>
					<AbsDimension x="80" y="80" />
				</Size>
			</Area>
		</Frame>
		
		<Frame name="ScrollDownButton" inherits="GlueScrollArrowButton">
			<Property name="Icon" value="Interface/GlueUI/GlueSkinArrowDown.htex" />
			<Area>
				<Anchor point="BOTTOM" offset="-8" />
				<Anchor point="LEFT" offset="8" />
				<Size>
					<AbsDimension x="80" y="80" />
				</Size>
			</Area>
		</Frame>
		
		<Frame name="ThumbButton" inherits="ThumbButtonTemplate">			
			<Area>
				<Anchor point="TOP" offset="80" />
				<Anchor point="LEFT" offset="8" />
				<Size>
					<AbsDimension x="80" y="128" />
				</Size>
			</Area>
		</Frame>
	</Frame>
</UiLayout>
