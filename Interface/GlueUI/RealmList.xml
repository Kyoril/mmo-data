<!-- Realm selection: takes the login column's place under the logo. A short list of realms (row pool,
     scrolled by data offset), then Back and the brass Enter Realm button. -->
<UiLayout>
	<Script file="RealmList.lua" />

	<!-- One realm row. Checkable only so IsChecked() reports true: the click toggle is overwritten by
	     the Lua refresh, which checks exactly the selected realm. Children (Lua contract):
	     0 = population dot, 1 = info line, 2 = population label. -->
	<Frame name="RealmListRowTemplate" inherits="GlueListRow">
		<Frame name="RealmRowGem" renderer="DefaultRenderer">
			<Property name="Clickable" value="false" />
			<Property name="MousePassThrough" value="true" />
			<Property name="GemColor" value="FF4CD964" />
			<Visual>
				<ImagerySection name="Dot">
					<ImageComponent texture="Interface/GlueUI/Art/Glow.htex" tint="$GemColor" />
					<ImageComponent texture="Interface/GlueUI/Art/Dot.htex" tint="$GemColor"><Area><Inset all="22" /></Area></ImageComponent>
				</ImagerySection>
				<StateImagery name="Enabled"><Layer><Section section="Dot" /></Layer></StateImagery>
				<StateImagery name="Disabled"><Layer><Section section="Dot" /></Layer></StateImagery>
			</Visual>
			<Area>
				<Size><AbsDimension x="64" y="64" /></Size>
				<Anchor point="LEFT" offset="28" />
				<Anchor point="V_CENTER" />
			</Area>
		</Frame>

		<Frame name="RealmRowInfo" inherits="GlueNote">
			<Area>
				<Anchor point="LEFT" offset="104" />
				<Anchor point="RIGHT" offset="-300" />
				<Anchor point="BOTTOM" offset="-22" />
			</Area>
		</Frame>

		<Frame name="RealmRowPopulation" inherits="GlueCaption">
			<Property name="HorzAlign" value="RIGHT" />
			<Property name="VertAlign" value="CENTER" />
			<Area>
				<Size><AbsDimension x="280" y="60" /></Size>
				<Anchor point="RIGHT" offset="-32" />
				<Anchor point="V_CENTER" />
			</Area>
		</Frame>
	</Frame>

	<Frame name="RealmListFrame" parent="GlueParent" setAllPoints="true">
		<Property name="Visible" value="false" />
		<Property name="Clickable" value="false" />

		<Frame name="RealmListBorder">
			<Area>
				<Anchor point="LEFT" offset="260" />
				<Anchor point="TOP" offset="760" />
				<Size><AbsDimension x="1000" y="1200" /></Size>
			</Area>

			<Frame name="RealmListCaption" inherits="GlueCaption">
				<Property name="Text" value="REALM_LIST" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" /></Area>
			</Frame>
			<Frame name="RealmListHeaderLabel" inherits="GlueTitle">
				<Property name="Text" value="REALM_LIST_HEADLINE" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListCaption" offset="24" /></Area>
			</Frame>
			<Frame name="RealmListHeaderSubLabel" inherits="GlueNote">
				<Property name="Text" value="CHOOSE_A_REALM" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListHeaderLabel" offset="4" /></Area>
			</Frame>

			<!-- Four rows of 150; a hairline above closes the list off at the top. -->
			<Frame name="RealmList">
				<Area>
					<Anchor point="LEFT" />
					<Anchor point="RIGHT" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListHeaderSubLabel" offset="44" />
					<Size><AbsDimension y="602" /></Size>
				</Area>

				<Frame name="RealmListTopRule" inherits="GlueHairline">
					<Property name="FillColor" value="33D7C29A" />
					<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" /></Area>
				</Frame>

				<!-- RealmList.lua moves the right edge in while the scroll bar shows. -->
				<Frame name="RealmListContent">
					<Area>
						<Anchor point="LEFT" />
						<Anchor point="RIGHT" />
						<Anchor point="TOP" offset="2" />
						<Anchor point="BOTTOM" />
					</Area>

					<Frame name="RealmListRow1" inherits="RealmListRowTemplate">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" /></Area>
					</Frame>
					<Frame name="RealmListRow2" inherits="RealmListRowTemplate">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow1" /></Area>
					</Frame>
					<Frame name="RealmListRow3" inherits="RealmListRowTemplate">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow2" /></Area>
					</Frame>
					<Frame name="RealmListRow4" inherits="RealmListRowTemplate">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow3" /></Area>
					</Frame>
				</Frame>

				<Frame name="RealmListEmptyLabel" inherits="GlueNote">
					<Property name="Text" value="REALM_LIST_EMPTY" />
					<Property name="HorzAlign" value="CENTER" />
					<Property name="Visible" value="false" />
					<Area>
						<Anchor point="LEFT" offset="40" />
						<Anchor point="RIGHT" offset="-40" />
						<Anchor point="V_CENTER" />
						<Size><AbsDimension y="80" /></Size>
					</Area>
				</Frame>

				<Frame name="RealmListScrollBar" inherits="VerticalScrollBar">
					<Property name="Visible" value="false" />
					<Area>
						<Anchor point="RIGHT" />
						<Anchor point="TOP" offset="8" />
						<Anchor point="BOTTOM" offset="-8" />
					</Area>
				</Frame>
			</Frame>

			<Frame name="RealmListCountLabel" inherits="GlueNote">
				<Property name="TextColor" value="FFB8B1A3" />
				<Area><Anchor point="LEFT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmList" offset="20" /><Size><AbsDimension x="400" y="38" /></Size></Area>
			</Frame>
			<Frame name="RealmListHintLabel" inherits="GlueNote">
				<Property name="Text" value="REALM_LIST_HINT" />
				<Property name="TextColor" value="FF6F767C" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListCountLabel" offset="4" /></Area>
			</Frame>

			<Frame name="RealmListBackButton" inherits="GlueButton">
				<Property name="Text" value="REALM_BACK" />
				<Area>
					<Anchor point="LEFT" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListHintLabel" offset="40" />
					<Size><AbsDimension x="320" y="136" /></Size>
				</Area>
				<Scripts>
					<OnClick>return function(this) RealmList_Cancel(); end</OnClick>
				</Scripts>
			</Frame>
			<Frame name="RealmListButton01" inherits="GlueButtonPrimary">
				<Property name="Text" value="REALM_ENTER" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="RealmListBackButton" offset="24" />
					<Anchor point="RIGHT" />
					<Anchor point="TOP" relativePoint="TOP" relativeTo="RealmListBackButton" />
					<Size><AbsDimension y="136" /></Size>
				</Area>
				<Scripts>
					<OnClick>return function(this) RealmList_Accept(); end</OnClick>
				</Scripts>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>return function(this) RealmList_OnLoad(this); end</OnLoad>
		</Scripts>
	</Frame>
</UiLayout>
