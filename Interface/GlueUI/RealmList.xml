<?xml version="1.0" ?>
<UiLayout>
	<Script file="RealmList.lua" />

	<!-- Small, non-interactive label used inside realm rows. Clicks fall through to the row. -->
	<Frame name="RealmRowLabelTemplate" renderer="DefaultRenderer">
		<Property name="Font" value="DefaultSmall" />
		<Property name="Enabled" value="false" />
		<Property name="Clickable" value="false" />
		<Property name="TextColor" value="FF9AA89E" />
		<Property name="HorzAlign" value="LEFT" />

		<Visual>
			<ImagerySection name="Text">
				<TextComponent color="$TextColor" horzAlign="$HorzAlign" vertAlign="CENTER" />
			</ImagerySection>
			<StateImagery name="Enabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="Text" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension y="44" /></Size>
		</Area>
	</Frame>

	<!-- One realm row. Checkable only so IsChecked() reports true: the click toggle is overwritten
	     by the Lua refresh, which checks exactly the selected realm. Children are:
	     0 = population gem, 1 = info line, 2 = population label. -->
	<Frame name="RealmListRowTemplate" type="Button" renderer="CheckboxRenderer">
		<Property name="Font" value="DefaultHeader" />
		<Property name="Checkable" value="true" />
		<!-- TOP when the row shows an info line beneath the name, CENTER when the name stands alone. -->
		<Property name="NameVertAlign" value="CENTER" />

		<Visual>
			<!-- Steel-framed cards in the glue skin: dark stone at rest, lifted stone on hover, the
			     Checked steel-blue fill inside the bright selected frame (ivory inner line) when selected,
			     so selection never reads as hover. Frame 36 over a fill inset 14, like GlueButton. The
			     roster rows (CharButton, CharSelect.xml) use the same states. -->
			<ImagerySection name="NormalSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinFieldFill.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="HoveredSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinRowHovered.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="PushedSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonPushed.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="DisabledSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinFieldFill.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" tint="FF8C8C8C" />
			</ImagerySection>
			<ImagerySection name="CheckedSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonChecked.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrameSelected.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="Name">
				<TextComponent color="FFF3EEE2" horzAlign="LEFT" vertAlign="$NameVertAlign">
					<Area><Inset left="150" top="30" right="560" bottom="30" /></Area>
				</TextComponent>
			</ImagerySection>

			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalSurface" />
					<Section section="Name" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredSurface" />
					<Section section="Name" color="FFFFFFFF" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedSurface" />
					<Section section="Name" color="FFDDDDDD" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledSurface" />
					<Section section="Name" color="FF8A867E" />
				</Layer>
			</StateImagery>
			<StateImagery name="NormalChecked">
				<Layer>
					<Section section="CheckedSurface" />
					<Section section="Name" color="FFFFFFFF" />
				</Layer>
			</StateImagery>
			<StateImagery name="HoveredChecked">
				<Layer>
					<Section section="CheckedSurface" />
					<Section section="Name" color="FFFFFFFF" />
				</Layer>
			</StateImagery>
			<StateImagery name="PushedChecked">
				<Layer>
					<Section section="PushedSurface" />
					<Section section="Name" color="FFDDDDDD" />
				</Layer>
			</StateImagery>
			<StateImagery name="DisabledChecked">
				<Layer>
					<Section section="DisabledSurface" />
					<Section section="Name" color="FF8A867E" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension y="160" /></Size>
		</Area>

		<!-- Population gem: a soft glow tinted by the realm's population. -->
		<Frame name="RealmRowGem" renderer="DefaultRenderer">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="GemColor" value="FF40D040" />
			<Visual>
				<ImagerySection name="Gem">
					<ImageComponent texture="Interface/GlueUI/GlowYellow.htex" tint="$GemColor" />
					<ImageComponent texture="Interface/GlueUI/GlowYellow.htex" tint="$GemColor">
						<Area><Inset all="16" /></Area>
					</ImageComponent>
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Gem" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Gem" />
					</Layer>
				</StateImagery>
			</Visual>
			<Area>
				<Size><AbsDimension x="80" y="80" /></Size>
				<Anchor point="LEFT" offset="48" />
				<Anchor point="V_CENTER" />
			</Area>
		</Frame>

		<!-- Info line beneath the realm name (players online, last played). -->
		<Frame name="RealmRowInfo" inherits="RealmRowLabelTemplate">
			<Area>
				<Anchor point="LEFT" offset="150" />
				<Anchor point="RIGHT" offset="-560" />
				<Anchor point="BOTTOM" offset="-30" />
			</Area>
		</Frame>

		<!-- Population, right aligned under the column header. -->
		<Frame name="RealmRowPopulation" inherits="RealmRowLabelTemplate">
			<Property name="Font" value="DefaultHeader" />
			<Property name="HorzAlign" value="RIGHT" />
			<Area>
				<Size><AbsDimension x="480" y="60" /></Size>
				<Anchor point="RIGHT" offset="-56" />
				<Anchor point="V_CENTER" />
			</Area>
		</Frame>
	</Frame>

	<Frame name="RealmListFrame" parent="GlueParent" setAllPoints="true" renderer="DefaultRenderer">
		<Property name="Visible" value="false" />

		<Animations>
			<Animation name="FadeIn" duration="0.4" loop="false">
				<Track property="Opacity" target="RealmListBorder">
					<Keyframe time="0" value="0"/>
					<Keyframe time="0.4" value="1"/>
				</Track>
			</Animation>
			<Animation name="FadeOut" duration="0.3" loop="false">
				<Track property="Opacity" target="RealmListBorder">
					<Keyframe time="0" value="1"/>
					<Keyframe time="0.3" value="0"/>
				</Track>
			</Animation>
		</Animations>

		<!-- Darkens the lower part of the backdrop so the panel reads as the focus. -->
		<Frame name="RealmListShade" renderer="DefaultRenderer">
			<Property name="Clickable" value="false" />
			<Visual>
				<ImagerySection name="Shade">
					<ImageComponent texture="Interface/GlueUI/GradientBlack.htex" tiling="HORZ" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Shade" />
					</Layer>
				</StateImagery>
			</Visual>
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" />
				<Size><AbsDimension y="900" /></Size>
			</Area>
		</Frame>

		<Frame name="RealmListBorder" inherits="GlueBorderFrame">
			<Area>
				<Size><AbsDimension x="2000" y="1580" /></Size>
				<Anchor point="V_CENTER" />
				<Anchor point="H_CENTER" />
			</Area>

			<Frame name="RealmListHeaderLabel" inherits="GlueTextLarge">
				<Property name="Text" value="REALM_LIST" />
				<Area>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="TOP" offset="72" />
				</Area>
			</Frame>
			<Frame name="RealmListHeaderSubLabel" inherits="GlueTextSmall">
				<Property name="Text" value="CHOOSE_A_REALM" />
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FFCFE0D4" />
				<Area>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListHeaderLabel" offset="4" />
				</Area>
			</Frame>
			<Frame name="RealmListHeaderDivider" inherits="GlueDivider">
				<Area>
					<Size><AbsDimension x="900" y="12" /></Size>
					<Anchor point="H_CENTER" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListHeaderSubLabel" offset="20" />
				</Area>
			</Frame>

			<!-- Footer: back on the left, primary action on the right, status in between. -->
			<Frame name="RealmListBackButton" inherits="GlueButton">
				<Property name="Text" value="REALM_BACK" />
				<Area>
					<Size><AbsDimension x="440" y="128" /></Size>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="BOTTOM" offset="-72" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							RealmList_Cancel();
						end
					</OnClick>
				</Scripts>
			</Frame>
			<Frame name="RealmListButton01" inherits="GlueButtonPrimary">
				<Property name="Text" value="REALM_ENTER" />
				<Area>
					<Size><AbsDimension x="560" y="128" /></Size>
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="BOTTOM" offset="-72" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							RealmList_Accept();
						end
					</OnClick>
				</Scripts>
			</Frame>
			<Frame name="RealmListCountLabel" inherits="GlueTextSmall">
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FFF3EEE2" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="RealmListBackButton" offset="24" />
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="RealmListButton01" offset="-24" />
					<Anchor point="TOP" relativePoint="TOP" relativeTo="RealmListBackButton" offset="16" />
				</Area>
			</Frame>
			<Frame name="RealmListHintLabel" inherits="GlueTextSmall">
				<Property name="Text" value="REALM_LIST_HINT" />
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FF9AA89E" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="RealmListBackButton" offset="24" />
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="RealmListButton01" offset="-24" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListCountLabel" offset="8" />
				</Area>
			</Frame>

			<!-- The realm list. Rows are a fixed pool scrolled by data offset; each row is its own
			     steel-framed card, so the list itself draws nothing. Six rows of 160 with 12 between
			     them need 1020; the panel height leaves 1030. -->
			<Frame name="RealmList">
				<Area>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListHeaderDivider" offset="100" />
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="RealmListBackButton" offset="-40" />
				</Area>

				<!-- RealmList.lua moves the right edge in by 112 while the scroll bar shows. -->
				<Frame name="RealmListContent">
					<Area>
						<Anchor point="LEFT" />
						<Anchor point="RIGHT" />
						<Anchor point="TOP" />
						<Anchor point="BOTTOM" />
					</Area>

					<Frame name="RealmListRow1" inherits="RealmListRowTemplate">
						<Area>
							<Anchor point="LEFT" />
							<Anchor point="RIGHT" />
							<Anchor point="TOP" />
						</Area>
					</Frame>
					<Frame name="RealmListRow2" inherits="RealmListRowTemplate">
						<Area>
							<Anchor point="LEFT" />
							<Anchor point="RIGHT" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow1" offset="12" />
						</Area>
					</Frame>
					<Frame name="RealmListRow3" inherits="RealmListRowTemplate">
						<Area>
							<Anchor point="LEFT" />
							<Anchor point="RIGHT" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow2" offset="12" />
						</Area>
					</Frame>
					<Frame name="RealmListRow4" inherits="RealmListRowTemplate">
						<Area>
							<Anchor point="LEFT" />
							<Anchor point="RIGHT" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow3" offset="12" />
						</Area>
					</Frame>
					<Frame name="RealmListRow5" inherits="RealmListRowTemplate">
						<Area>
							<Anchor point="LEFT" />
							<Anchor point="RIGHT" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow4" offset="12" />
						</Area>
					</Frame>
					<Frame name="RealmListRow6" inherits="RealmListRowTemplate">
						<Area>
							<Anchor point="LEFT" />
							<Anchor point="RIGHT" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmListRow5" offset="12" />
						</Area>
					</Frame>
				</Frame>

				<Frame name="RealmListEmptyLabel" inherits="GlueTextSmall">
					<Property name="Text" value="REALM_LIST_EMPTY" />
					<Property name="HorzAlign" value="CENTER" />
					<Property name="TextColor" value="FF9AA89E" />
					<Property name="Visible" value="false" />
					<Area>
						<Anchor point="LEFT" offset="80" />
						<Anchor point="RIGHT" offset="-80" />
						<Anchor point="V_CENTER" />
					</Area>
				</Frame>

				<Frame name="RealmListScrollBar" inherits="VerticalScrollBar">
					<Property name="Visible" value="false" />
					<Area>
						<Anchor point="RIGHT" />
						<Anchor point="TOP" />
						<Anchor point="BOTTOM" />
					</Area>
				</Frame>
			</Frame>

			<!-- Column headers sit above the well and line up with the row content. -->
			<Frame name="RealmListColumnName" inherits="GlueTextSmall">
				<Property name="Text" value="REALM_COLUMN_NAME" />
				<Property name="TextColor" value="FFCFE0D4" />
				<Area>
					<Size><AbsDimension x="800" y="44" /></Size>
					<Anchor point="LEFT" relativePoint="LEFT" relativeTo="RealmListContent" offset="150" />
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="RealmList" offset="-12" />
				</Area>
			</Frame>
			<Frame name="RealmListColumnPopulation" inherits="GlueTextSmall">
				<Property name="Text" value="REALM_COLUMN_POPULATION" />
				<Property name="TextColor" value="FFCFE0D4" />
				<Property name="HorzAlign" value="RIGHT" />
				<Area>
					<Size><AbsDimension x="600" y="44" /></Size>
					<Anchor point="RIGHT" relativePoint="RIGHT" relativeTo="RealmListContent" offset="-56" />
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="RealmList" offset="-12" />
				</Area>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					RealmList_OnLoad(this);
				end
			</OnLoad>
		</Scripts>
	</Frame>
</UiLayout>
