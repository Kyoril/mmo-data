<!-- Character creation: a glass panel on the left walks through two steps (origin: race, class,
     gender; appearance: customization and name) while the character stands to the right of it. -->
<UiLayout xmlns="http://mmo-dev.net/ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://mmo-dev.net/ui UI.xsd">
	<Script file="CharCreate.lua" />

	<!-- Race and gender choices. -->
	<Frame name="ListCheckButtonBase" inherits="GlueChoice">
		<Area><Size><AbsDimension x="536" y="104" /></Size></Area>
	</Frame>

	<!-- Class choice: the class glyph on the left, the name beside it. Child 0 = glyph (Icon). -->
	<Frame name="ClassCheckButtonBase" type="Button" renderer="CheckboxRenderer">
		<Property name="Font" value="DefaultHeader" />
		<Property name="Checkable" value="true" />
		<Visual>
			<ImagerySection name="Rest">
				<BorderComponent texture="Interface/GlueUI/Art/PanelFill.htex" borderSize="24" leftSize="20" rightSize="20" topSize="20" bottomSize="20" tint="99121820" />
				<BorderComponent texture="Interface/GlueUI/Art/PanelLine.htex" borderSize="24" leftSize="20" rightSize="20" topSize="20" bottomSize="20" tint="40D7C29A" />
			</ImagerySection>
			<ImagerySection name="Hover">
				<BorderComponent texture="Interface/GlueUI/Art/PanelFill.htex" borderSize="24" leftSize="20" rightSize="20" topSize="20" bottomSize="20" tint="CC1C232B" />
				<BorderComponent texture="Interface/GlueUI/Art/PanelLine.htex" borderSize="24" leftSize="20" rightSize="20" topSize="20" bottomSize="20" tint="99E3C78F" />
			</ImagerySection>
			<ImagerySection name="Chosen">
				<ImageComponent texture="Interface/GlueUI/Art/FadeH.htex" tint="59C99A4E"><Area><Inset all="4" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/Art/PanelLine.htex" borderSize="24" leftSize="20" rightSize="20" topSize="20" bottomSize="20" tint="FFE3C78F" />
			</ImagerySection>
			<ImagerySection name="Caption"><TextComponent color="FFCFC6B4" horzAlign="LEFT" vertAlign="CENTER"><Area><Inset left="136" right="20" /></Area></TextComponent></ImagerySection>
			<StateImagery name="Normal"><Layer><Section section="Rest" /><Section section="Caption" /></Layer></StateImagery>
			<StateImagery name="Hovered"><Layer><Section section="Hover" /><Section section="Caption" color="FFFFF6E2" /></Layer></StateImagery>
			<StateImagery name="Pushed"><Layer><Section section="Hover" /><Section section="Caption" /></Layer></StateImagery>
			<StateImagery name="Disabled"><Layer><Section section="Rest" color="66FFFFFF" /><Section section="Caption" color="FF5E656B" /></Layer></StateImagery>
			<StateImagery name="NormalChecked"><Layer><Section section="Rest" /><Section section="Chosen" /><Section section="Caption" color="FFFFE9BD" /></Layer></StateImagery>
			<StateImagery name="HoveredChecked"><Layer><Section section="Rest" /><Section section="Chosen" /><Section section="Caption" color="FFFFF3D6" /></Layer></StateImagery>
			<StateImagery name="PushedChecked"><Layer><Section section="Rest" /><Section section="Chosen" /><Section section="Caption" color="FFFFE9BD" /></Layer></StateImagery>
			<StateImagery name="DisabledChecked"><Layer><Section section="Rest" /><Section section="Chosen" color="80FFFFFF" /><Section section="Caption" color="FF8A8A8A" /></Layer></StateImagery>
		</Visual>
		<Area><Size><AbsDimension x="536" y="136" /></Size></Area>
		<Frame name="ClassChoiceIcon" renderer="DefaultRenderer">
			<Property name="Clickable" value="false" />
			<Property name="MousePassThrough" value="true" />
			<Property name="Icon" />
			<Visual>
				<ImagerySection name="Glyph"><ImageComponent tint="FFE3D3B0"><PropertyValue property="Icon" /></ImageComponent></ImagerySection>
				<StateImagery name="Enabled"><Layer><Section section="Glyph" /></Layer></StateImagery>
				<StateImagery name="Disabled"><Layer><Section section="Glyph" color="66FFFFFF" /></Layer></StateImagery>
			</Visual>
			<Area>
				<Anchor point="LEFT" offset="32" />
				<Anchor point="V_CENTER" />
				<Size><AbsDimension x="76" y="76" /></Size>
			</Area>
		</Frame>
	</Frame>

	<!-- One customization row: name on the left, the value between two chevrons on the right.
	     Child order is part of the Lua contract (0 name, 1 previous, 2 next, 3 value). -->
	<Frame name="CustomizationPropertyButton" renderer="DefaultRenderer">
		<Visual>
			<ImagerySection name="Rule">
				<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="1FD7C29A"><Area><Inset left="0" right="0" top="110" bottom="0" /></Area></ImageComponent>
			</ImagerySection>
			<StateImagery name="Enabled"><Layer><Section section="Rule" /></Layer></StateImagery>
		</Visual>
		<Area><Size><AbsDimension x="1096" y="112" /></Size></Area>
		<Frame inherits="GlueTextSmall" name="PropertyName">
			<Property name="VertAlign" value="CENTER" />
			<Property name="TextColor" value="FFB8B1A3" />
			<Area>
				<Anchor point="LEFT" offset="8" />
				<Anchor point="TOP" />
				<Anchor point="BOTTOM" />
				<Size><AbsDimension x="440" /></Size>
			</Area>
		</Frame>
		<Frame inherits="GlueIconButton" name="PrevButton">
			<Property name="Icon" value="Interface/GlueUI/Art/ChevronLeft.htex" />
			<Area>
				<Anchor point="RIGHT" offset="-472" />
				<Anchor point="V_CENTER" />
				<Size><AbsDimension x="80" y="80" /></Size>
			</Area>
			<Scripts><OnClick>return function(this) CycleCustomizationProperty(this:GetParent().userData, false); CustomizationPropertyButton_UpdateValue(this:GetParent()); end</OnClick></Scripts>
		</Frame>
		<Frame inherits="GlueIconButton" name="NextButton">
			<Property name="Icon" value="Interface/GlueUI/Art/ChevronRight.htex" />
			<Area>
				<Anchor point="RIGHT" offset="-8" />
				<Anchor point="V_CENTER" />
				<Size><AbsDimension x="80" y="80" /></Size>
			</Area>
			<Scripts><OnClick>return function(this) CycleCustomizationProperty(this:GetParent().userData, true); CustomizationPropertyButton_UpdateValue(this:GetParent()); end</OnClick></Scripts>
		</Frame>
		<Frame inherits="GlueTextSmall" name="Label">
			<Property name="HorzAlign" value="CENTER" />
			<Property name="VertAlign" value="CENTER" />
			<Area>
				<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="PrevButton" offset="8" />
				<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="NextButton" offset="-8" />
				<Anchor point="TOP" />
				<Anchor point="BOTTOM" />
			</Area>
		</Frame>
	</Frame>

	<Frame name="CharCreate" parent="GlueParent" setAllPoints="true">
		<Property name="Visible" value="false" />
		<Animations>
			<Animation name="BackgroundZoomIn" duration="1.6" loop="false">
				<Track property="Width" target="CharCreateBackdrop"><Keyframe time="0" value="3840" /><Keyframe time="0.1" value="4696" /><Keyframe time="0.2" value="5330" /><Keyframe time="0.3" value="5800" /><Keyframe time="0.4" value="6147" /><Keyframe time="0.5" value="6405" /><Keyframe time="0.65" value="6672" /><Keyframe time="0.8" value="6842" /><Keyframe time="1" value="6978" /><Keyframe time="1.25" value="7064" /><Keyframe time="1.6" value="7142" /></Track>
				<Track property="Height" target="CharCreateBackdrop"><Keyframe time="0" value="2160" /><Keyframe time="0.1" value="2642" /><Keyframe time="0.2" value="2998" /><Keyframe time="0.3" value="3263" /><Keyframe time="0.4" value="3458" /><Keyframe time="0.5" value="3603" /><Keyframe time="0.65" value="3754" /><Keyframe time="0.8" value="3849" /><Keyframe time="1" value="3925" /><Keyframe time="1.25" value="3974" /><Keyframe time="1.6" value="4018" /></Track>
				<Track property="PositionX" target="CharCreateBackdrop"><Keyframe time="0" value="0" /><Keyframe time="0.1" value="-428" /><Keyframe time="0.2" value="-745" /><Keyframe time="0.3" value="-980" /><Keyframe time="0.4" value="-1154" /><Keyframe time="0.5" value="-1283" /><Keyframe time="0.65" value="-1416" /><Keyframe time="0.8" value="-1501" /><Keyframe time="1" value="-1569" /><Keyframe time="1.25" value="-1612" /><Keyframe time="1.6" value="-1651" /></Track>
				<Track property="PositionY" target="CharCreateBackdrop"><Keyframe time="0" value="0" /><Keyframe time="0.1" value="-201" /><Keyframe time="0.2" value="-349" /><Keyframe time="0.3" value="-459" /><Keyframe time="0.4" value="-541" /><Keyframe time="0.5" value="-601" /><Keyframe time="0.65" value="-664" /><Keyframe time="0.8" value="-704" /><Keyframe time="1" value="-735" /><Keyframe time="1.25" value="-756" /><Keyframe time="1.6" value="-774" /></Track>
			</Animation>
			<Animation name="BackgroundZoomOut" duration="1.6" loop="false">
				<Track property="Width" target="CharCreateBackdrop"><Keyframe time="0" value="7142" /><Keyframe time="0.1" value="6286" /><Keyframe time="0.2" value="5652" /><Keyframe time="0.3" value="5182" /><Keyframe time="0.4" value="4835" /><Keyframe time="0.5" value="4577" /><Keyframe time="0.65" value="4310" /><Keyframe time="0.8" value="4140" /><Keyframe time="1" value="4004" /><Keyframe time="1.25" value="3918" /><Keyframe time="1.6" value="3840" /></Track>
				<Track property="Height" target="CharCreateBackdrop"><Keyframe time="0" value="4018" /><Keyframe time="0.1" value="3536" /><Keyframe time="0.2" value="3180" /><Keyframe time="0.3" value="2915" /><Keyframe time="0.4" value="2720" /><Keyframe time="0.5" value="2575" /><Keyframe time="0.65" value="2424" /><Keyframe time="0.8" value="2329" /><Keyframe time="1" value="2253" /><Keyframe time="1.25" value="2204" /><Keyframe time="1.6" value="2160" /></Track>
				<Track property="PositionX" target="CharCreateBackdrop"><Keyframe time="0" value="-1651" /><Keyframe time="0.1" value="-1223" /><Keyframe time="0.2" value="-906" /><Keyframe time="0.3" value="-671" /><Keyframe time="0.4" value="-497" /><Keyframe time="0.5" value="-368" /><Keyframe time="0.65" value="-235" /><Keyframe time="0.8" value="-150" /><Keyframe time="1" value="-82" /><Keyframe time="1.25" value="-39" /><Keyframe time="1.6" value="0" /></Track>
				<Track property="PositionY" target="CharCreateBackdrop"><Keyframe time="0" value="-774" /><Keyframe time="0.1" value="-573" /><Keyframe time="0.2" value="-425" /><Keyframe time="0.3" value="-315" /><Keyframe time="0.4" value="-233" /><Keyframe time="0.5" value="-173" /><Keyframe time="0.65" value="-110" /><Keyframe time="0.8" value="-70" /><Keyframe time="1" value="-39" /><Keyframe time="1.25" value="-18" /><Keyframe time="1.6" value="0" /></Track>
			</Animation>
		</Animations>

		<Frame name="CharCreateBackdrop" renderer="DefaultRenderer">
			<Property name="Clickable" value="false" />
			<Area><Position><AbsDimension x="0" y="0" /></Position><Size><AbsDimension x="3840" y="2160" /></Size></Area>
			<Visual>
				<ImagerySection name="Art"><ImageComponent texture="Interface/GlueUI/BackgroundPH.htex" tint="FF9DA3AA" /></ImagerySection>
				<StateImagery name="Enabled"><Layer><Section section="Art" /></Layer></StateImagery>
			</Visual>
		</Frame>

		<Frame name="CharCreateVeil" inherits="GlueVeilLeft">
			<Property name="FillColor" value="D9070A0D" />
			<Area><Anchor point="LEFT" /><Anchor point="TOP" /><Anchor point="BOTTOM" /><Size><AbsDimension x="2200" /></Size></Area>
		</Frame>

		<Frame name="CharCreateGlow" inherits="GlueGlow">
			<Property name="FillColor" value="2EF2D3A0" />
			<Area>
				<Anchor point="H_CENTER" offset="560" />
				<Anchor point="BOTTOM" offset="-200" />
				<Size><AbsDimension x="1800" y="1500" /></Size>
			</Area>
		</Frame>

		<Frame name="CharCreateModel" type="Model" renderer="ModelRenderer">
			<Property name="Yaw" value="-120" />
			<Property name="Animation" value="Idle" />
			<Property name="Zoom" value="5.0" />
			<Property name="OffsetY" value="1.00" />
			<Area>
				<Anchor point="LEFT" offset="1360" />
				<Anchor point="RIGHT" offset="-120" />
				<Anchor point="TOP" offset="80" />
				<Anchor point="BOTTOM" offset="-80" />
			</Area>
		</Frame>

		<!-- The step panel. Content keeps 72 UI from its edge (1096 wide). -->
		<Frame name="CharCreatePanel" inherits="GluePanel">
			<Area>
				<Anchor point="LEFT" offset="120" />
				<Anchor point="TOP" offset="120" />
				<Anchor point="BOTTOM" offset="-120" />
				<Size><AbsDimension x="1240" /></Size>
			</Area>

			<Frame name="CharCreateStepCaption" inherits="GlueCaption">
				<Area><Anchor point="LEFT" offset="72" /><Anchor point="RIGHT" offset="-72" /><Anchor point="TOP" offset="72" /></Area>
			</Frame>
			<Frame name="CharCreateSelectionTitle" inherits="GlueTitle">
				<Area><Anchor point="LEFT" offset="72" /><Anchor point="RIGHT" offset="-72" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreateStepCaption" offset="24" /></Area>
			</Frame>

			<!-- Progress: one bar per step, gold up to the current one. -->
			<Frame name="CharCreateStep1Bar" inherits="GlueFill">
				<Property name="FillColor" value="FFE3C78F" />
				<Area>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="RIGHT" relativePoint="H_CENTER" offset="-8" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreateSelectionTitle" offset="24" />
					<Size><AbsDimension y="4" /></Size>
				</Area>
			</Frame>
			<Frame name="CharCreateStep2Bar" inherits="GlueFill">
				<Property name="FillColor" value="33D7C29A" />
				<Area>
					<Anchor point="LEFT" relativePoint="H_CENTER" offset="8" />
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreateSelectionTitle" offset="24" />
					<Size><AbsDimension y="4" /></Size>
				</Area>
			</Frame>

			<!-- Step 1: origin. CharCreate.lua fills the race and class lists and sizes the sections. -->
			<Frame name="CharCreatePage1">
				<Area>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreateStep1Bar" offset="64" />
					<Anchor point="BOTTOM" offset="-72" />
				</Area>

				<Frame name="CharRaceSection">
					<Area><Anchor point="TOP" /><Anchor point="LEFT" /><Anchor point="RIGHT" /><Size><AbsDimension y="168" /></Size></Area>
					<Frame name="CharRaceLabel" inherits="GlueCaption">
						<Property name="Text" value="RACE" /><Property name="TextColor" value="FF9AA1A6" />
						<Area><Anchor point="TOP" /><Anchor point="LEFT" /><Anchor point="RIGHT" /></Area>
					</Frame>
					<Frame name="CharRaceList">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" offset="60" /><Anchor point="BOTTOM" /></Area>
					</Frame>
				</Frame>

				<Frame name="CharClassSection">
					<Area><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharRaceSection" offset="48" /><Anchor point="LEFT" /><Anchor point="RIGHT" /><Size><AbsDimension y="520" /></Size></Area>
					<Frame name="CharClassLabel" inherits="GlueCaption">
						<Property name="Text" value="STARTING_CLASS" /><Property name="TextColor" value="FF9AA1A6" />
						<Area><Anchor point="TOP" /><Anchor point="LEFT" /><Anchor point="RIGHT" /></Area>
					</Frame>
					<Frame name="CharClassList">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" offset="60" /><Anchor point="BOTTOM" /></Area>
					</Frame>
				</Frame>

				<Frame name="CharGenderSection">
					<Area><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharClassSection" offset="48" /><Anchor point="LEFT" /><Anchor point="RIGHT" /><Size><AbsDimension y="168" /></Size></Area>
					<Frame name="CharGenderLabel" inherits="GlueCaption">
						<Property name="Text" value="GENDER" /><Property name="TextColor" value="FF9AA1A6" />
						<Area><Anchor point="TOP" /><Anchor point="LEFT" /><Anchor point="RIGHT" /></Area>
					</Frame>
					<Frame name="CharGenderList">
						<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" offset="60" /><Anchor point="BOTTOM" /></Area>
						<Frame name="GenderMaleButton" inherits="ListCheckButtonBase" id="0">
							<Property name="Text" value="MALE" /><Property name="Checked" value="true" />
							<Area><Anchor point="LEFT" /><Anchor point="TOP" /></Area>
							<Scripts><OnClick>return function(this) OnGenderChange_Clicked(this); end</OnClick></Scripts>
						</Frame>
						<Frame name="GenderFemaleButton" inherits="ListCheckButtonBase" id="1">
							<Property name="Text" value="FEMALE" />
							<Area><Anchor point="RIGHT" /><Anchor point="TOP" /></Area>
							<Scripts><OnClick>return function(this) OnGenderChange_Clicked(this); end</OnClick></Scripts>
						</Frame>
					</Frame>
				</Frame>

				<Frame name="CancelCharCreationButton" inherits="GlueButton">
					<Property name="Text" value="CANCEL" />
					<Area><Anchor point="LEFT" /><Anchor point="BOTTOM" /><Size><AbsDimension x="400" y="136" /></Size></Area>
					<Scripts><OnClick>return function(this) CharSelect_Cancel(); end</OnClick></Scripts>
				</Frame>
				<Frame name="CharCreatePage1NextButton" inherits="GlueButtonPrimary">
					<Property name="Text" value="CUSTOMIZE" />
					<Area>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="CancelCharCreationButton" offset="24" />
						<Anchor point="RIGHT" />
						<Anchor point="BOTTOM" />
						<Size><AbsDimension y="136" /></Size>
					</Area>
					<Scripts><OnClick>return function(this) CharCreate_ShowCustomizationPage(); end</OnClick></Scripts>
				</Frame>
			</Frame>

			<!-- Step 2: appearance and name. -->
			<Frame name="CharCreatePage2">
				<Property name="Visible" value="false" />
				<Area>
					<Anchor point="LEFT" offset="72" />
					<Anchor point="RIGHT" offset="-72" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreateStep1Bar" offset="64" />
					<Anchor point="BOTTOM" offset="-72" />
				</Area>

				<Frame name="CharCreatePropertiesLabel" inherits="GlueCaption">
					<Property name="Text" value="CUSTOMIZATION" /><Property name="TextColor" value="FF9AA1A6" />
					<Area><Anchor point="TOP" /><Anchor point="LEFT" /><Anchor point="RIGHT" /></Area>
				</Frame>
				<Frame name="CharCreatePropertyList">
					<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreatePropertiesLabel" offset="12" /><Size><AbsDimension y="560" /></Size></Area>
				</Frame>

				<Frame name="CharCreateShowOutfitButton" inherits="GlueCheckbox">
					<Property name="Checked" value="true" />
					<Area><Anchor point="LEFT" offset="8" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCreatePropertyList" offset="36" /></Area>
					<Scripts><OnClick>return function(this) CharCreate_ToggleOutfit(this); end</OnClick></Scripts>
				</Frame>
				<Frame name="CharCreateShowOutfitLabel" inherits="GlueTextSmall">
					<Property name="Text" value="SHOW_OUTFIT" />
					<Property name="VertAlign" value="CENTER" />
					<Property name="TextColor" value="FFB8B1A3" />
					<Area>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="CharCreateShowOutfitButton" offset="20" />
						<Anchor point="RIGHT" />
						<Anchor point="V_CENTER" relativePoint="V_CENTER" relativeTo="CharCreateShowOutfitButton" />
						<Size><AbsDimension y="48" /></Size>
					</Area>
				</Frame>

				<Frame name="CharCreationPage2BackButton" inherits="GlueButton">
					<Property name="Text" value="BACK" />
					<Area><Anchor point="LEFT" /><Anchor point="BOTTOM" /><Size><AbsDimension x="400" y="136" /></Size></Area>
					<Scripts><OnClick>return function(this) CharCreate_ShowSelectionPage(); end</OnClick></Scripts>
				</Frame>
				<Frame name="CharCreateSubmitButton" inherits="GlueButtonPrimary">
					<Property name="Text" value="CREATE_CHARACTER" />
					<Area>
						<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="CharCreationPage2BackButton" offset="24" />
						<Anchor point="RIGHT" />
						<Anchor point="BOTTOM" />
						<Size><AbsDimension y="136" /></Size>
					</Area>
					<Scripts><OnClick>return function(this) CharCreate_Submit(); end</OnClick></Scripts>
				</Frame>

				<Frame name="NewCharacterNameBox" inherits="GlueTextField">
					<Area>
						<Anchor point="LEFT" />
						<Anchor point="RIGHT" />
						<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="CharCreationPage2BackButton" offset="-64" />
					</Area>
					<Scripts>
						<OnEnterPressed>return function(this) CharCreate_Submit(); end</OnEnterPressed>
					</Scripts>
				</Frame>
				<Frame name="CharacterNameLabel" inherits="GlueCaption">
					<Property name="Text" value="NAME" /><Property name="TextColor" value="FF9AA1A6" />
					<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="BOTTOM" relativePoint="TOP" relativeTo="NewCharacterNameBox" offset="-12" /></Area>
				</Frame>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>return function(this) CharCreate_OnLoad(this); end</OnLoad>
		</Scripts>
	</Frame>
</UiLayout>
