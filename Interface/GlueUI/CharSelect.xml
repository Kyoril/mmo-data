<!-- Character selection: the selected character stands in the hall, its name large above it. Every
     character is a card in the strip along the bottom (plus a "new character" card); the brass Enter
     World button sits to the right of the strip. Drag a card to reorder, drag the hall to turn. -->
<UiLayout xmlns="http://mmo-dev.net/ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://mmo-dev.net/ui UI.xsd">
	<Script file="CharSelect.lua" />

	<!-- Character card. Checked = selected. Children (CharSelect.lua contract):
	     0 = class glyph (Icon), 1 = name, 2 = level and class. -->
	<Frame name="CharCardTemplate" type="Button" renderer="CheckboxRenderer">
		<Property name="Checkable" value="true" />
		<Property name="Font" value="DefaultHeader" />
		<Visual>
			<ImagerySection name="Rest">
				<BorderComponent texture="Interface/GlueUI/Art/PanelFill.htex" borderSize="24" leftSize="28" rightSize="28" topSize="28" bottomSize="28" tint="CC0E1217" />
				<BorderComponent texture="Interface/GlueUI/Art/PanelLine.htex" borderSize="24" leftSize="28" rightSize="28" topSize="28" bottomSize="28" tint="40D7C29A" />
			</ImagerySection>
			<ImagerySection name="Hover">
				<BorderComponent texture="Interface/GlueUI/Art/PanelFill.htex" borderSize="24" leftSize="28" rightSize="28" topSize="28" bottomSize="28" tint="E6181E25" />
				<BorderComponent texture="Interface/GlueUI/Art/PanelLine.htex" borderSize="24" leftSize="28" rightSize="28" topSize="28" bottomSize="28" tint="99E3C78F" />
			</ImagerySection>
			<ImagerySection name="Chosen">
				<ImageComponent texture="Interface/GlueUI/Art/Glow.htex" tint="33E3C78F"><Area><Inset left="-60" right="-60" top="-40" bottom="-80" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/Art/PanelFill.htex" borderSize="24" leftSize="28" rightSize="28" topSize="28" bottomSize="28" tint="F2221E17" />
				<BorderComponent texture="Interface/GlueUI/Art/PanelLine.htex" borderSize="24" leftSize="28" rightSize="28" topSize="28" bottomSize="28" tint="FFE3C78F" />
				<ImageComponent texture="Interface/GlueUI/Art/FadeV.htex" tint="40E3C78F"><Area><Inset left="4" right="4" top="110" bottom="4" /></Area></ImageComponent>
			</ImagerySection>
			<StateImagery name="Normal"><Layer><Section section="Rest" /></Layer></StateImagery>
			<StateImagery name="Hovered"><Layer><Section section="Hover" /></Layer></StateImagery>
			<StateImagery name="Pushed"><Layer><Section section="Hover" /></Layer></StateImagery>
			<StateImagery name="Disabled"><Layer><Section section="Rest" color="80FFFFFF" /></Layer></StateImagery>
			<StateImagery name="NormalChecked"><Layer><Section section="Chosen" /></Layer></StateImagery>
			<StateImagery name="HoveredChecked"><Layer><Section section="Chosen" /></Layer></StateImagery>
			<StateImagery name="PushedChecked"><Layer><Section section="Chosen" /></Layer></StateImagery>
			<StateImagery name="DisabledChecked"><Layer><Section section="Chosen" color="80FFFFFF" /></Layer></StateImagery>
		</Visual>
		<Area><Size><AbsDimension x="360" y="232" /></Size></Area>

		<Frame name="CharCardGlyph" renderer="DefaultRenderer">
			<Property name="Clickable" value="false" />
			<Property name="MousePassThrough" value="true" />
			<Property name="Icon" />
			<Property name="GlyphColor" value="FFD9CDB4" />
			<Visual>
				<ImagerySection name="Glyph"><ImageComponent tint="$GlyphColor"><PropertyValue property="Icon" /></ImageComponent></ImagerySection>
				<StateImagery name="Enabled"><Layer><Section section="Glyph" /></Layer></StateImagery>
				<StateImagery name="Disabled"><Layer><Section section="Glyph" color="80FFFFFF" /></Layer></StateImagery>
			</Visual>
			<Area>
				<Anchor point="H_CENTER" />
				<Anchor point="TOP" offset="30" />
				<Size><AbsDimension x="76" y="76" /></Size>
			</Area>
		</Frame>
		<Frame name="CharCardName" inherits="GlueTextLarge">
			<Property name="VertAlign" value="CENTER" />
			<Area>
				<Anchor point="LEFT" offset="16" />
				<Anchor point="RIGHT" offset="-16" />
				<Anchor point="TOP" offset="118" />
				<Size><AbsDimension y="56" /></Size>
			</Area>
		</Frame>
		<Frame name="CharCardInfo" inherits="GlueNote">
			<Property name="HorzAlign" value="CENTER" />
			<Area>
				<Anchor point="LEFT" offset="16" />
				<Anchor point="RIGHT" offset="-16" />
				<Anchor point="TOP" offset="172" />
			</Area>
		</Frame>
	</Frame>

	<Frame name="CharSelect" parent="GlueParent" setAllPoints="true">
		<Property name="Visible" value="false" />

		<!-- Warm light pooling behind the character. -->
		<Frame name="CharSelectGlow" inherits="GlueGlow">
			<Property name="FillColor" value="33F2D3A0" />
			<Area>
				<Anchor point="H_CENTER" />
				<Anchor point="BOTTOM" offset="-300" />
				<Size><AbsDimension x="1800" y="1500" /></Size>
			</Area>
		</Frame>

		<Frame name="CharSelectPreview" type="CharacterPreview">
			<Property name="Visible" value="false" />
			<Property name="MousePassThrough" value="true" />
			<Property name="Yaw" value="-120" />
			<Property name="Animation" value="Idle" />
			<Property name="Zoom" value="4.0" />
			<Property name="OffsetY" value="1.0" />
			<Area>
				<Anchor point="H_CENTER" />
				<Anchor point="TOP" offset="380" />
				<Anchor point="BOTTOM" offset="-380" />
				<Size><AbsDimension x="1500" /></Size>
			</Area>
		</Frame>

		<!-- Everything clickable. Not clickable itself, so a drag on empty space reaches CharSelect. -->
		<Frame name="CharSelectChrome" setAllPoints="true">
			<Property name="Clickable" value="false" />

			<Frame name="CharSelectTopVeil" inherits="GlueVeilTop">
				<Property name="FillColor" value="CC070A0D" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" /><Size><AbsDimension y="560" /></Size></Area>
			</Frame>
			<Frame name="CharSelectBottomBar" inherits="GlueVeilBottom">
				<Property name="FillColor" value="F2070A0D" />
				<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="BOTTOM" /><Size><AbsDimension y="760" /></Size></Area>
			</Frame>

			<!-- Header: realm, the selected character's name, and its level, class and location. -->
			<Frame name="CharSelectHeader">
				<Property name="Clickable" value="false" />
				<Area>
					<Anchor point="H_CENTER" />
					<Anchor point="TOP" offset="96" />
					<Size><AbsDimension x="2400" y="300" /></Size>
				</Area>
				<Frame name="RealmNameLabel" inherits="GlueCaption">
					<Property name="HorzAlign" value="CENTER" />
					<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" /></Area>
				</Frame>
				<Frame name="CharSelectSpotlight" inherits="GlueHero">
					<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmNameLabel" offset="36" /></Area>
				</Frame>
				<Frame name="CharSelectDetails" inherits="GlueTextSmall">
					<Property name="HorzAlign" value="CENTER" />
					<Property name="TextColor" value="FFB8B1A3" />
					<Area><Anchor point="LEFT" /><Anchor point="RIGHT" /><Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharSelectSpotlight" offset="2" /></Area>
				</Frame>
			</Frame>

			<!-- Top corners: back to the realms on the left, quit on the right. -->
			<Frame name="ChangeRealmButton" inherits="GlueLinkButton">
				<Property name="Text" value="CHANGE_REALM" />
				<Area><Anchor point="LEFT" offset="120" /><Anchor point="TOP" offset="72" /></Area>
				<Scripts><OnClick>return function(this) CharSelect_ChangeRealm(); end</OnClick></Scripts>
			</Frame>
			<Frame name="CharSelectQuitButton" inherits="GlueLinkButton">
				<Property name="Text" value="QUIT" />
				<Area><Anchor point="RIGHT" offset="-120" /><Anchor point="TOP" offset="72" /></Area>
				<Scripts><OnClick>return function(this) RunConsoleCommand("quit"); end</OnClick></Scripts>
			</Frame>

			<!-- The card strip. CharSelect.lua sizes it to the visible cards and places them. -->
			<Frame name="CharCardStrip">
				<Property name="Clickable" value="false" />
				<Area>
					<Anchor point="H_CENTER" offset="-260" />
					<Anchor point="BOTTOM" offset="-120" />
					<Size><AbsDimension x="2400" y="232" /></Size>
				</Area>
				<Frame name="CharCard1" inherits="CharCardTemplate" />
				<Frame name="CharCard2" inherits="CharCardTemplate" />
				<Frame name="CharCard3" inherits="CharCardTemplate" />
				<Frame name="CharCard4" inherits="CharCardTemplate" />
				<Frame name="CharCard5" inherits="CharCardTemplate" />
			</Frame>

			<Frame name="CharCardPrevButton" inherits="GlueIconButton">
				<Property name="Icon" value="Interface/GlueUI/Art/ChevronLeft.htex" />
				<Property name="Visible" value="false" />
				<Area><Anchor point="RIGHT" relativePoint="LEFT" relativeTo="CharCardStrip" offset="-28" /><Anchor point="V_CENTER" relativePoint="V_CENTER" relativeTo="CharCardStrip" /></Area>
				<Scripts><OnClick>return function(this) CharSelect_Page(-1); end</OnClick></Scripts>
			</Frame>
			<Frame name="CharCardNextButton" inherits="GlueIconButton">
				<Property name="Icon" value="Interface/GlueUI/Art/ChevronRight.htex" />
				<Property name="Visible" value="false" />
				<Area><Anchor point="LEFT" relativePoint="RIGHT" relativeTo="CharCardStrip" offset="28" /><Anchor point="V_CENTER" relativePoint="V_CENTER" relativeTo="CharCardStrip" /></Area>
				<Scripts><OnClick>return function(this) CharSelect_Page(1); end</OnClick></Scripts>
			</Frame>

			<Frame name="CharRosterHint" inherits="GlueNote">
				<Property name="Text" value="DRAG_TO_REORDER" />
				<Property name="HorzAlign" value="CENTER" />
				<Property name="TextColor" value="FF6F767C" />
				<Area>
					<Anchor point="H_CENTER" relativePoint="H_CENTER" relativeTo="CharCardStrip" />
					<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCardStrip" offset="28" />
					<Size><AbsDimension x="1200" y="38" /></Size>
				</Area>
			</Frame>

			<Frame name="CharSelectEnterButton" inherits="GlueButtonPrimary">
				<Property name="Text" value="ENTER_WORLD" />
				<Property name="Enabled" value="False" />
				<Area>
					<Anchor point="RIGHT" offset="-120" />
					<Anchor point="BOTTOM" offset="-120" />
					<Size><AbsDimension x="600" y="232" /></Size>
				</Area>
				<Scripts><OnClick>return function(this) CharSelect_EnterWorld(); end</OnClick></Scripts>
			</Frame>

			<Frame name="CharDeleteButton" inherits="GlueLinkButton">
				<Property name="Text" value="DELETE_CHARACTER" />
				<Property name="Enabled" value="False" />
				<Area><Anchor point="LEFT" offset="120" /><Anchor point="BOTTOM" offset="-56" /></Area>
				<Scripts><OnClick>return function(this) CharSelect_DeleteCharacter(); end</OnClick></Scripts>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>return function(this) CharSelect_OnLoad(this); end</OnLoad>
			<OnUpdate>return function(this, elapsed) CharSelect_OnUpdate(this, elapsed); end</OnUpdate>
			<OnHide>return function(this) CharSelect_OnHide(this); end</OnHide>
		</Scripts>
	</Frame>
</UiLayout>
