<?xml version="1.0"?>
<UiLayout xmlns="http://mmo-dev.net/ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://mmo-dev.net/ui UI.xsd">
	<Script file="CharSelect.lua" />

	<!-- Virtual character button -->
	<Frame name="CharButton" type="Button" renderer="CheckboxRenderer">
		<Property name="Font" value="DefaultHeader" />
		<Property name="Checkable" value="true" />

		<Visual>
			<ImagerySection name="FrameNormal">
				<ImageComponent texture="Interface/GlueUI/CharSelectButtonBackground.htex" />
			</ImagerySection>
			<ImagerySection name="FrameHovered">
				<ImageComponent texture="Interface/GlueUI/CharSelectButtonHighlight.htex" tint="FFFF9B38" />
			</ImagerySection>
			<ImagerySection name="FramePushed">
				<ImageComponent texture="Interface/GlueUI/CharSelectButtonHighlight.htex" tint="FF9E5E22">
					<Area>
						<Inset left="16" top="16" />
					</Area>
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="FrameDisabled">
				<ImageComponent texture="Interface/GlueUI/CharSelectButtonBackground.htex" tint="88404040" />
			</ImagerySection>

			<ImagerySection name="FrameNormalChecked">
				<ImageComponent texture="Interface/GlueUI/CharSelectButtonHighlight.htex" tint="FF033F08" />
			</ImagerySection>
			<ImagerySection name="FramePushedChecked">
				<ImageComponent texture="Interface/GlueUI/CharSelectButtonHighlight.htex" tint="FF033F08">
					<Area>
						<Inset left="16" top="16" />
					</Area>
				</ImageComponent>
			</ImagerySection>
			<ImagerySection name="Text">
				<TextComponent color="FFEED37C" horzAlign="LEFT" vertAlign="TOP">
					<Area>
						<Inset left="8" top="8" />
					</Area>
				</TextComponent>
			</ImagerySection>
			<ImagerySection name="TextDisabled">
				<TextComponent color="88404040" horzAlign="LEFT" vertAlign="TOP">
					<Area>
						<Inset left="8" top="8" />
					</Area>
				</TextComponent>
			</ImagerySection>

			<StateImagery name="Normal">
				<Layer>
					<Section section="FrameNormal" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="FrameHovered" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="FramePushed" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="FrameDisabled" />
					<Section section="TextDisabled" />
				</Layer>
			</StateImagery>
			
			<StateImagery name="NormalChecked">
				<Layer>
					<Section section="FrameNormalChecked" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="HoveredChecked">
				<Layer>
					<Section section="FrameNormalChecked" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="PushedChecked">
				<Layer>
					<Section section="FramePushedChecked" />
					<Section section="Text" />
				</Layer>
			</StateImagery>
			<StateImagery name="DisabledChecked">
				<Layer>
					<Section section="FrameDisabled" />
					<Section section="TextDisabled" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension x="128" y="128" /></Size>
		</Area>

		<Frame name="CharSubtext" renderer="DefaultRenderer">
			<Property name="Font" value="DefaultSmall" />
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			
			<Visual>
				<ImagerySection name="Text">
					<TextComponent color="FF808080" horzAlign="LEFT" vertAlign="TOP">
						<Area>
							<Inset left="8" top="8" />
						</Area>
					</TextComponent>
				</ImagerySection>
				<ImagerySection name="TextDisabled">
					<TextComponent color="FF808080" horzAlign="LEFT" vertAlign="TOP">
						<Area>
							<Inset left="8" top="8" />
						</Area>
					</TextComponent>
				</ImagerySection>

				<StateImagery name="Enabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="TextDisabled" />
					</Layer>
				</StateImagery>
			</Visual>

			<Area>
				<Anchor point="TOP" offset="64" />
				<Anchor point="LEFT" offset="8" />
				<Anchor point="RIGHT" offset="-8" />
				<Size><AbsDimension x="128" y="128" /></Size>
			</Area>
		</Frame>

		<!-- "On the plaza" marker of the first five rows, top right. -->
		<Frame name="CharPlazaMark" inherits="GlueTextSmall">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="HorzAlign" value="RIGHT" />
			<Property name="TextColor" value="FFA0A0A0" />
			<Area>
				<Anchor point="TOP" offset="16" />
				<Anchor point="RIGHT" offset="-24" />
				<Size><AbsDimension x="400" y="44" /></Size>
			</Area>
		</Frame>
	</Frame>

	<!-- Virtual nameplate over a character on the plaza: name, "Level N Class" and, for the front
	     character, the zone. Its bottom centre is placed over the character's head every frame.
	     The lines are stacked by offsets from the bottom: anchors between template children would
	     resolve to the template's own children, not the copy's. -->
	<Frame name="CharNameplateTemplate">
		<Property name="Visible" value="false" />
		<Property name="MousePassThrough" value="true" />
		<Area>
			<Size><AbsDimension x="1200" y="160" /></Size>
		</Area>

		<Frame name="CharNameplateZone" inherits="GlueTextSmall">
			<Property name="HorzAlign" value="CENTER" />
			<Property name="TextColor" value="FFA0A0A0" />
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" />
			</Area>
		</Frame>
		<Frame name="CharNameplateLevel" inherits="GlueTextSmall">
			<Property name="HorzAlign" value="CENTER" />
			<Property name="TextColor" value="FFE0E0E0" />
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" offset="-48" />
			</Area>
		</Frame>
		<Frame name="CharNameplateName" inherits="GlueTextLarge">
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" offset="-96" />
			</Area>
		</Frame>
	</Frame>

	<!-- The character screen: minimal chrome over the glue scene's plaza. Covers the whole screen;
	     a drag on empty space turns the front character (CharSelect.lua). -->
	<Frame name="CharSelect" parent="GlueParent" setAllPoints="true">
		<Property name="Visible" value="false" />

		<!-- Nameplates of the five plaza characters (1-5, by order index) and of a selected visitor (6). -->
		<Frame name="CharSelectNameplates" setAllPoints="true">
			<Property name="MousePassThrough" value="true" />

			<Frame name="CharNameplate1" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate2" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate3" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate4" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate5" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate6" inherits="CharNameplateTemplate" />
		</Frame>

		<!-- Everything clickable. Not clickable itself, so a click on empty space reaches CharSelect. -->
		<Frame name="CharSelectChrome" setAllPoints="true">
			<Property name="Clickable" value="false" />

			<!-- "New character" markers at empty plaza spots (fewer than five characters). -->
			<Frame name="NewCharMarker1" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker2" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker3" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker4" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker5" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>

			<!-- Bottom bar: a soft gradient behind the buttons. Not clickable, so drags on it still turn
			     the front character. -->
			<Frame name="CharSelectBottomBar" renderer="DefaultRenderer">
				<Property name="Clickable" value="false" />
				<Area>
					<Anchor point="LEFT"/>
					<Anchor point="RIGHT"/>
					<Anchor point="BOTTOM"/>
					<Size><AbsDimension y="400" /></Size>
				</Area>
				<Visual>
					<ImagerySection name="Background">
						<ImageComponent texture="Interface/GlueUI/GradientBlack.htex" tiling="HORZ" />
					</ImagerySection>
					<StateImagery name="Enabled">
						<Layer>
							<Section section="Background" />
						</Layer>
					</StateImagery>
				</Visual>
			</Frame>

			<Frame name="CharSelectEnterButton" inherits="GlueButtonPrimary">
				<Property name="Text" value="ENTER_WORLD" />
				<Property name="Enabled" value="False" />
				<Area>
					<Anchor point="BOTTOM" offset="-48" />
					<Anchor point="H_CENTER" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_EnterWorld();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- Past the login screen this is the only way out besides closing the window. -->
			<Frame name="CharSelectQuitButton" inherits="GlueButton">
				<Property name="Text" value="QUIT" />
				<Area>
					<Anchor point="LEFT" offset="48" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							RunConsoleCommand("quit");
						end
					</OnClick>
				</Scripts>
			</Frame>

			<Frame name="ChangeRealmButton" inherits="GlueButton">
				<Property name="Text" value="CHANGE_REALM" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="CharSelectQuitButton" offset="24" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_ChangeRealm();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- "All characters (N)": opens and closes the roster panel. The text is set from Lua. -->
			<Frame name="CharRosterButton" inherits="GlueButton">
				<Property name="Text" value="" />
				<Area>
					<Anchor point="RIGHT" offset="-48" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_ToggleRoster();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<Frame name="CharDeleteButton" inherits="GlueButton">
				<Property name="Text" value="DELETE_CHARACTER" />
				<Property name="Enabled" value="False" />
				<Area>
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="CharRosterButton" offset="-24" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_DeleteCharacter();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- Only shown with five or more characters; below that the plaza markers create characters. -->
			<Frame name="CharCreateButton" inherits="GlueButton">
				<Property name="Text" value="CREATE_CHARACTER" />
				<Property name="Visible" value="false" />
				<Area>
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="CharDeleteButton" offset="-24" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_CreateCharacter();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- Roster: every character, the first five marked as standing on the plaza. Rows are
			     cloned from CharButton by CharSelect.lua and reordered by dragging. -->
			<Frame name="CharRosterPanel" inherits="GlueBorderFrame">
				<Property name="Visible" value="false" />
				<Area>
					<Anchor point="TOP" offset="48" />
					<Anchor point="RIGHT" offset="-48" />
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="CharRosterButton" offset="-32" />
					<Size><AbsDimension x="960" /></Size>
				</Area>

				<Frame name="RealmNameLabel" inherits="GlueTextLarge">
					<Property name="Text" value="REALM" />
					<Area>
						<Anchor point="LEFT" offset="48" />
						<Anchor point="RIGHT" offset="-48" />
						<Anchor point="TOP" offset="48" />
					</Area>
				</Frame>
				<Frame name="CharCountLabel" inherits="GlueTextSmall">
					<Property name="Text" value="" />
					<Property name="HorzAlign" value="CENTER" />
					<Property name="TextColor" value="FFA0A0A0" />
					<Area>
						<Anchor point="LEFT" offset="48" />
						<Anchor point="RIGHT" offset="-48" />
						<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmNameLabel" offset="4" />
					</Area>
				</Frame>

				<Frame name="CharRosterList">
					<Area>
						<Anchor point="LEFT" offset="32" />
						<Anchor point="RIGHT" offset="-32" />
						<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCountLabel" offset="32" />
						<Anchor point="BOTTOM" offset="-112" />
					</Area>

					<!-- Divider before the characters that are not on the plaza; anchored below the fifth
					     row from Lua. -->
					<Frame name="CharRosterDivider" renderer="DefaultRenderer">
						<Property name="Visible" value="false" />
						<Property name="Clickable" value="false" />
						<Area>
							<Anchor point="LEFT" offset="16" />
							<Anchor point="RIGHT" offset="-16" />
							<Anchor point="TOP" />
							<Size><AbsDimension y="4" /></Size>
						</Area>
						<Visual>
							<ImagerySection name="Line">
								<ImageComponent texture="Textures/Character/T_EV_BlankWhite_01.htex" tint="60FFFFFF" />
							</ImagerySection>
							<StateImagery name="Enabled">
								<Layer>
									<Section section="Line" />
								</Layer>
							</StateImagery>
						</Visual>
					</Frame>
					<Frame name="CharRosterDividerLabel" inherits="GlueTextSmall">
						<Property name="Text" value="NOT_ON_THE_PLAZA" />
						<Property name="Visible" value="false" />
						<Property name="Clickable" value="false" />
						<Property name="HorzAlign" value="CENTER" />
						<Property name="TextColor" value="FFA0A0A0" />
						<Area>
							<Anchor point="LEFT" offset="16" />
							<Anchor point="RIGHT" offset="-16" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharRosterDivider" offset="8" />
						</Area>
					</Frame>
				</Frame>

				<Frame name="CharRosterHint" inherits="GlueTextSmall">
					<Property name="Text" value="DRAG_TO_REORDER" />
					<Property name="HorzAlign" value="CENTER" />
					<Property name="TextColor" value="FFA0A0A0" />
					<Area>
						<Anchor point="LEFT" offset="48" />
						<Anchor point="RIGHT" offset="-48" />
						<Anchor point="BOTTOM" offset="-48" />
					</Area>
				</Frame>
			</Frame>
		</Frame>

		<Frame name="DeleteConfirmation" setAllPoints="true">
			<Property name="Visible" value="false" />

			<Frame name="DeleteConfirmationFrame" inherits="GlueBorderFrame">
				<Area>
					<Anchor point="H_CENTER" />
					<Anchor point="V_CENTER" />
					<Size>
						<AbsDimension x="1320" y="480" />
					</Size>
				</Area>

				<Frame name="DeleteConfirmationHeader" inherits="GlueTextLarge">
					<Property name="Text" value="CONFIRM_CHAR_DELETE" />
					<Area>
						<Anchor point="LEFT" offset="48" />
						<Anchor point="RIGHT" offset="-48" />
						<Anchor point="TOP" offset="48" />
					</Area>
				</Frame>

				<Frame name="DeleteConfirmButton" inherits="GlueButton">
					<Property name="Text" value="DELETE" />

					<Area>
						<Anchor point="LEFT" offset="48" />
						<Anchor point="RIGHT" relativePoint="H_CENTER" offset="-24" />
						<Anchor point="BOTTOM" offset="-48" />
					</Area>

					<Scripts>
						<OnClick>
							return function(this)
								CharSelect_ConfirmDelete();
							end
						</OnClick>
					</Scripts>
				</Frame>

				<Frame name="DeleteCancelButton" inherits="GlueButton">
					<Property name="Text" value="CANCEL" />

					<Area>
						<Anchor point="LEFT" relativePoint="H_CENTER" offset="24" />
						<Anchor point="RIGHT" offset="-48" />
						<Anchor point="BOTTOM" offset="-48" />
					</Area>

					<Scripts>
						<OnClick>
							return function(this)
								CharSelect_CancelDelete();
							end
						</OnClick>
					</Scripts>
				</Frame>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					CharSelect_OnLoad(this);
				end
			</OnLoad>
			<OnUpdate>
				return function(this, elapsed)
					CharSelect_OnUpdate(this, elapsed);
				end
			</OnUpdate>
		</Scripts>
	</Frame>
</UiLayout>
