<?xml version="1.0"?>
<UiLayout xmlns="http://mmo-dev.net/ui" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://mmo-dev.net/ui UI.xsd">
	<Script file="CharSelect.lua" />

	<!-- Virtual roster row (cloned by CharSelect.lua). The same steel-framed card as the realm rows:
	     dark stone at rest, lifted stone on hover, the Checked steel-blue fill inside the bright
	     selected frame (ivory inner line) for the selected character. Frame 36 over a fill inset 14,
	     so text keeps 40 UI from the left and right edges and about 20 from the top and bottom.
	     Children are: 0 = level/class line, 1 = "on the plaza" marker. -->
	<Frame name="CharButton" type="Button" renderer="CheckboxRenderer">
		<Property name="Font" value="DefaultHeader" />
		<Property name="Checkable" value="true" />

		<Visual>
			<ImagerySection name="NormalSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinFieldFill.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="HoveredSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinRowHovered.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="PushedSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonPushed.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="DisabledSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinFieldFill.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" tint="FF8C8C8C" />
			</ImagerySection>
			<ImagerySection name="CheckedSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonChecked.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrameSelected.htex" borderSize="36" />
			</ImagerySection>
			<ImagerySection name="PushedCheckedSurface">
				<ImageComponent texture="Interface/GlueUI/GlueSkinButtonPushed.htex"><Area><Inset all="14" /></Area></ImageComponent>
				<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrameSelected.htex" borderSize="36" />
			</ImagerySection>
			<!-- The right inset leaves room for the "on the plaza" marker. -->
			<ImagerySection name="Name">
				<TextComponent color="FFF3EEE2" horzAlign="LEFT" vertAlign="TOP">
					<Area><Inset left="40" top="18" right="320" /></Area>
				</TextComponent>
			</ImagerySection>

			<StateImagery name="Normal">
				<Layer>
					<Section section="NormalSurface" />
					<Section section="Name" />
				</Layer>
			</StateImagery>
			<StateImagery name="Hovered">
				<Layer>
					<Section section="HoveredSurface" />
					<Section section="Name" color="FFFFFFFF" />
				</Layer>
			</StateImagery>
			<StateImagery name="Pushed">
				<Layer>
					<Section section="PushedSurface" />
					<Section section="Name" color="FFDDDDDD" />
				</Layer>
			</StateImagery>
			<StateImagery name="Disabled">
				<Layer>
					<Section section="DisabledSurface" />
					<Section section="Name" color="FF8A867E" />
				</Layer>
			</StateImagery>
			<StateImagery name="NormalChecked">
				<Layer>
					<Section section="CheckedSurface" />
					<Section section="Name" color="FFFFFFFF" />
				</Layer>
			</StateImagery>
			<StateImagery name="HoveredChecked">
				<Layer>
					<Section section="CheckedSurface" />
					<Section section="Name" color="FFFFFFFF" />
				</Layer>
			</StateImagery>
			<StateImagery name="PushedChecked">
				<Layer>
					<Section section="PushedCheckedSurface" />
					<Section section="Name" color="FFDDDDDD" />
				</Layer>
			</StateImagery>
			<StateImagery name="DisabledChecked">
				<Layer>
					<Section section="DisabledSurface" />
					<Section section="Name" color="FF8A867E" />
				</Layer>
			</StateImagery>
		</Visual>
		<Area>
			<Size><AbsDimension x="128" y="144" /></Size>
		</Area>

		<!-- Level and class, beneath the name. -->
		<Frame name="CharSubtext" renderer="DefaultRenderer">
			<Property name="Font" value="DefaultSmall" />
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />

			<Visual>
				<ImagerySection name="Text">
					<TextComponent color="FFBCC6BE" horzAlign="LEFT" vertAlign="CENTER" />
				</ImagerySection>

				<StateImagery name="Enabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Text" />
					</Layer>
				</StateImagery>
			</Visual>

			<Area>
				<Anchor point="LEFT" offset="40" />
				<Anchor point="RIGHT" offset="-40" />
				<Anchor point="BOTTOM" offset="-20" />
				<Size><AbsDimension y="44" /></Size>
			</Area>
		</Frame>

		<!-- "On the plaza" marker of the first five rows, top right, on the name's baseline. -->
		<Frame name="CharPlazaMark" inherits="GlueTextSmall">
			<Property name="Enabled" value="false" />
			<Property name="Clickable" value="false" />
			<Property name="HorzAlign" value="RIGHT" />
			<Property name="TextColor" value="FFB4C2D0" />
			<Area>
				<Anchor point="TOP" offset="30" />
				<Anchor point="RIGHT" offset="-40" />
				<Size><AbsDimension x="280" y="44" /></Size>
			</Area>
		</Frame>
	</Frame>

	<!-- Virtual nameplate over a character on the plaza: name, "Level N Class" and, for the selected
	     character, the zone. Its bottom centre is placed over the character's head every frame.
	     The lines are stacked by offsets from the bottom: anchors between template children would
	     resolve to the template's own children, not the copy's.
	     Children (CharSelect.lua uses the indices): 0 = hover backdrop, 1 = selected frame (the
	     roster's steel-blue selected card), 2 = zone, 3 = level/class, 4 = name, 5 = selected
	     underline. Both backdrops are sized to the text from Lua. -->
	<Frame name="CharNameplateTemplate">
		<Property name="Visible" value="false" />
		<Property name="MousePassThrough" value="true" />
		<Area>
			<Size><AbsDimension x="1200" y="160" /></Size>
		</Area>

		<!-- Hovered (not selected): a faint lifted-stone card behind the lines. -->
		<Frame name="CharNameplateHoverBackdrop" renderer="DefaultRenderer">
			<Property name="Visible" value="false" />
			<Property name="Clickable" value="false" />
			<Visual>
				<ImagerySection name="Card">
					<ImageComponent texture="Interface/GlueUI/GlueSkinRowHovered.htex" tint="80FFFFFF"><Area><Inset all="14" /></Area></ImageComponent>
					<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrame.htex" borderSize="36" tint="A0FFFFFF" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Card" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Card" />
					</Layer>
				</StateImagery>
			</Visual>
			<Area>
				<Anchor point="H_CENTER" />
				<Anchor point="TOP" offset="-24" />
				<Anchor point="BOTTOM" offset="24" />
				<Size><AbsDimension x="600" /></Size>
			</Area>
		</Frame>

		<!-- Selected: the roster's selected card, the steel-blue fill inside the bright frame. -->
		<Frame name="CharNameplateSelectedFrame" renderer="DefaultRenderer">
			<Property name="Visible" value="false" />
			<Property name="Clickable" value="false" />
			<Visual>
				<ImagerySection name="Card">
					<ImageComponent texture="Interface/GlueUI/GlueSkinButtonChecked.htex" tint="C0FFFFFF"><Area><Inset all="14" /></Area></ImageComponent>
					<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrameSelected.htex" borderSize="36" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Card" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Card" />
					</Layer>
				</StateImagery>
			</Visual>
			<Area>
				<Anchor point="H_CENTER" />
				<Anchor point="TOP" offset="-24" />
				<Anchor point="BOTTOM" offset="24" />
				<Size><AbsDimension x="600" /></Size>
			</Area>
		</Frame>

		<Frame name="CharNameplateZone" inherits="GlueTextSmall">
			<Property name="HorzAlign" value="CENTER" />
			<Property name="TextColor" value="FFA0A0A0" />
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" />
			</Area>
		</Frame>
		<Frame name="CharNameplateLevel" inherits="GlueTextSmall">
			<Property name="HorzAlign" value="CENTER" />
			<Property name="TextColor" value="FFE0E0E0" />
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" offset="-48" />
			</Area>
		</Frame>
		<!-- The headline font with a settable colour, so a hovered name can brighten. -->
		<Frame name="CharNameplateName" inherits="GlueTextSmall">
			<Property name="Font" value="DefaultHeader" />
			<Property name="HorzAlign" value="CENTER" />
			<Property name="TextColor" value="FFF3EEE2" />
			<Area>
				<Anchor point="LEFT" />
				<Anchor point="RIGHT" />
				<Anchor point="BOTTOM" offset="-96" />
				<Size><AbsDimension y="60" /></Size>
			</Area>
		</Frame>

		<!-- Selected: a short bright underline below the card. -->
		<Frame name="CharNameplateSelectedMark" renderer="DefaultRenderer">
			<Property name="Visible" value="false" />
			<Property name="Clickable" value="false" />
			<Area>
				<Anchor point="H_CENTER" />
				<Anchor point="TOP" relativePoint="BOTTOM" offset="40" />
				<Size><AbsDimension x="240" y="12" /></Size>
			</Area>
			<Visual>
				<ImagerySection name="Line">
					<BorderComponent texture="Interface/GlueUI/GlueSkinSteelFrameSelected.htex" leftSize="36" topSize="6" rightSize="36" bottomSize="494" />
				</ImagerySection>
				<StateImagery name="Enabled">
					<Layer>
						<Section section="Line" />
					</Layer>
				</StateImagery>
				<StateImagery name="Disabled">
					<Layer>
						<Section section="Line" />
					</Layer>
				</StateImagery>
			</Visual>
		</Frame>
	</Frame>

	<!-- The character screen: minimal chrome over the glue scene's plaza. Covers the whole screen;
	     a click on a character there selects it, a drag on empty space turns the selected character
	     (CharSelect.lua). -->
	<Frame name="CharSelect" parent="GlueParent" setAllPoints="true">
		<Property name="Visible" value="false" />

		<!-- Nameplates of the five plaza characters (1-5, by order index) and of a selected visitor (6). -->
		<Frame name="CharSelectNameplates" setAllPoints="true">
			<Property name="MousePassThrough" value="true" />

			<Frame name="CharNameplate1" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate2" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate3" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate4" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate5" inherits="CharNameplateTemplate" />
			<Frame name="CharNameplate6" inherits="CharNameplateTemplate" />
		</Frame>

		<!-- Everything clickable. Not clickable itself, so a click on empty space reaches CharSelect. -->
		<Frame name="CharSelectChrome" setAllPoints="true">
			<Property name="Clickable" value="false" />

			<!-- "New character" markers at empty plaza spots (fewer than five characters). -->
			<Frame name="NewCharMarker1" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker2" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker3" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker4" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>
			<Frame name="NewCharMarker5" inherits="GlueButton">
				<Property name="Text" value="NEW_CHARACTER_SPOT" />
				<Property name="Visible" value="false" />
				<Scripts><OnClick>return function(this) CharSelect_CreateCharacter(); end</OnClick></Scripts>
			</Frame>

			<!-- Bottom bar: a soft gradient behind the buttons. Not clickable, so drags on it still turn
			     the selected character. -->
			<Frame name="CharSelectBottomBar" renderer="DefaultRenderer">
				<Property name="Clickable" value="false" />
				<Area>
					<Anchor point="LEFT"/>
					<Anchor point="RIGHT"/>
					<Anchor point="BOTTOM"/>
					<Size><AbsDimension y="400" /></Size>
				</Area>
				<Visual>
					<ImagerySection name="Background">
						<ImageComponent texture="Interface/GlueUI/GradientBlack.htex" tiling="HORZ" />
					</ImagerySection>
					<StateImagery name="Enabled">
						<Layer>
							<Section section="Background" />
						</Layer>
					</StateImagery>
				</Visual>
			</Frame>

			<Frame name="CharSelectEnterButton" inherits="GlueButtonPrimary">
				<Property name="Text" value="ENTER_WORLD" />
				<Property name="Enabled" value="False" />
				<Area>
					<Anchor point="BOTTOM" offset="-48" />
					<Anchor point="H_CENTER" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_EnterWorld();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- Past the login screen this is the only way out besides closing the window. -->
			<Frame name="CharSelectQuitButton" inherits="GlueButton">
				<Property name="Text" value="QUIT" />
				<Area>
					<Anchor point="LEFT" offset="48" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							RunConsoleCommand("quit");
						end
					</OnClick>
				</Scripts>
			</Frame>

			<Frame name="ChangeRealmButton" inherits="GlueButton">
				<Property name="Text" value="CHANGE_REALM" />
				<Area>
					<Anchor point="LEFT" relativePoint="RIGHT" relativeTo="CharSelectQuitButton" offset="24" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_ChangeRealm();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- "All characters (N)": opens and closes the roster panel. The text is set from Lua. -->
			<Frame name="CharRosterButton" inherits="GlueButton">
				<Property name="Text" value="" />
				<Area>
					<Anchor point="RIGHT" offset="-48" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_ToggleRoster();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<Frame name="CharDeleteButton" inherits="GlueButton">
				<Property name="Text" value="DELETE_CHARACTER" />
				<Property name="Enabled" value="False" />
				<Area>
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="CharRosterButton" offset="-24" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_DeleteCharacter();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- Only shown with five or more characters; below that the plaza markers create characters. -->
			<Frame name="CharCreateButton" inherits="GlueButton">
				<Property name="Text" value="CREATE_CHARACTER" />
				<Property name="Visible" value="false" />
				<Area>
					<Anchor point="RIGHT" relativePoint="LEFT" relativeTo="CharDeleteButton" offset="-24" />
					<Anchor point="BOTTOM" offset="-48" />
				</Area>
				<Scripts>
					<OnClick>
						return function(this)
							CharSelect_CreateCharacter();
						end
					</OnClick>
				</Scripts>
			</Frame>

			<!-- Roster: every character, the first five marked as standing on the plaza. Rows are
			     cloned from CharButton by CharSelect.lua and reordered by dragging. -->
			<!-- Content keeps 72 UI from the panel edge (bronze edge and corner ornaments); 1040 wide
			     leaves the rows 896, as before the glue skin. -->
			<Frame name="CharRosterPanel" inherits="GlueBorderFrame">
				<Property name="Visible" value="false" />
				<Area>
					<Anchor point="TOP" offset="48" />
					<Anchor point="RIGHT" offset="-48" />
					<Anchor point="BOTTOM" relativePoint="TOP" relativeTo="CharRosterButton" offset="-32" />
					<Size><AbsDimension x="1040" /></Size>
				</Area>

				<Frame name="RealmNameLabel" inherits="GlueTextLarge">
					<Property name="Text" value="REALM" />
					<Area>
						<Anchor point="LEFT" offset="72" />
						<Anchor point="RIGHT" offset="-72" />
						<Anchor point="TOP" offset="72" />
					</Area>
				</Frame>
				<Frame name="CharCountLabel" inherits="GlueTextSmall">
					<Property name="Text" value="" />
					<Property name="HorzAlign" value="CENTER" />
					<Property name="TextColor" value="FFA0A0A0" />
					<Area>
						<Anchor point="LEFT" offset="72" />
						<Anchor point="RIGHT" offset="-72" />
						<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="RealmNameLabel" offset="4" />
					</Area>
				</Frame>

				<Frame name="CharRosterList">
					<Area>
						<Anchor point="LEFT" offset="72" />
						<Anchor point="RIGHT" offset="-72" />
						<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharCountLabel" offset="32" />
						<Anchor point="BOTTOM" offset="-140" />
					</Area>

					<!-- Divider before the characters that are not on the plaza; anchored below the fifth
					     row from Lua. -->
					<Frame name="CharRosterDivider" inherits="GlueDivider">
						<Property name="Visible" value="false" />
						<Area>
							<Anchor point="LEFT" offset="16" />
							<Anchor point="RIGHT" offset="-16" />
							<Anchor point="TOP" />
							<Size><AbsDimension y="12" /></Size>
						</Area>
					</Frame>
					<Frame name="CharRosterDividerLabel" inherits="GlueTextSmall">
						<Property name="Text" value="NOT_ON_THE_PLAZA" />
						<Property name="Visible" value="false" />
						<Property name="Clickable" value="false" />
						<Property name="HorzAlign" value="CENTER" />
						<Property name="TextColor" value="FFA0A0A0" />
						<Area>
							<Anchor point="LEFT" offset="16" />
							<Anchor point="RIGHT" offset="-16" />
							<Anchor point="TOP" relativePoint="BOTTOM" relativeTo="CharRosterDivider" offset="8" />
						</Area>
					</Frame>
				</Frame>

				<Frame name="CharRosterHint" inherits="GlueTextSmall">
					<Property name="Text" value="DRAG_TO_REORDER" />
					<Property name="HorzAlign" value="CENTER" />
					<Property name="TextColor" value="FFA0A0A0" />
					<Area>
						<Anchor point="LEFT" offset="72" />
						<Anchor point="RIGHT" offset="-72" />
						<Anchor point="BOTTOM" offset="-72" />
					</Area>
				</Frame>
			</Frame>
		</Frame>

		<Frame name="DeleteConfirmation" setAllPoints="true">
			<Property name="Visible" value="false" />

			<Frame name="DeleteConfirmationFrame" inherits="GlueBorderFrame">
				<!-- Content keeps 72 UI from the panel edge (bronze edge and corner ornaments). The header is
				     three lines (question, blank, warning; about 215 UI), so 540 leaves ~50 above the buttons. -->
				<Area>
					<Anchor point="H_CENTER" />
					<Anchor point="V_CENTER" />
					<Size>
						<AbsDimension x="1320" y="540" />
					</Size>
				</Area>

				<Frame name="DeleteConfirmationHeader" inherits="GlueTextLarge">
					<Property name="Text" value="CONFIRM_CHAR_DELETE" />
					<Area>
						<Anchor point="LEFT" offset="72" />
						<Anchor point="RIGHT" offset="-72" />
						<Anchor point="TOP" offset="72" />
					</Area>
				</Frame>

				<Frame name="DeleteConfirmButton" inherits="GlueButton">
					<Property name="Text" value="DELETE" />

					<Area>
						<Anchor point="LEFT" offset="72" />
						<Anchor point="RIGHT" relativePoint="H_CENTER" offset="-24" />
						<Anchor point="BOTTOM" offset="-72" />
					</Area>

					<Scripts>
						<OnClick>
							return function(this)
								CharSelect_ConfirmDelete();
							end
						</OnClick>
					</Scripts>
				</Frame>

				<Frame name="DeleteCancelButton" inherits="GlueButton">
					<Property name="Text" value="CANCEL" />

					<Area>
						<Anchor point="LEFT" relativePoint="H_CENTER" offset="24" />
						<Anchor point="RIGHT" offset="-72" />
						<Anchor point="BOTTOM" offset="-72" />
					</Area>

					<Scripts>
						<OnClick>
							return function(this)
								CharSelect_CancelDelete();
							end
						</OnClick>
					</Scripts>
				</Frame>
			</Frame>
		</Frame>

		<Scripts>
			<OnLoad>
				return function(this)
					CharSelect_OnLoad(this);
				end
			</OnLoad>
			<OnUpdate>
				return function(this, elapsed)
					CharSelect_OnUpdate(this, elapsed);
				end
			</OnUpdate>
		</Scripts>
	</Frame>
</UiLayout>
